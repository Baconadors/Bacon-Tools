procedure DebugMsg(Msg: String);
var
  logFile: Integer;
  folderPath, fullMsg, header: string;
  isNew: Boolean;
begin
  fullMsg := SRL.TimeStamp() + ':[DEBUG]: ' + Msg;

  if (not GUI.IsInitialized) or Bot.GetDebugMode() then
    Writeln(fullMsg);

  folderPath := AppPath + 'Configs' + DirectorySeparator + 'BlastFurnace' + DirectorySeparator + 'Logs' + DirectorySeparator;

  if (CurrentLogFileName = '') then
    CurrentLogFileName := 'BF_Log_' + FormatDateTime('yyyy-mm-dd_hh-nn-ss', Now()) + '.txt';

  if not DirectoryExists(folderPath) then
    ForceDirectories(folderPath);

  isNew := not FileExists(folderPath + CurrentLogFileName);

  try
    if isNew then
    begin
      logFile := RewriteFile(folderPath + CurrentLogFileName, False);
      if logFile <> -1 then
      begin
        header := '=== Blast Furnace Debug Log ===' + LineEnding +
                  'Started: ' + FormatDateTime('yyyy-mm-dd hh:nn:ss', Now()) + LineEnding +
                  '==============================' + LineEnding;
        WriteFileString(logFile, header);
      end;
    end else
      logFile := AppendFile(folderPath + CurrentLogFileName);

    if logFile <> -1 then
    begin
      WriteFileString(logFile, fullMsg + LineEnding);
      CloseFile(logFile);
    end;
  except
  end;
end;

function TLogout.ClickLogout(attempts: Int32 = 5; tryTime: Int32 = 20000): Boolean; override;
var
  interval: UInt64;
  i: Int32;
begin
  if (not Self.Open()) or (not Self.CloseWorldSwitcher()) then
    Exit;

  interval := tryTime div attempts;

  for i := 1 to attempts do
  begin
    Self.ClearEnter();
    if Self.GetButton(ELogoutButton.CLICK_HERE).Click() and WaitUntil(not GameClient.IsLoggedIn(), 500, Interval + SRL.NormalRange(-2000, 2000)) then
      Exit(True);
  end;
end;

function TGameClient.Image(): TMufasaBitmap; override;
begin
  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if RemoteInput.IsSetup() then
    Exit(RemoteInput.GetImage());
  {$ENDIF}

  Result := nil;
end;

function TChat.ClickOption(Text: String; UseKeyboard: Boolean = True; Colors: TIntegerArray = [CHAT_COLOR_BLACK, CHAT_COLOR_WHITE]): Boolean; override;
var
  Option: TChatboxOption;
  RecheckOption: TChatboxOption;
  Attempts: Integer;
  MaxAttempts: Integer = 5;
  OptionStillExists: Boolean;
begin
  for Attempts := 0 to MaxAttempts - 1 do
  begin
    for Option in GetOptions(Colors) do
    begin
      if Text in Option.Text then
      begin
        DebugMsg('ClickOption -> Found option: "' + Option.Text + '" (Attempt ' + IntToStr(Attempts + 1) + ')');

        if UseKeyboard then
        begin
          Keyboard.PressKey(Option.Number);
          WaitUntil(Chat.HasContinue(), 50, 600);
        end
        else
        begin
          Mouse.Click(Option.Bounds, MOUSE_LEFT);
          WaitUntil(Chat.HasContinue(), 50, 600);
        end;

        if Chat.HasContinue() then
        begin
          DebugMsg('ClickOption -> Successfully clicked and dialogue progressed');
          Exit(True);
        end;

        OptionStillExists := False;
        for RecheckOption in GetOptions(Colors) do
        begin
          if Text in RecheckOption.Text then
          begin
            OptionStillExists := True;
            Break;
          end;
        end;

        if not OptionStillExists then
        begin
          DebugMsg('ClickOption -> Option disappeared, click was successful');
          Exit(True);
        end;

        DebugMsg('ClickOption -> Option still present after click, retrying...');
        Wait(200, 400);
        Break;
      end;
    end;

    if Attempts < MaxAttempts - 1 then
      Wait(300, 500);
  end;

  DebugMsg('ClickOption -> Failed to find or click option: "' + Text + '"');
  Exit(False);
end;

function TScript.InventoryCountEmptySlotsRobust(): Int32;
var
  counts: array of Int32;
  i, j, attempt, freq, maxFreq, consecutiveMatches, lastCount: Int32;
  stable: Boolean;
begin
  for attempt := 1 to 2 do
  begin
    DebugMsg('InventoryCountEmptySlotsRobust() -> Attempt ' + ToStr(attempt) + ' started');
    SetLength(counts, 7);
    stable := False;
    consecutiveMatches := 0;
    lastCount := -1;
    for i := 0 to 10 do
    begin
      DebugMsg('InventoryCountEmptySlotsRobust() -> Calling Inventory.CountEmptySlots() for reading ' + ToStr(i+1));
      counts[i] := Inventory.CountEmptySlots();

      DebugMsg('InventoryCountEmptySlotsRobust() -> Got count: ' + ToStr(counts[i]));
      if counts[i] = lastCount then
      begin
        Inc(consecutiveMatches);
        if consecutiveMatches >= 2 then
        begin
          stable := True;
          Result := counts[i];
          DebugMsg('InventoryCountEmptySlotsRobust() -> Stable after ' + ToStr(i + 1) + ' readings | Empty slots: ' + ToStr(Result));
          Exit;
        end;
      end
      else
        consecutiveMatches := 0;
      lastCount := counts[i];
      if i < 4 then
        Wait(50);
    end;
    maxFreq := 0;
    Result := counts[0];
    DebugMsg('InventoryCountEmptySlotsRobust() -> Inner loops complete, starting frequency analysis');
    for i := 0 to High(counts) do
    begin
      freq := 0;
      for j := 0 to High(counts) do
      begin
        if counts[j] = counts[i] then
          Inc(freq);
      end;
      if freq > maxFreq then
      begin
        maxFreq := freq;
        Result := counts[i];
      end;
    end;
    if maxFreq >= 2 then
    begin
      DebugMsg('InventoryCountEmptySlotsRobust() -> Attempt ' + ToStr(attempt) + ' stable (freq=' + ToStr(maxFreq) + '), returning ' + ToStr(Result));
      Exit;
    end;
      DebugMsg('InventoryCountEmptySlotsRobust() -> Attempt ' + ToStr(attempt) + ' unstable, retrying...');
    Wait(50, 75);
  end;

  DebugMsg('InventoryCountEmptySlotsRobust() -> All attempts exhausted, returning: ' + ToStr(Result));
end;

function TScript.InventoryCountRobust(): Int32;
var
  counts: array of Int32;
  i, j, attempt, freq, maxFreq, consecutiveMatches, lastCount: Int32;
  stable: Boolean;
begin
  for attempt := 1 to 2 do
  begin
    SetLength(counts, 7);
    stable := False;
    consecutiveMatches := 0;
    lastCount := -1;
    for i := 0 to 10 do
    begin
      counts[i] := Inventory.Count();
      if counts[i] = lastCount then
      begin
        Inc(consecutiveMatches);
        if consecutiveMatches >= 2 then
        begin
          stable := True;
          Result := counts[i];
          DebugMsg('InventoryCountRobust() -> Stable after ' + ToStr(i + 1) + ' readings | Inventory count: ' + ToStr(Result));
          Exit;
        end;
      end
      else
        consecutiveMatches := 0;
      lastCount := counts[i];
      if i < 4 then
        Wait(50);
    end;
    maxFreq := 0;
    Result := counts[0];

      DebugMsg('InventoryCountRobust -> Inner loops complete, starting frequency analysis');
    for i := 0 to High(counts) do
    begin
      freq := 0;
      for j := 0 to High(counts) do
      begin
        if counts[j] = counts[i] then
          Inc(freq);
      end;
      if freq > maxFreq then
      begin
        maxFreq := freq;
        Result := counts[i];
      end;
    end;
    if maxFreq >= 2 then
    begin

        DebugMsg('InventoryCountRobust() -> Attempt ' + ToStr(attempt) + ' Counts: ' + ToStr(counts) + ' => ' + ToStr(Result) + ' (freq=' + ToStr(maxFreq) + ')');
      Exit;
    end;

      DebugMsg('InventoryCountRobust() -> Attempt ' + ToStr(attempt) + ' unstable, retrying...');
    Wait(50, 75);
  end;

    DebugMsg('InventoryCountRobust() -> WARNING: Unstable readings after 3 attempts, using: ' +
             ToStr(Result));
end;

function TScript.CountItemRobust(item: TItem): Int32;
var
  counts: array of Int32;
  i, j, attempt, freq, maxFreq, consecutiveMatches, lastCount: Int32;
  stable: Boolean;
begin
  for attempt := 1 to 2 do
  begin
    SetLength(counts, 7);
    stable := False;
    consecutiveMatches := 0;
    lastCount := -1;

    for i := 0 to 10 do
    begin
      counts[i] := Inventory.CountItem(item);

      if counts[i] = lastCount then
      begin
        Inc(consecutiveMatches);
        if consecutiveMatches >= 2 then
        begin
          stable := True;
          Result := counts[i];

            DebugMsg('CountItemRobust(' + ToStr(item) + ') -> Stable after ' + ToStr(i + 1) + ' readings | Inventory item count: ' + ToStr(Result));
          Exit;
        end;
      end
      else
        consecutiveMatches := 0;

      lastCount := counts[i];

      if i < 4 then
        Wait(50);
    end;

    maxFreq := 0;
    Result := counts[0];

    for i := 0 to High(counts) do
    begin
      freq := 0;
      for j := 0 to High(counts) do
      begin
        if counts[j] = counts[i] then
          Inc(freq);
      end;

      if freq > maxFreq then
      begin
        maxFreq := freq;
        Result := counts[i];
      end;
    end;

    if maxFreq >= 2 then
    begin
        DebugMsg('CountItemRobust(' + ToStr(item) + ') -> Attempt ' + ToStr(attempt) + ' Counts: ' + ToStr(counts) + ' => ' + ToStr(Result) + ' (freq=' + ToStr(maxFreq) + ')');
      Exit;
    end;

      DebugMsg('CountItemRobust(' + ToStr(item) + ') -> Attempt ' + ToStr(attempt) +
               ' unstable, retrying...');
    Wait(50, 75);
  end;

    DebugMsg('CountItemRobust(' + ToStr(item) + ') -> WARNING: Unstable readings after 3 attempts, using: ' + ToStr(Result));
end;

procedure TScript.LoginPlayer();
var
  index, attempts, retryTime: Int32;
begin
  if GameClient.IsLoggedIn then
    Exit;

  Self.LastXPTime := GetTickCount();
  Self.LastXPCheck := GetSystemTime();

  index := Login.PlayerIndex;

  if Login.Players[index].User = '' then
  begin
    DebugMsg('No player credentials. Add account to credentials to use the script.');
    Exit;
  end;

  attempts := 0;

  repeat
    Inc(attempts);
    DebugMsg('Attempting to login/hop to random blast furnace world (attempt #' + ToString(attempts) + ')');

    Login.LoginPlayer(False);

    if not GameClient.IsLoggedIn then
    begin
      retryTime := Random(5000, 10000);
      DebugMsg('Login failed or world full. Retrying in about ' + ToStr(Round(retryTime / 1000)) + ' seconds...');
      Wait(retryTime);
    end;
  until GameClient.IsLoggedIn;

  DebugMsg('Successfully logged in.');

  Login.Players[Login.PlayerIndex].Worlds := originalWorlds;
end;

function TChat.CheckSystemUpdate(minuteTreshold: Integer): Boolean;
var
  b: TBox;
  s: String;
  numbers: TExtendedArray;
begin
  b := Chat.Bounds;
  b.X1 += 4;
  b.Y1 -= 16;
  b.Y2 := Chat.Bounds.Y1 -1;
  b.X2 := b.X1 + 140;

  s := OCR.Recognize(b, TOCRColorFilter.Create([65535]), FONT_PLAIN_12);

  if s.Contains('System update') then
  begin
    s := s.After(': ');
    numbers := s.ExtractNumbers();
    if (length(numbers) > 0) and (numbers[0] <= minuteTreshold) then
      Result := True;
  end;
end;

function TScript.SafeXPDelta(var lastXP: Int32): Int32;
var
  newXP, delta: Int32;
begin
  Result := 0;

  newXP := Self.CheckXP();

  if (newXP <= 0) or (newXP > 1000000000) then
  begin
      DebugMsg('SafeXPDelta -> Invalid XP read (' + ToStr(newXP) + '), skipping');
    Exit(0);
  end;

  if lastXP = 0 then
  begin
    lastXP := newXP;
    Exit(0);
  end;

  delta := newXP - lastXP;

  if (delta < 0) or (delta > 1000000) then
  begin
      DebugMsg('SafeXPDelta -> Ignoring invalid delta: ' + ToStr(delta) +  ' (lastXP=' + ToStr(lastXP) + ', newXP=' + ToStr(newXP) + ')');
    Exit(0);
  end;

  lastXP := newXP;
  Result := delta;

  if (delta > 0) and Self.GetDebugMode() then
    DebugMsg('SafeXPDelta -> XP gained: ' + ToStr(delta));
end;

function TMapObject.SmartClick(ExpectedUpText: String; leftClick: Boolean = True; restrictBounds: TBox = []): Boolean;
var
  atpa: T2DPointArray;
  tpa, filteredTPA: TPointArray;
  p: TPoint;
  upText: String;
  tries, i: Int32;
  objBox: TBox;
begin
  Result := False;

  if not Self.Find(atpa) then
  begin
    DebugMsg('SmartClick -> Object "' + ExpectedUpText + '" not found');
    Exit;
  end;

  tpa := atpa.Merge();

  if Length(tpa) < 1 then
  begin
    DebugMsg('SmartClick -> Found zero points for "' + ExpectedUpText + '"');
    Exit;
  end;

  if (restrictBounds.X1 <> 0) or (restrictBounds.Y1 <> 0) or
     (restrictBounds.X2 <> 0) or (restrictBounds.Y2 <> 0) then
  begin
    DebugMsg('SmartClick -> Filtering points by restricted bounds');
    SetLength(filteredTPA, 0);
    for i := 0 to High(tpa) do
    begin
      if restrictBounds.Contains(tpa[i]) then
        filteredTPA += tpa[i];
    end;

    if Length(filteredTPA) < 1 then
    begin
      DebugMsg('SmartClick -> No points found within restricted bounds');
      Exit;
    end;
    tpa := filteredTPA;
  end;

  objBox := tpa.Bounds();
  p := tpa.RandomMean();

  if Bot.GetDebugMode() then
  begin
    GameClient.Image.DrawTPA(tpa, $FF00FF); // Magenta
    GameClient.Image.DrawBox(objBox, $00FFFF); // Yellow
    GameClient.Image.DrawBox(objBox.Expand(-1), $00FF00); // Green
    GameClient.Image.DrawCircle(p, 3, $FFFF00); // Cyan
    DebugMsg('SmartClick -> Moving mouse to click point [' + ToStr(p.X) + ',' + ToStr(p.Y) + ']');
  end;

  Mouse.Move(p);
  Wait(50, 150);

  tries := 0;
  repeat
    upText := MainScreen.GetUpText();
    Inc(tries);

    if (ExpectedUpText = '') or (Pos(ExpectedUpText, upText) > 0) then
    begin
      DebugMsg('SmartClick -> Uptext matched "' + ExpectedUpText + '" after ' + ToStr(tries) + ' tries');

      if leftClick then
      begin
        DebugMsg('SmartClick -> Performing LEFT click');
        Mouse.Click(MOUSE_LEFT);
      end
      else
      begin
        DebugMsg('SmartClick -> Performing RIGHT click');
        Mouse.Click(MOUSE_RIGHT);
      end;

      if WaitUntil(MainScreen.DidRedClick(), 50, 1000) then
      begin
        DebugMsg('SmartClick -> Red click confirmed for "' + ExpectedUpText + '"');
        Exit(True);
      end
      else
      begin
        DebugMsg('SmartClick -> No red click detected for "' + ExpectedUpText + '"');
        Exit(False);
      end;
    end;

    Wait(50, 100);
  until (tries > 6);

  DebugMsg('SmartClick -> UpText mismatch ("' + upText + '"), attempting fallback');

  Mouse.Click(MOUSE_RIGHT);

  if WaitUntil(ChooseOption.IsOpen(), 50, 1000) then
  begin
    if ChooseOption.Select([ExpectedUpText]) then
    begin
      DebugMsg('SmartClick -> Fallback success: Selected "' + ExpectedUpText + '" from menu');
      Exit(True);
    end;
    ChooseOption.Close();
  end;

  DebugMsg('SmartClick -> Failed uptext match AND fallback for "' + ExpectedUpText + '"');
end;

function TMapObject.SmartHover(ExpectedUpText: String; restrictBounds: TBox = []): Boolean;
var
  atpa: T2DPointArray;
  tpa, filteredTPA: TPointArray;
  p: TPoint;
  upText: String;
  tries, i, attempt: Int32;
  objBox: TBox;
begin
  if Minimap.IsPlayerMoving() then
    Exit(False);

  if (ExpectedUpText <> '') and (Pos(ExpectedUpText, MainScreen.GetUpText()) > 0) then
    Exit(True);

  GameClient.Image.Clear;
  Result := False;

  for attempt := 1 to 5 do
  begin
    if not Self.Find(atpa) then
    begin
      DebugMsg('SmartHover -> Object "' + ExpectedUpText + '" not found (Attempt ' + ToStr(attempt) + ')');
      Continue;
    end;

    tpa := atpa.Merge();

    if Length(tpa) < 1 then
      Continue;

    if (restrictBounds.x1 <> 0) or (restrictBounds.y1 <> 0) or
        (restrictBounds.x2 <> 0) or (restrictBounds.y2 <> 0) then
    begin
      SetLength(filteredTPA, 0);
      for i := 0 to High(tpa) do
      begin
        if restrictBounds.Contains(tpa[i]) then
          filteredTPA += tpa[i];
      end;

      if Length(filteredTPA) < 1 then
        Continue;

      tpa := filteredTPA;
    end;

    objBox := tpa.Bounds();
    p := tpa.RandomMean();

    if Bot.GetDebugMode() then
    begin
      GameClient.Image.DrawTPA(tpa, $FF00FF); // Magenta
      GameClient.Image.DrawBox(objBox, $00FFFF); // Yellow
      GameClient.Image.DrawBox(objBox.Expand(-1), $00FF00); // Green
      GameClient.Image.DrawCircle(p, 3, $FFFF00); // Cyan
    end;

    DebugMsg('SmartHover -> Attempt ' + ToStr(attempt) + ': Moving to [' + ToStr(p.x) + ',' + ToStr(p.y) + ']');

    Mouse.Move(p);
    Wait(50, 150);

    tries := 0;
    repeat
      upText := MainScreen.GetUpText();
      Inc(tries);

      if (ExpectedUpText = '') or (Pos(ExpectedUpText, upText) > 0) then
      begin
        DebugMsg('SmartHover -> Uptext matched "' + ExpectedUpText + '"');
        Exit(True);
      end;

      Wait(50, 100);
    until (tries > 6);

    DebugMsg('SmartHover -> Attempt ' + ToStr(attempt) + ' failed UpText match.');
  end;

  Result := False;
end;

function TScript.DepositUnwantedItems(): Boolean;
var
  allowedItems: TItemArray;
begin
  Result := False;
  if not Bank.IsOpen() then
    Exit(False);

  allowedItems := [Self.Coal, Self.Ore, Self.Bar, Self.CoalBag, Self.IceGloves, Self.GoldGloves] + STAMINA_POTIONS;

  DebugMsg('DepositUnwantedItems -> Depositing items not in allowedItems');

  Result := Bank.DepositRandomItems(allowedItems);

  if Result and Self.GetDebugMode() then
    DebugMsg('DepositUnwantedItems -> Deposited unwanted items');
end;

function TCustomEdit.GetStringArray: TStringArray;
var str, s: String;
begin
  try
    str := Self.GetText();

    for s in str.Split(',') do
      Result += s.trim();
  except
  end;
end;

procedure TScript.DownloadToFile(const URL, Filename: string);
var
  Client: Int32;
begin
  DebugMsg('Downloading assets');
  Client := InitializeHTTPClient(False);
  try
    GetHTTPPageEx(Client, URL, Filename);
  finally
    FreeHTTPClient(Client);
  end;
end;

function TScript.EnsureZoom(target, low, high: Integer; useScroll: Boolean = True): Boolean;
var
  currentZoom, chosen: Integer;
  method: String;
begin
  currentZoom := MM2MS.GetZoomLevel();
  DebugMsg('EnsureZoom -> Current=' + ToStr(currentZoom) + ', Low=' + ToStr(low) + ', High=' + ToStr(high) + ', Target=' + ToStr(target));

  if InRange(currentZoom, low, high) then
  begin
    DebugMsg('EnsureZoom -> Already within range');
    Exit(True);
  end;

  chosen := SRL.SkewedRand(target, low, high);

  if useScroll then
    method := 'scroll'
  else
    method := 'options';

  DebugMsg('EnsureZoom -> Adjusting to ' + ToStr(chosen) + ' using ' + method);

  if useScroll then
    Result := RSMouseZoom.SetZoomLevel(chosen)
  else
    Result := Options.SetZoomLevel(chosen);

  DebugMsg('EnsureZoom -> Success=' + ToStr(Result));
end;

procedure TScript.EnsureCompass(target, low, high: Integer);
var
  currentAngle, chosen: Double;
begin
  currentAngle := Minimap.GetCompassAngle(True);

  DebugMsg('EnsureCompass -> Current=' + ToStr(currentAngle) + ', Low=' + ToStr(low) + ', High=' + ToStr(high) + ', Target=' + ToStr(target));

  if InRange(currentAngle, low, high) then
  begin
    DebugMsg('EnsureCompass -> Already within range');
    Exit;
  end;

  chosen := SRL.SkewedRand(target, low, high);

  DebugMsg('EnsureCompass -> Adjusting to ' + ToStr(chosen));

  Minimap.SetCompassAngle(chosen);
end;

function TScript.CheckXP(attempt: Int32 = 0; allowClose: Boolean = True): Int32;
var
  firstRead, retryRead, retries, oldXP, currentRead, i: Int32;
  xpBox, safeBox: TBox;
  target, centerPt: TPoint;
  fontArray: array of TFontSet;
  fontFound: Boolean;
begin
  if Bank.IsOpen() or BankPin.IsOpen() then
    Exit(Self.LastXPAmount);

  Result := 0;
  xpBox := XPBar.Bounds.Expand(0, 10);

  if xpBox.Contains(Mouse.Position()) then
  begin
    centerPt := Point(430, 75);
    safeBox.X1 := centerPt.X - 10;
    safeBox.Y1 := centerPt.Y - 10;
    safeBox.X2 := centerPt.X + 10;
    safeBox.Y2 := centerPt.Y + 10;
    target.X := RandomRange(safeBox.X1, safeBox.X2 + 1);
    target.Y := RandomRange(safeBox.Y1, safeBox.Y2 + 1);
    Mouse.Move(target);
  end;

  oldXP := Self.LastXPAmount;
  fontFound := False;

  if (Self.LastUsedXPFont.Name <> '') then
  begin
    currentRead := OCR.RecognizeNumber(XPBar.Bounds, TOCRColorFilter.Create([$FFFFFF]), Self.LastUsedXPFont);
    if (oldXP = 0) or ((currentRead > 0) and (Abs(currentRead - oldXP) < (oldXP * 0.2))) then
    begin
      Result := currentRead;
      fontFound := True;
    end;
  end;

  if not fontFound then
  begin
    fontArray := [FONT_PLAIN_11, FONT_PLAIN_12, FONT_BOLD_12, FONT_QUILL, FONT_QUILL_8];
    for i := 0 to High(fontArray) do
    begin
      currentRead := OCR.RecognizeNumber(XPBar.Bounds, TOCRColorFilter.Create([$FFFFFF]), fontArray[i]);
      if currentRead > Result then
      begin
        Result := currentRead;
        Self.LastUsedXPFont := fontArray[i];
      end;
    end;
  end;

  firstRead := Result;
  retries := 0;
  while (retries < 10) do
  begin
    if (oldXP > 10000) and (Result > 0) then
    begin
       if (Result < oldXP * 0.8) or (Result > oldXP * 1.2) then
       begin
         Inc(retries);
         Wait(50, 100);
         retryRead := OCR.RecognizeNumber(XPBar.Bounds, TOCRColorFilter.Create([$FFFFFF]), Self.LastUsedXPFont);

         if Abs(retryRead - oldXP) < Abs(Result - oldXP) then
           Result := retryRead;

         if retries >= 3 then
           if Abs(Result - retryRead) < (Result * 0.1) then Break;
         Continue;
       end;
       Break;
    end;
    Break;
  end;

  if (Result = 0) and (oldXP > 0) then
    Exit(oldXP);

  Self.LastXPCheck := GetSystemTime();
  if (Result > oldXP) then
    Self.LastXPTime := GetTickCount();

  Self.LastXPAmount := Result;
end;

function TScript.EarnedXP(): Boolean;
begin
  Result := Self.CheckXP() > Self.LastXPAmount;

  if Result then
    Self.LastXPAmount := Self.CheckXP();
end;

function TScript.WithdrawAndDrinkStamina(): Boolean;
var
  i, slot, selection: Int32;
  potions: TItemArray;
  pattern: String;
begin
  Result := False;
  selection := GUI.Config.GetInt('staminas');

  if (selection = 0) then
    Exit;

  case selection of
    1:
      begin
        potions := STAMINA_POTIONS;
        pattern := 'Stamina potion(1..4)';
      end;
    2:
      begin
        potions := EXT_STAMINA_POTIONS;
        pattern := 'Extended stamina potion(1..4)';
      end;
  end;

  DebugMsg('WithdrawAndDrinkStamina -> Starting');

  for i := 0 to High(potions) do
  begin
    if Bank.ContainsItem(potions[i]) then
    begin
      DebugMsg('WithdrawAndDrinkStamina -> Found ' + potions[i]);
      if not Bank.ClickItem(potions[i], 'Withdraw-1') then
      begin
        DebugMsg('WithdrawAndDrinkStamina -> Failed to withdraw ' + potions[i]);
        Exit;
      end;
      Break;
    end;
  end;

  if not WaitUntil(Inventory.FindItem(pattern, slot), 50, 3000) then
  begin
    DebugMsg('WithdrawAndDrinkStamina -> Potion did not appear in inventory');
    Exit;
  end;

  Mouse.Move(Inventory.GetSlotBox(slot));
  if ChooseOption.Select('Drink') then
  begin
    DebugMsg('WithdrawAndDrinkStamina -> Drank potion');
    Result := True;
    Self.NextEnergy := 0;

    Inc(Self.StaminaDrinks);
    Dec(Self.TotalProfit, Self.Prices.PerDoseAvg);

    DebugMsg('WithdrawAndDrinkStamina -> StaminaDrinks=' + ToStr(Self.StaminaDrinks) + ' | Profit -' + ToStr(Self.Prices.PerDoseAvg) + ' | TotalProfit=' + ToStr(Self.TotalProfit));

    Wait(SRL.TruncatedGauss(600, 800));
  end
  else
    DebugMsg('WithdrawAndDrinkStamina -> Failed to drink potion');

  if Inventory.ContainsItem('Vial') then
  begin
    DebugMsg('WithdrawAndDrinkStamina -> Depositing vial');
    Bank.DepositItem('Vial', False);
    WaitUntil(not Inventory.ContainsItem('Vial'), 100, 2000);
  end;

  if Inventory.ContainsItem(pattern) then
  begin
    DebugMsg('WithdrawAndDrinkStamina -> Depositing leftover potion');
    Bank.DepositItems(potions, False);
    WaitUntil(not Inventory.ContainsItem(pattern), 100, 2000);
  end;

  DebugMsg('WithdrawAndDrinkStamina -> Finished, Result=' + ToStr(Result));
end;

function TScript.BoxFromDTMs(dtms: TIntegerArray; search: TBox): TBox;
var
  i, x, y: Int32;
  first: Boolean;
begin
  first := True;

  DebugMsg('BoxFromDTMs -> Starting search in box [' + ToStr(search.x1) + ',' + ToStr(search.y1) + ',' + ToStr(search.x2) + ',' + ToStr(search.y2) + ']');

  for i := 0 to High(dtms) do
  begin
    if FindDTM(dtms[i], x, y, search) then
    begin
      DebugMsg('BoxFromDTMs -> Found DTM ' + ToStr(dtms[i]) + ' at [' + ToStr(x) + ',' + ToStr(y) + ']');

      if first then
      begin
        Result.x1 := x;
        Result.y1 := y;
        Result.x2 := x;
        Result.y2 := y;
        first := False;
      end
      else
      begin
        if x < Result.x1 then Result.x1 := x;
        if y < Result.y1 then Result.y1 := y;
        if x > Result.x2 then Result.x2 := x;
        if y > Result.y2 then Result.y2 := y;
      end;
    end
    else
      DebugMsg('BoxFromDTMs -> DTM ' + ToStr(dtms[i]) + ' not found');
  end;

  if first then
  begin
    DebugMsg('BoxFromDTMs -> No DTMs found, returning empty box');
    Result.x1 := 0;
    Result.y1 := 0;
    Result.x2 := 0;
    Result.y2 := 0;
  end
  else
    DebugMsg('BoxFromDTMs -> Final box [' + ToStr(Result.x1) + ',' + ToStr(Result.y1) + ',' + ToStr(Result.x2) + ',' + ToStr(Result.y2) + ']');
end;

procedure TScript.SetupDTMs();
begin
  DebugMsg('SetupDTMs -> Allocating image and container interface assets');

  Self.GaugeDTM  := DTMFromString('mbQAAAHicY2VgYPgHxOuAeD0Q+zMyMPgBsTWQHQnEP4H4FxBHAfGmFcsxMDbAiAWDAQA2Rw/r');
  Self.GaugeXDTM := DTMFromString('mwQAAAHic42RgYPjMyMDwEor/QPFzKP4HxSJAddxALAvFIDYnEMtDMYj9fwYQm6BiBgZGNEwYoOvAhuEAAOydD74=');

  Self.CofferTL := DTMFromString('mWAAAAHicY2FgYLjCCMH/odgMKJbNgKCDvezAOMTbAYzRASMaBgEABzwIaQ==');
  Self.CofferTR := DTMFromString('mWAAAAHicY2FgYPjPyMBwhRFBmzFAcDYUh3g7MAR72cFpdMCIhkEAAAicCGk=');
  Self.CofferBL := DTMFromString('mWAAAAHicY2FgYLjCCMH/oTgbKGbGgKCDvezAOMTbAYzRASMaBgEACOQIaQ==');
  Self.CofferBR := DTMFromString('mWAAAAHicY2FgYPjPyMBwhRFBZzNAsBkUh3g7MAR72cFpdMCIhkEAAAvsCGk=');

  Self.CofferBoundsDTMs := [Self.CofferTL, Self.CofferTR, Self.CofferBL, Self.CofferBR];

  DebugMsg('SetupDTMs -> Allocated ' + ToStr(Length(Self.CofferBoundsDTMs)) + ' Coffer DTMs');

  CofferBounds := BoxFromDTMs(Self.CofferBoundsDTMs, MainScreen.Bounds);
  CofferBounds.x1 += 1;
  CofferBounds.y1 += 1;
  CofferBounds.x2 += 1;
  CofferBounds.y2 += 1;

  DebugMsg('SetupDTMs -> CofferBounds calculated = [(' + ToStr(CofferBounds.x1) + ',' + ToStr(CofferBounds.y1) + '),' + '(' +
               ToStr(CofferBounds.x2) + ',' + ToStr(CofferBounds.y2) + ')]');
end;

procedure TScript.SetupVariables();
var
  item: TItem;
  BarTypes, Ores, Bars, Coals: TStringArray;
  Ratios, XPValues: TIntegerArray;
  idx, i, selection: Int32;
  activePotions: TItemArray;
begin
  DebugMsg('SetupVariables -> Start');

  Self.SetupDTMs();

  Self.CoalBag    := 'Coal bag';
  Self.GoldGloves := 'Goldsmith gauntlets';
  Self.IceGloves  := 'Ice gloves';
  Self.Coin       := 'Coins';

  for item in ItemFinder.GetItemIDs('Open coal bag') do
    ItemFinder.AddItemName(Self.CoalBag, item);
  for item in ItemFinder.GetItemIDs('Smiths gloves (i)') do
    ItemFinder.AddItemName(Self.IceGloves, item);

  Self.CoalRatio      := 0;
  Self.AvailableSlots := 28;
  Self.Coal           := 'Coal';

  BarTypes := ['Bronze','Iron','Silver','Lead','Steel','Gold','Mithril','Adamantite','Cupronickel','Runite'];
  Ores     := ['Copper ore','Iron ore','Silver ore','Lead ore','Iron ore','Gold ore','Mithril ore','Adamantite ore','Nickel ore','Runite ore'];
  Bars     := ['Bronze bar','Iron bar','Silver bar','Lead bar','Steel bar','Gold bar','Mithril bar','Adamantite bar','Cupronickel bar','Runite bar'];
  Ratios   := [1,0,0,0,1,0,2,3,2,4];
  Coals    := ['Tin ore','Coal','Coal','Coal','Coal','Coal','Coal','Coal','Copper ore','Coal'];
  XPValues := [165,335,365,200,465,1500,800,1000,0,1320];

  idx := -1;
  for i := 0 to High(BarTypes) do
    if Self.BarType = BarTypes[i] then
    begin
      idx := i;
      Break;
    end;

  if idx <> -1 then
  begin
    Self.Ore        := Ores[idx];
    Self.Bar        := Bars[idx];
    Self.Coal       := Coals[idx];
    Self.CoalRatio  := Ratios[idx];
    Self.ExpectedXP := XPValues[idx];

    if Self.BarType = 'Gold' then
      Dec(Self.AvailableSlots);
  end
  else
  begin
    DebugMsg('No valid bar selected. You broke something.');
    TerminateScript();
  end;

  DebugMsg('SetupVariables -> BarType = ' + Self.BarType +
               ', Ore = ' + Self.Ore + ', Bar = ' + Self.Bar +
               ', Coal = ' + Self.Coal + ', Ratio = ' + ToStr(Self.CoalRatio));

  Self.OrePage := 1;

  Self.ItemList := [Self.IceGloves, Self.Coal, Self.Ore, Self.Bar];
  if Self.BarType = 'Gold' then
    Self.ItemList += Self.GoldGloves;

  if UseCoalBag then
  begin
    Self.ItemList += Self.CoalBag;
    Dec(Self.AvailableSlots);
    Self.MaxCoalBag := 27;
  end;

  Self.Prices.Ore  := ItemData.GetAverage(Self.Ore);
  Self.Prices.Coal := ItemData.GetAverage(Self.Coal);
  Self.Prices.Bar  := ItemData.GetAverage(Self.Bar);

  selection := GUI.Config.GetInt('staminas');
  case selection of
    2: activePotions   := EXT_STAMINA_POTIONS;
    else activePotions := STAMINA_POTIONS;
  end;

  if Length(activePotions) >= 4 then
  begin
    Self.Prices.Stamina1 := ItemData.GetAverage(activePotions[0]);
    Self.Prices.Stamina2 := ItemData.GetAverage(activePotions[1]) div 2;
    Self.Prices.Stamina3 := ItemData.GetAverage(activePotions[2]) div 3;
    Self.Prices.Stamina4 := ItemData.GetAverage(activePotions[3]) div 4;
  end;

  Self.Prices.PerDoseAvg := Round((Self.Prices.Stamina1 + Self.Prices.Stamina2 +
                                    Self.Prices.Stamina3 + Self.Prices.Stamina4) / 4);

  begin
    DebugMsg('SetupVariables -> Prices set: Ore= ' + ToStr(Self.Prices.Ore) +
                 ', Coal= ' + ToStr(Self.Prices.Coal) + ', Bar= ' + ToStr(Self.Prices.Bar));
    DebugMsg('SetupVariables -> Stamina potion avg dose price = ' + ToStr(Self.Prices.PerDoseAvg));
  end;

  Self.BarB        := TBankItem.Setup(Self.Bar);
  Self.GoldGlovesB := TBankItem.Setup(Self.GoldGloves);
  Self.CoalBagB    := TBankItem.Setup(Self.CoalBag);
  Self.CoinB       := TBankItem.Setup(Self.Coin);

  Self.CoalB := TBankItem.Setup(Self.Coal, 1, False);
  Self.OreB  := TBankItem.Setup(Self.Ore, 1, False);

  SetLength(Self.BankItems, 2);
  Self.BankItems[0] := Self.CoalB;
  Self.BankItems[1] := Self.OreB;

  if Stats.GetLevel(ESKILL.SMITHING) < 60 then
    Self.Fee := 0.02667
  else
    Self.Fee := 0.02;

  DebugMsg('SetupVariables -> Fee = ' + ToStr(Self.Fee));

  Self.CoalBagCapacity := 27;
  Self.MaxCoalBag := Self.CoalBagCapacity;

  DebugMsg('SetupVariables -> Coal bag capacity: ' + ToStr(Self.CoalBagCapacity));

  case LowerCase(Self.BarType) of
    'bronze':
    begin
      SetLength(Self.TripSequence, 1);
      Self.TripSequence[0] := [14, 14, True];
    end;

    'iron':
    begin
      SetLength(Self.TripSequence, 1);
      Self.TripSequence[0] := [0, 28, True];
    end;

    'silver':
    begin
      SetLength(Self.TripSequence, 1);
      Self.TripSequence[0] := [0, 28, True];
    end;

    'lead':
    begin
      SetLength(Self.TripSequence, 1);
      Self.TripSequence[0] := [0, 28, True];
    end;

    'steel':
    begin
      if Self.UseCoalBag then
      begin
        SetLength(Self.TripSequence, 1);
        Self.TripSequence[0] := [27, 27, True];
      end
      else
      begin
        SetLength(Self.TripSequence, 2);
        Self.TripSequence[0] := [28, 0, False];
        Self.TripSequence[1] := [0, 28, True];
      end;
    end;

    'gold':
    begin
      SetLength(Self.TripSequence, 1);
      Self.TripSequence[0] := [0, 27, True];
    end;

    'mithril':
    begin
      if Self.UseCoalBag then
      begin
        SetLength(Self.TripSequence, 3);
        Self.TripSequence[0] := [54, 0, False];
        Self.TripSequence[1] := [27, 27, True];
        Self.TripSequence[2] := [27, 27, True];
      end
      else
      begin
        SetLength(Self.TripSequence, 3);
        Self.TripSequence[0] := [28, 0, False];
        Self.TripSequence[1] := [28, 0, False];
        Self.TripSequence[2] := [0, 28, True];
      end;
    end;

    'adamantite':
    begin
      if Self.UseCoalBag then
      begin
        SetLength(Self.TripSequence, 2);
        Self.TripSequence[0] := [54, 0, False];
        Self.TripSequence[1] := [27, 27, True];
      end
      else
      begin
        SetLength(Self.TripSequence, 4);
        Self.TripSequence[0] := [28, 0, False];
        Self.TripSequence[1] := [28, 0, False];
        Self.TripSequence[2] := [28, 0, False];
        Self.TripSequence[3] := [0, 28, True];
      end;
    end;

    'cupronickel':
    begin
      SetLength(Self.TripSequence, 1);
      Self.TripSequence[0] := [18, 9, True];
    end;

    'runite':
    begin
      if Self.UseCoalBag then
      begin
        SetLength(Self.TripSequence, 5);
        Self.TripSequence[0] := [54, 0, False];
        Self.TripSequence[1] := [54, 0, False];
        Self.TripSequence[2] := [27, 27, False];
        Self.TripSequence[3] := [54, 0, True];
        Self.TripSequence[4] := [27, 27, True];
      end
      else
      begin
        SetLength(Self.TripSequence, 5);
        Self.TripSequence[0] := [28, 0, False];
        Self.TripSequence[1] := [28, 0, False];
        Self.TripSequence[2] := [28, 0, False];
        Self.TripSequence[3] := [28, 0, False];
        Self.TripSequence[4] := [0, 28, True];
      end;
    end;
  end;

  Self.CurrentTrip := 0;

  DebugMsg('SetupVariables -> End');
end;

procedure TScript.DoWorldHop();
var
  currentWorld, targetWorld, i: Int32;
  playerWorlds, availableWorlds: TIntegerArray;
begin
  DebugMsg('DoWorldHop -> Starting world hop process');

  DebugMsg('DoWorldHop -> Checking system update...');
  Chat.CheckSystemUpdate(3);

  playerWorlds := Login.GetPlayer().Worlds;
  DebugMsg('DoWorldHop -> Player worlds detected: ' + ToStr(playerWorlds));

  if not Logout.Open() then
  begin
    DebugMsg('DoWorldHop -> Failed to open logout menu');
    Exit;
  end;

  if not Logout.IsWorldSwitcherOpen() then
  begin
    DebugMsg('DoWorldHop -> Opening world switcher menu');
    Logout.GetButton(ELogoutButton.WORLD_SWITCHER).Click(MOUSE_LEFT);
  end;

  DebugMsg('DoWorldHop -> Waiting for current world detection...');
  WaitUntil((currentWorld := WorldHopper.GetCurrentWorld()) <> 0, 65, 20000);

  DebugMsg('DoWorldHop -> Current world: ' + ToStr(currentWorld));

  availableWorlds := [];
  for i := 0 to High(playerWorlds) do
  begin
    if playerWorlds[i] <> currentWorld then
      availableWorlds += playerWorlds[i];
  end;

  DebugMsg('DoWorldHop -> Filtered available worlds: ' + ToStr(availableWorlds));

  targetWorld := availableWorlds[Random(Length(availableWorlds))];
  DebugMsg('DoWorldHop -> Selected target world: ' + ToStr(targetWorld));

  if WorldHopper.Hop([targetWorld]) then
  begin
    Inc(Self.WorldHopsCompleted);
    DebugMsg('Successfully hopped to world ' + ToStr(targetWorld) + '! (Total hops: ' + ToStr(Self.WorldHopsCompleted) + ')');
    Self.SetupDTMs();
  end
  else
  begin
    DebugMsg('DoWorldHop -> World hop to ' + ToStr(targetWorld) + ' failed');
  end;
end;

function TScript.ValidateWorld(): EState;
var
  CurrentWorld, Attempts: Int32;
  PlayerWorlds: TIntegerArray;
begin
  DebugMsg('ValidateWorld -> Starting world validation...');
  PlayerWorlds := Login.GetPlayer().Worlds;
  DebugMsg('ValidateWorld -> Player worlds: ' + ToStr(PlayerWorlds));

  for Attempts := 1 to 5 do
  begin
    DebugMsg('ValidateWorld -> Attempt #' + ToStr(Attempts));

    if not Logout.Open() then
    begin
      DebugMsg('ValidateWorld -> Failed to open logout interface');
      Wait(1000);
      Continue;
    end;

    if not Logout.IsWorldSwitcherOpen() then
    begin
      DebugMsg('ValidateWorld -> Opening world switcher...');
      Logout.GetButton(ELogoutButton.WORLD_SWITCHER).Click(MOUSE_LEFT);
      WaitUntil((CurrentWorld := WorldHopper.GetCurrentWorld()) <> 0, 65, 20000);
    end;

    CurrentWorld := WorldHopper.GetCurrentWorld();
    DebugMsg('ValidateWorld -> Detected world: ' + ToStr(CurrentWorld));

    if (CurrentWorld = 0) then
    begin
      DebugMsg('ValidateWorld -> Failed to detect current world, retrying...');
      Wait(1000);
      Continue;
    end;

    Break;
  end;

  if (CurrentWorld = 0) then
  begin
    DebugMsg('Unable to detect current world after 5 attempts.');
    DebugMsg('ValidateWorld -> Returning WORLD_BAD');
    Exit(EState.WORLD_BAD);
  end;

  if (Length(PlayerWorlds) = 0) then
  begin
    DebugMsg('ValidateWorld -> Player world list empty, skipping validation');
    Exit;
  end;

  if (CurrentWorld in PlayerWorlds) then
  begin
    DebugMsg('ValidateWorld -> World ' + ToStr(CurrentWorld) + ' is valid');
    Exit;
  end;

  DebugMsg('Current world (' + ToStr(CurrentWorld) + ') not in allowed list. Initiating world hop...');
  DebugMsg('ValidateWorld -> Returning HOP_WORLD');
  Exit(EState.HOP_WORLD);
end;

procedure TScript.InitForemanPayment();
begin
  if Stats.GetLevel(ESKILL.SMITHING) < 60 then
  begin
    DebugMsg('Smithing level below 60. Checking Foreman payment...');
    if not Self.HandleForemanPayment() then
      DebugMsg('Foreman payment check complete (already paid or handled).')
    else
      DebugMsg('Foreman payment successful.');
  end
  else
    DebugMsg('Smithing level is 60 or higher. No Foreman fee required.');
end;

function TScript.HandleForemanPayment(): Boolean;
begin
  Result := False;

  DebugMsg('HandleForemanPayment -> Starting sequence');

  if Inventory.CountItemStack('Coins') < 2500 then
  begin
    if not Bank.IsOpen() then
      Self.WalkOpenBank();

    if Bank.IsOpen() then
    begin
      Self.CoinB.Quantity := 2500;
      if Bank.WithdrawItem(Self.CoinB, False) then
        WaitUntil(Inventory.CountItemStack('Coins') >= 2500, 100, 3000);

      GameInterface.Close(True);
      WaitUntil(not GameInterface.IsOpen(), 100, 2000);
    end;
  end;

  if Inventory.CountItemStack('Coins') >= 2500 then
  begin
    if Chat.HasContinue() then
      Chat.ClickContinue(True);

    if Self.Foreman.SmartClick('Pay') then
    begin
      DebugMsg('HandleForemanPayment -> Clicked Pay on Foreman');

      if WaitUntil(Length(Chat.GetOptions()) > 0, 100, 4000) then
      begin
        if Chat.ClickOption('Yes') then
        begin
          DebugMsg('HandleForemanPayment -> Payment confirmed');

          WaitUntil(Chat.HasContinue(), 100, 3000);
          Chat.ClickContinue(True);
          Result := True;
        end;
      end;
    end;
  end;
end;

function TScript.CalculateCoalWithdrawal(totalCoalNeeded: Int32): TCoalWithdrawal;
var
  currentTrip: TTrip;
  currentSyncTripIndex: Int32;
begin
  if not Self.UseCoalBag then
  begin
    Result.InventoryCoal := Min(totalCoalNeeded, 28);
    Result.BagCoal := 0;

      DebugMsg('CalculateCoalWithdrawal -> TotalNeeded=' + ToStr(totalCoalNeeded) +
               ', Bag=' + ToStr(Result.BagCoal) + ', Inv=' + ToStr(Result.InventoryCoal));
    Exit;
  end;

  if Self.UseSyncTrip then
  begin
    currentSyncTripIndex := Self.MultiSyncTrip.CurrentSyncTrip - 1;
    currentTrip.Coal := Self.MultiSyncTrip.TripCoal[currentSyncTripIndex];
    currentTrip.Ore := Self.MultiSyncTrip.TripOre[currentSyncTripIndex];
  end
  else
    currentTrip := Self.TripSequence[Self.CurrentTrip];

  if currentTrip.Ore > 0 then
  begin
    if totalCoalNeeded <= Self.CoalBagCapacity then
    begin
      Result.InventoryCoal := 0;
      Result.BagCoal := totalCoalNeeded;
    end
    else
    begin
      Result.BagCoal := Self.CoalBagCapacity;
      Result.InventoryCoal := Min(totalCoalNeeded - Self.CoalBagCapacity, 27);
    end;
  end
  else
  begin
    if totalCoalNeeded <= 27 then
    begin
      Result.InventoryCoal := totalCoalNeeded;
      Result.BagCoal := 0;
    end
    else if totalCoalNeeded <= Self.CoalBagCapacity then
    begin
      Result.InventoryCoal := 0;
      Result.BagCoal := totalCoalNeeded;
    end
    else
    begin
      Result.BagCoal := Self.CoalBagCapacity;
      Result.InventoryCoal := Min(totalCoalNeeded - Self.CoalBagCapacity, 27);
    end;
  end;

  DebugMsg('CalculateCoalWithdrawal -> TotalNeeded=' + ToStr(totalCoalNeeded) +
             ', Bag=' + ToStr(Result.BagCoal) + ', Inv=' + ToStr(Result.InventoryCoal) +
             ' (Trip needs ore: ' + ToStr(currentTrip.Ore > 0) + ')');
end;

function TScript.ContainsCofferOverlay(): Boolean;
var
  x, y: Int32;
begin
while XPBar.Bounds.Expand(0, 10).Contains(Mouse.Position()) do
  begin
    DebugMsg('Moving mouse out of the XPBar');
    Mouse.Move(MainScreen.Bounds, True);
  end;

  Self.CofferDTM := DTMFromString('mbQAAAHicY2VgYHjOyMBwCYgZmSAYxHYEiptAcS4U/58hz8DHx4OCsQFGLBgMAANBBng=');
  Result := FindDTM(Self.CofferDTM, X, Y, MainScreen.Bounds);
  DebugMsg('ContainsCofferOverlay -> ' + ToStr(Result) + ' at [' + ToStr(X) + ',' + ToStr(Y) + ']');
end;

function TScript.GaugeMenuOpen(): Boolean;
var
  x, y: Int32;
begin
  Result := FindDTM(Self.GaugeDTM, x, y, MainScreen.Bounds);
  DebugMsg('GaugeMenuOpen -> ' + ToStr(Result) + ' at [' + ToStr(x) + ',' + ToStr(y) + ']');
end;

procedure TScript.CloseGaugeMenu();
var
  x, y: Int32;
begin
  if FindDTM(Self.GaugeXDTM, x, y, MainScreen.Bounds) then
  begin
    x += RandomRange(-2, 3);
    y += RandomRange(-2, 3);
    Mouse.Click(x, y, MOUSE_LEFT);
    DebugMsg('CloseGaugeMenu -> Clicked at [' + ToStr(x) + ',' + ToStr(y) + ']');
  end
  else
    DebugMsg('CloseGaugeMenu -> GaugeXDTM not found');
end;

function TScript.EmptyPot(): Boolean;
begin
  Result := False;

  DebugMsg('EmptyPot -> Attempting to empty pot...');

  if not Chat.ClickOption('Empty') then
  begin
    DebugMsg('EmptyPot -> "Empty" option not found or click failed');
    Exit;
  end;

  if not WaitUntil(Chat.HasContinue(), 1000, 6000) then
  begin
    DebugMsg('EmptyPot -> Timed out waiting for chat continue');
    Exit;
  end;

  Wait(100, 200);
  Chat.ClickContinue();

  DebugMsg('EmptyPot -> Pot emptied successfully. Resetting counts.');

  Self.LoadedCoal := 0;
  Self.LoadedOre := 0;

  Result := True;
end;

procedure TScript.ReSyncPot();
begin
  Self.OutOfSync := True;
  Inc(Self.DesyncCount);
  Self.DispenserFull := True;

  begin
    DebugMsg('ReSyncPot -> Triggered resync');
    DebugMsg('   OutOfSync set to ' + ToStr(Self.OutOfSync));
    DebugMsg('   DispenserFull set to ' + ToStr(Self.DispenserFull));
  end;
end;

function TScript.OpenPot(): Boolean;
begin
  Result := False;
  DebugMsg('OpenPot -> Starting pot interaction');

  if not Self.MeltingPot.SmartClick('Melting') then
  begin
    DebugMsg('OpenPot -> Failed to click MeltingPot');
    Exit;
  end;

  DebugMsg('OpenPot -> Clicked MeltingPot, waiting for menu');

  if WaitUntil('Select an' in Chat.GetChatTitle(), 1000, 6000) then
  begin
    Result := True;
    DebugMsg('OpenPot -> Menu appeared successfully');
  end
  else
    DebugMsg('OpenPot -> Timeout waiting for menu. Current chat title: "' + Chat.GetChatTitle() + '"');

  Self.OutOfSync := False;
end;

function TScript._ParsePotValue(const opts: TChatboxOptionArray; const keyword: String): Int32;
var
  text, numStr: String;
  i: Int32;
begin
  Result := -1;
  for i := 0 to High(opts) do
  begin
    text := opts[i].Text;
    if Pos(LowerCase(keyword), LowerCase(text)) > 0 then
    begin
      numStr := Trim(Copy(text, Pos(':', text) + 1, Length(text)));
      Result := StrToIntDef(numStr, -1);
      DebugMsg(Format('_ParsePotValue[%s] -> Match="%s", Parsed=%d', [keyword, text, Result]));
      Exit;
    end;
  end;
end;

function TScript.ReadPot(): Boolean;
var
  currentPage, oreValue, retryCount: Int32;
  hasContinue: Boolean;
  oreTypes, foundOres: TStringArray;
  oreType: String;
  chatOpts: TChatboxOptionArray;
begin
  Result := False;
  retryCount := 0;
  oreTypes := ['Iron ore', 'Silver ore', 'Coal', 'Gold ore', 'Mithril ore', 'Adamantite ore', 'Runite ore'];

  DebugMsg('ReadPot -> Starting');

  while retryCount <= 3 do
  begin
    currentPage := 1;
    foundOres := [];
    Self.LoadedCoal := -1;
    Self.LoadedOre := -1;

    if not Chat.HasContinue() then
    begin
      DebugMsg('ReadPot -> Pot not open, opening it first');
      if not Self.OpenPot() then
      begin
        DebugMsg('ReadPot -> Failed to open pot');
        Exit(False);
      end;

      DebugMsg('ReadPot -> Waiting for pot menu to appear');
      if not WaitUntil('Select an' in Chat.GetChatTitle(), 1000, 6000) then
      begin
        DebugMsg('ReadPot -> Pot menu did not appear');
        Exit(False);
      end;

      if (LowerCase(Self.BarType) = 'steel') and (Self.LoadedCoal <> 0) then
      begin
        DebugMsg('ReadPot -> Steel bar mode with coal detected, forcing Empty');
        Self.EmptyPot();
        Result := True;
        Break;
      end
      else if Self.GetUseEmpty() then
      begin
        DebugMsg('ReadPot -> Empty option enabled, clicking Empty');
        Self.EmptyPot();
        Result := True;
        Break;
      end
      else if Self.NeedsEmptyPot then
      begin
        DebugMsg('ReadPot -> Invalid LoadOre or LoadCoal. Emptying pot');
        Self.EmptyPot();
        Self.NeedsEmptyPot := False;
        Result := True;
        Break;
      end
      else
      begin
        DebugMsg('ReadPot -> Clicking Check option');
        Chat.ClickOption('Check');
        WaitUntil(Chat.HasContinue(), 1000, 3000);
        Wait(100, 200);
        DebugMsg('ReadPot -> Waiting for pot contents to appear');

      if not WaitUntil(Chat.HasContinue(), 50, 2000) then
        begin
          DebugMsg('ReadPot -> Timeout waiting for pot contents. Chat: ' + Chat.GetChat());
          Exit(False);
        end;
        if not Chat.HasContinue() then
        begin
          DebugMsg('ReadPot -> Chat did not have continue after pot contents appeared');
          Exit(False);
        end;
      end;
    end;

    chatOpts := Chat.GetOptions();
    DebugMsg('ReadPot -> Read page 1 chat options');

    for oreType in oreTypes do
    begin
      oreValue := Self._ParsePotValue(chatOpts, oreType);
      if oreValue <> -1 then
      begin
        if oreType = 'Coal' then
          Self.LoadedCoal := oreValue
        else
        begin
          foundOres += oreType;
          if oreType = Self.Ore then
            Self.LoadedOre := oreValue;
        end;

        DebugMsg('ReadPot -> Found ' + oreType + ' on page 1: ' + ToStr(oreValue));
      end;
    end;

    if not Chat.HasContinue() then
    begin
      DebugMsg('ReadPot -> Menu closed during page 1 read, retrying');
      Inc(retryCount);
      Wait(500, 800);
      Continue;
    end;

    hasContinue := Chat.HasContinue();
    if hasContinue then
    begin
      DebugMsg('ReadPot -> Page 2 exists, clicking Continue');
      Chat.ClickContinue(True);
      Wait(100, 200);

      if not Chat.HasContinue() then
      begin
        DebugMsg('ReadPot -> No page 2 (menu closed after clicking continue)');
      end
      else
      begin
        currentPage := 2;

        chatOpts := Chat.GetOptions();
        DebugMsg('ReadPot -> Read page 2 chat options');

        for oreType in oreTypes do
        begin
          oreValue := Self._ParsePotValue(chatOpts, oreType);
          if oreValue <> -1 then
          begin
            if oreType = 'Coal' then
            begin
              if Self.LoadedCoal = -1 then
                Self.LoadedCoal := oreValue;
            end
            else
            begin
              if foundOres.Find(oreType) = -1 then
                foundOres += oreType;
              if (oreType = Self.Ore) and (Self.LoadedOre = -1) then
                Self.LoadedOre := oreValue;
            end;

            DebugMsg('ReadPot -> Found ' + oreType + ' on page 2: ' + ToStr(oreValue));
          end;
        end;

        if not Chat.HasContinue() then
        begin
          DebugMsg('ReadPot -> Menu closed during page 2 read, retrying');
          Inc(retryCount);
          Wait(100, 200);
          Continue;
        end;

        DebugMsg('ReadPot -> Returning to page 1');
        Chat.ClickContinue(True);
        Wait(100, 200);
      end;
    end;

    if Length(foundOres) > 1 then
    begin
      DebugMsg('ReadPot -> ERROR: Multiple ore types detected in pot: ' + ToString(foundOres));
      DebugMsg('ReadPot -> Please manually clear the blast furnace pot before running the script.');
      TerminateScript();
    end;

    if Self.LoadedCoal = -1 then
      Self.LoadedCoal := 0;
    if Self.LoadedOre = -1 then
      Self.LoadedOre := 0;

    Inc(Self.ConsecutivePotReads);
    DebugMsg('ReadPot -> Finished, LoadedCoal=' + ToStr(Self.LoadedCoal) +
               ', LoadedOre=' + ToStr(Self.LoadedOre) + ' | ConsecutiveReads=' + ToStr(Self.ConsecutivePotReads));

    Result := True;
    Break;
  end;

  if not Result then
    DebugMsg('ReadPot -> Failed after retry');
end;

function TScript.CountCofferMoney(attempt: Int32 = 0; allowClose: Boolean = True): Int32;
var
  elapsed: UInt64;
  firstRead, retryRead, retries: Int32;
begin
  elapsed := GetSystemTime() - Self.LastCofferDepositTime;

  if (elapsed < 60000 * (Self.LastCofferAmount / 10000)) and (Self.LastCofferAmount > 0) then
  begin
    DebugMsg('CountCofferMoney -> Skipping recheck (recent deposit): ' + ToStr(Self.LastCofferAmount) + ' gp cached');
    Exit(Self.LastCofferAmount);
  end;

  Result := SRL.GetItemAmount(Self.CofferBounds);
  firstRead := Result;

  retries := 0;
  while (retries < 10) do
  begin
    if (Self.LastCofferAmount > 10000) and (Result > 0) then
    begin
      if (Result < Self.LastCofferAmount * 0.8) or (Result > Self.LastCofferAmount * 1.2) then
      begin
        Inc(retries);

        DebugMsg('CountCofferMoney -> Suspicious reading (' + ToStr(Result) +
                   ' vs cached ' + ToStr(Self.LastCofferAmount) + '), retry ' + ToStr(retries) + '/10');
        Wait(200, 300);
        retryRead := SRL.GetItemAmount(Self.CofferBounds);

        if Abs(retryRead - Self.LastCofferAmount) < Abs(Result - Self.LastCofferAmount) then
        begin
          Result := retryRead;
          DebugMsg('CountCofferMoney -> Retry reading is better: ' + ToStr(Result));
        end;

        if retries >= 3 then
        begin
          if Abs(Result - retryRead) < (Result * 0.1) then
          begin
            DebugMsg('CountCofferMoney -> Readings stabilized after ' + ToStr(retries) + ' retries: ' + ToStr(Result));
            Break;
          end;
        end;

        Continue;
      end
      else
        Break;
    end
    else
      Break;
  end;

  if (Result = 0) and (Self.LastCofferAmount > 0) then
  begin
    DebugMsg('CountCofferMoney -> All readings failed (0), using cached: ' + ToStr(Self.LastCofferAmount));
    Exit(Self.LastCofferAmount);
  end;

  Self.LastCofferCheck := GetSystemTime();
  Self.LastCofferAmount := Result;

  DebugMsg('CountCofferMoney -> Final result: ' + ToStr(Result) +
             ' (first read: ' + ToStr(firstRead) + ', retries: ' + ToStr(retries) + ')');
end;

function TScript.WaitForBars(): Boolean;
var
  attempt, consecutiveEmpty: Int32;
  upText: String;
  hadXPDrop: Boolean;
begin
  Result := False;
  attempt := 0;
  hadXPDrop := False;
  consecutiveEmpty := 0;

  DebugMsg('WaitForBars -> Waiting for bars to be ready...');

  while (attempt < 60) and not Result do
  begin
    Inc(attempt);

    if not hadXPDrop and Self.EarnedXP() then
    begin
      hadXPDrop := True;
      DebugMsg('WaitForBars -> XP drop detected, bars should be ready');
    end;

    if Self.HoveringBarDispenser('WaitForBars') then
    begin
      upText := MainScreen.GetUpText();

      if upText.Contains('Take') then
      begin
        Self.DispenserFull := True;
        Self.PotFull := True;
        consecutiveEmpty := 0;

        DebugMsg('WaitForBars -> Bars ready! UpText="' +
                   upText + '" | DispenserFull=' + ToStr(Self.DispenserFull) + ' | PotFull=' + ToStr(Self.PotFull));

        Result := True;
        Exit;
      end
      else if upText.Contains('Check') then
      begin
        Inc(consecutiveEmpty);

        if consecutiveEmpty >= 10 then
        begin
          DebugMsg('WaitForBars -> Dispenser empty for 10 checks, likely out of sync');

          Self.DispenserFull := False;
          Self.OutOfSync := True;
          Inc(Self.DesyncCount);
          Exit(False);
        end;
      end;
    end;

    Wait(100, 200);
  end;

  if not Result and Self.GetDebugMode() then
    DebugMsg('WaitForBars -> Timeout after ' + ToStr(attempt) + ' attempts');
end;

function TScript.WalkOpenBank(): Boolean;
var
  attempt: Integer;
  bankMM: TPoint;
  walkedToBank: Boolean;
begin
  Result := False;
  walkedToBank := False;

  for attempt := 1 to 5 do
  begin
    DebugMsg('WalkOpenBank: Attempt #' + ToStr(attempt));

    if Bank.IsOpen() or BankPin.IsOpen() then
    begin
      DebugMsg('WalkOpenBank: Bank/Pin detected open on attempt #' + ToStr(attempt));
      Exit(True);
    end;

    if GameInterface.IsOpen() then
    begin
      GameInterface.Close(True);
      DebugMsg('WalkOpenBank: Closed non-bank interface');
      Wait(200, 400);
    end;

    if not Self.BankChest.SmartClick('Use') then
    begin
      DebugMsg('WalkOpenBank: SmartClick failed (Object likely obscured or off-screen)');

      if (attempt >= 3) and not walkedToBank then
      begin
        DebugMsg('WalkOpenBank: Walking to bank tile ' + ToStr(Self.BankStandTile));
        bankMM := Map.Map2MM(Self.BankStandTile.RandomValue());

        if Map.Walker.Click(bankMM, 0) then
        begin
          Self.WaitMoving(False, False, 1000);
          walkedToBank := True;
          Wait(400, 800);
          Continue;
        end;
      end;

      Wait(200, 400);
      Continue;
    end;

    if Inventory.ContainsItem(Self.Bar) then
      Inventory.MouseItem(Self.Bar)
    else if (Inventory.ContainsItem(Self.CoalBag)) and
            (Self.State in [EState.COAL_GET, EState.COAL_LOAD, EState.BAG_REFILL, EState.BAG_EMPTY]) then
      Inventory.MouseItem(Self.CoalBag);

    Self.WaitMoving(False, False, 1000);

    if WaitUntil(Bank.IsOpen() or BankPin.IsOpen(), 300, 4000) then
    begin
      Result := True;
      DebugMsg('WalkOpenBank: Bank open success on attempt #' + ToStr(attempt));
      Exit;
    end;

    Wait(RandomRange(200, 400));
  end;

  if not Result then
    DebugMsg('WalkOpenBank: Failed to open bank after 5 attempts');
end;

function TScript.WithdrawGloveorBag(out item: TBankItem): Boolean;
var
  invCount: Int32;
begin
  Result := False;
  invCount := Self.InventoryCountRobust();

  if invCount = 28 then
  begin
    DebugMsg('WithdrawGloveorBag: Inventory full');
    Exit;
  end;

  if Bank.WithdrawItem(item, True) then
  begin
    Result := WaitUntil(invCount <> Self.InventoryCountRobust(), 300, 3000);
    DebugMsg('WithdrawGloveorBag: Withdraw attempted, Result=' + ToStr(Result));
  end
  else
    DebugMsg('WithdrawGloveorBag: WithdrawItem call failed');
end;

function TScript.FormatTimeShort(const TimeStr: String): String;
var
  h, m, s, p1, p2: Int32;
  hStr, mStr, sStr: String;
begin
  Result := '';

  p1 := Pos(':', TimeStr);
  if p1 = 0 then
    Exit(TimeStr);

  p2 := PosEx(':', TimeStr, p1 + 1);
  if p2 = 0 then
    Exit(TimeStr);

  hStr := Copy(TimeStr, 1, p1 - 1);
  mStr := Copy(TimeStr, p1 + 1, p2 - p1 - 1);
  sStr := Copy(TimeStr, p2 + 1, Length(TimeStr) - p2);

  h := StrToIntDef(hStr, 0);
  m := StrToIntDef(mStr, 0);
  s := StrToIntDef(sStr, 0);

  Result := Format('%2.2dh %2.2dm %2.2ds', [h, m, s]);
end;

procedure TScript.DrawUIOverlay(drawBox: TBox; title, status, runtime, xpRate, barsRate, profitRate, nextBreak, nextSleep, nextTrip: String;
  useHeaderColor: Boolean = False);
var
  yPos, lineSpacing, headerSpacing, totalTrips, currentTripIndex, oreCount, coalCount: Int32;
  headerColor: TColor;
  tripInfo, collectFlag: String;
  xpGained, inBars, exBars, currentSyncTripIndex, expectedCoal, expectedOre: Int32;
  currentTrip: TTrip;
  inOre, inCoal, exOre, exCoal, oreDelta, coalNeeded, coalCanSupport, barsFromThisLoad: Int32;
begin
  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if not Self.UIEnabled then
    Exit;

  if Self.UseSyncTrip then
  begin
    currentSyncTripIndex := Self.MultiSyncTrip.CurrentSyncTrip - 1;
    if (currentSyncTripIndex < 0) or (currentSyncTripIndex >= Self.MultiSyncTrip.TotalTrips) then
    begin
      currentTrip.Coal := 0;
      currentTrip.Ore := 0;
      currentTrip.ShouldCollect := False;
    end
    else
    begin
      currentTrip.Coal := Self.MultiSyncTrip.TripCoal[currentSyncTripIndex];
      currentTrip.Ore := Self.MultiSyncTrip.TripOre[currentSyncTripIndex];
      currentTrip.ShouldCollect := Self.MultiSyncTrip.IsCollectionTrip[currentSyncTripIndex];
    end;
  end
  else
  begin
    if (Length(Self.TripSequence) > 0) and (Self.CurrentTrip >= 0) and (Self.CurrentTrip < Length(Self.TripSequence)) then
      currentTrip := Self.TripSequence[Self.CurrentTrip]
    else
    begin
      currentTrip.Coal := 0;
      currentTrip.Ore := 0;
      currentTrip.ShouldCollect := False;
    end;
  end;

  lineSpacing   := Self.UIFontSize + 2;
  headerSpacing := Self.UIFontSize + 4;

  if useHeaderColor then
    headerColor := $00D4FF
  else
    headerColor := Self.UITextColor;

  GameClient.Image().DrawBox(drawBox, Self.UITextColor);
  GameClient.Image().SetFontName('Arial');
  GameClient.Image().SetFontSize(Self.UIFontSize);
  GameClient.Image().SetFontAntialiasing(True);

  yPos := drawBox.Y1 + 6;
  GameClient.Image().SetFontSize(Self.UIFontSize + 1);

  if Self.TakeBreaks then
    nextBreak := FormatTimeShort(Antiban.TimeUntilBreak(Antiban.Breaks[0]))
  else
    nextBreak := 'Breaks disabled';

  if Self.GetTakeSleeps then
    nextSleep := SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - GetTimeRunning)), Time_Short)
  else
    nextSleep := 'Sleeps disabled';

  GameClient.Image().DrawText(title, Point(drawBox.X1 + 3, yPos), headerColor);
  yPos += headerSpacing;

  GameClient.Image().SetFontSize(Self.UIFontSize - 1);
  GameClient.Image().DrawText('Status: ' + status, Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  GameClient.Image().DrawText('Runtime: ' + runtime, Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  xpGained := Self.CheckXP() - Self.StartXP;
  GameClient.Image().DrawText('XP Gained: ' + IntToStr(xpGained) + ' (' + xpRate + '/HR)', Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  GameClient.Image().DrawText('Bars Made: ' + IntToStr(Self.totalBars) + ' (' + barsRate + '/HR)', Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  GameClient.Image().DrawText('Profit: ' + IntToStr(Self.TotalProfit) + ' (' + profitRate + '/HR)', Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  GameClient.Image().DrawText('Next break: ' + nextBreak, Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  GameClient.Image().DrawText('Next sleep: ' + nextSleep, Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  oreCount  := currentTrip.Ore;
  coalCount := currentTrip.Coal;

  if currentTrip.ShouldCollect then
    collectFlag := 'Y'
  else
    collectFlag := 'N';

  if Self.UseSyncTrip then
  begin
    tripInfo := 'Sync ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip) + '/' +
                ToStr(Self.MultiSyncTrip.TotalTrips) +
                ' | Ore: ' + ToStr(oreCount) + ' | Coal: ' + ToStr(coalCount) +
                ' | Collect: ' + collectFlag;
  end
  else
  begin
    totalTrips       := Length(Self.TripSequence);
    currentTripIndex := Self.CurrentTrip;
    tripInfo := ToStr(currentTripIndex + 1) + '/' + ToStr(totalTrips) +
                ' | Ore: ' + ToStr(oreCount) +
                ' | Coal: ' + ToStr(coalCount) +
                ' | Collect: ' + collectFlag;
  end;

  if (Length(Self.TripSequence) > 0) and (Self.CurrentTrip >= 0) and (Self.CurrentTrip < Length(Self.TripSequence)) then
  begin
    expectedCoal := Self.TripStartCoal + Self.TripSequence[Self.CurrentTrip].Coal;
    expectedOre  := Self.TripStartOre  + Self.TripSequence[Self.CurrentTrip].Ore;
  end
  else
  begin
    expectedCoal := Self.LoadedCoal;
    expectedOre  := Self.LoadedOre;
  end;

  GameClient.Image().DrawText('Trip: ' + tripInfo, Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  yPos += lineSpacing;

  inOre  := Self.LoadedOre;
  inCoal := Self.LoadedCoal;
  inBars := 0;

  exOre  := expectedOre;
  exCoal := expectedCoal;
  exBars := 0;

  oreDelta := exOre - inOre;
  if oreDelta > 0 then
  begin
    if Self.CoalRatio > 0 then
      coalCanSupport := inCoal div Self.CoalRatio
    else
      coalCanSupport := 0;

    if oreDelta > coalCanSupport then
      barsFromThisLoad := coalCanSupport
    else
      barsFromThisLoad := oreDelta;

    coalNeeded := barsFromThisLoad * Self.CoalRatio;

    inCoal := inCoal - coalNeeded;
    inOre  := inOre  + oreDelta - barsFromThisLoad;
    inBars := barsFromThisLoad;

    exCoal := exCoal - coalNeeded;
    exOre  := exOre  - barsFromThisLoad;
    exBars := barsFromThisLoad;

    if inCoal < 0 then inCoal := 0;
    if inOre  < 0 then inOre  := 0;
    if exCoal < 0 then exCoal := 0;
    if exOre  < 0 then exOre  := 0;

  end;

  begin
    GameClient.Image().DrawText(
      'Ex Pot  - Ore: ' + IntToStr(exOre) + ' | Coal: ' + IntToStr(exCoal) + ' | Bars: ' + IntToStr(exBars),
      Point(drawBox.X1 + 3, yPos), Self.UITextColor);
    yPos += lineSpacing;

    GameClient.Image().DrawText('Desyncs: ' + IntToStr(Self.DesyncCount), Point(drawBox.X1 + 3, yPos), Self.UITextColor);
  end;
  {$ENDIF}
end;

function TScript.DepositBars(): Int32;
var
  barsBefore, barsAfter, deposited: Int32;
begin
  Result := 0;

  if not Bank.IsOpen() then
  begin
    DebugMsg('DepositBars -> Bank not open, opening now');
    if not Self.WalkOpenBank() then
      Exit;
  end;

  barsBefore := Self.CountItemRobust(Self.Bar);
  Bank.DepositItem(Self.Bar, True);
  WaitUntil(not Inventory.ContainsItem(Self.Bar), 50, 8000);
  barsAfter := Self.CountItemRobust(Self.Bar);
  deposited := barsBefore - barsAfter;

  Self.TotalBars := Self.TotalBars + deposited;
  Self.BarsDeposited := Self.BarsDeposited + deposited;

  Result := deposited;

  DebugMsg('DepositBars -> Deposited ' + ToStr(deposited) + ' bars | TotalBars now: ' + ToStr(Self.TotalBars));
end;

function TScript.PotIsBalanced(): Boolean;
begin
  Result := Self.LoadedCoal >= (Self.LoadedOre * Self.CoalRatio);

  DebugMsg('PotIsBalanced: LoadedCoal=' + ToStr(Self.LoadedCoal) +
             ', LoadedOre=' + ToStr(Self.LoadedOre) +
             ', Required=' + ToStr(Self.LoadedOre * Self.CoalRatio) +
             ', Result=' + ToStr(Result));
end;

function TScript.PotReady(): Boolean;
var
  totalCoal, maxCoalWeCanLoad: Int32;
begin
  if Self.CoalRatio = 0 then
  begin
    DebugMsg('PotReady: Skipping check (CoalRatio=0)');
    Exit(True);
  end;

  totalCoal := Self.LoadedCoal;

  if UseCoalBag then
    maxCoalWeCanLoad := 27 + Self.MaxCoalBag
  else
    maxCoalWeCanLoad := 27;

  DebugMsg('PotReady: TotalCoal=' + ToStr(totalCoal) + ' | MaxCoal=' + ToStr(maxCoalWeCanLoad) +
             ' | AvailableSlots=' + ToStr(Self.AvailableSlots));

  Result := (totalCoal >= maxCoalWeCanLoad);

  DebugMsg('PotReady: Result=' + ToStr(Result));
end;

function TScript._Load(out count: Int32): Boolean;
var
  before, after, coalBagSlot, loadAttempts, firstBatch: Int32;
  atpa: T2DPointArray;
  conveyorBox, bottomArea: TBox;
begin
  Result := False;
  before := Self.InventoryCountRobust();
  count  := 0;
  firstBatch := 0;
  loadAttempts := 0;

  repeat
    Inc(loadAttempts);

    if loadAttempts > 1 then
    begin
      DebugMsg('_Load -> Retry attempt ' + ToStr(loadAttempts) + '/3, waiting before retry');
      Wait(100, 200);
    end;

    Self.EarnedXP();
    Self.DispenserFull := False;

    if not Self.ConveyorBelt.Find(atpa) then
    begin
      DebugMsg('_Load -> Conveyor not found, retrying...');
      Wait(50, 100);
      Continue;
    end;

    conveyorBox := atpa.Merge().Bounds();
    bottomArea.X1 := conveyorBox.X1 + 4;
    bottomArea.Y1 := conveyorBox.Y1 + ((conveyorBox.Y2 - conveyorBox.Y1) div 2);
    bottomArea.X2 := conveyorBox.X2 - 4;
    bottomArea.Y2 := conveyorBox.Y2 - 4;

    if MainScreen.IsUpText('Put-ore-on') then
    begin
      DebugMsg('_Load -> UpText matches, fast clicking');
      Mouse.Click(MOUSE_LEFT);
    end
    else
    begin
      if not Self.ConveyorBelt.SmartClick('Put-ore-on', True, bottomArea) then
      begin
        DebugMsg('_Load -> SmartClick failed in bottomArea');
        Continue;
      end;
    end;

    if Self.UseCoalBag and (Self.CoalBagAmount > 0) then
    begin
      if Inventory.FindItem(Self.CoalBag, coalBagSlot) then
      begin
        Inventory.MouseSlot(coalBagSlot);
        Mouse.Click(MOUSE_RIGHT);

        if WaitUntil(ChooseOption.IsOpen(), 50, 1000) then
        begin
          if ChooseOption.Hover('Empty') then
            DebugMsg('_Load -> Hovering coal bag during load');
        end;
      end;
    end;

    if WaitUntil(Minimap.HasFlag() or Minimap.IsPlayerMoving(), 50, 2000) then
    begin
      DebugMsg('_Load -> Movement detected, monitoring physical Slot 4...');

      while (Minimap.HasFlag() or Minimap.IsPlayerMoving()) do
      begin
        if not Inventory.IsSlotUsed(3) then
        begin
          if ChooseOption.IsOpen() then
          begin
            firstBatch := before - 1;
            DebugMsg('_Load -> First batch (Inv) recorded: ' + ToStr(firstBatch));

            Mouse.Click(MOUSE_LEFT);
            DebugMsg('_Load -> Physical Slot 4 empty, clicked Empty');

            if WaitUntil(Inventory.IsFull(), 50, 1500) then
            begin
              DebugMsg('_Load -> Refilled, re-finding conveyor for 2nd batch');

              if Self.ConveyorBelt.Find(atpa) then
              begin
                conveyorBox := atpa.Merge().Bounds();
                bottomArea.X1 := conveyorBox.X1 + 4;
                bottomArea.Y1 := conveyorBox.Y1 + ((conveyorBox.Y2 - conveyorBox.Y1) div 2);
                bottomArea.X2 := conveyorBox.X2 - 4;
                bottomArea.Y2 := conveyorBox.Y2 - 4;

                Self.ConveyorBelt.SmartHover('Put-ore-on', bottomArea);

                if MainScreen.IsUpText('Put-ore-on') then
                  Mouse.Click(MOUSE_LEFT)
                else
                  Self.ConveyorBelt.SmartClick('Put-ore-on', True, bottomArea);

                before := Self.InventoryCountRobust();
                Self.CoalBagAmount := Max(0, Self.CoalBagAmount - Self.CoalBagCapacity);
              end;
            end;
            Break;
          end;
        end;
        Wait(20, 40);
      end;

      WaitUntil(not Minimap.HasFlag() and not Minimap.IsPlayerMoving(), 50, 5000);
    end;

    DebugMsg('_Load -> Checking final inventory state');

    if WaitUntil((after := Self.InventoryCountRobust()) < before, 50, 6000) then
    begin
      count := firstBatch + (before - after);
      DebugMsg('_Load -> Total items deposited: ' + ToStr(count));
      Result := True;
      Exit;
    end;

  until (loadAttempts >= 3) or Result;
end;

function TScript.WithdrawHelper(item: String; amount: Int32): Boolean;
var
  bankItem: TBankItem;
  beforeCount, afterCount, i, itemsLength, attempt, freeSlots, adjustedAmount: Int32;
  useLeftClick: Boolean;
  allowedItems: TItemArray;
  menuOpen: Boolean;
begin
  Result := False;
  itemsLength := Length(Self.BankItems);

  for i := 0 to itemsLength - 1 do
  begin
    if Self.BankItems[i].Item = item then
    begin
      bankItem := Self.BankItems[i];
      Break;
    end;
  end;

  if bankItem.Item = '' then
  begin
    if Self.GetDebugMode() then
      DebugMsg('WithdrawHelper -> Item "' + item + '" not found in BankItems array');
    Exit;
  end;

  SetLength(allowedItems, 0);

  if Self.BarType = 'Gold' then
    allowedItems += Self.GoldGloves;

  allowedItems += Self.IceGloves;

  if Self.UseCoalBag then
    allowedItems += [Self.CoalBag, 'Open coal bag'];

  for attempt := 1 to 3 do
  begin
    freeSlots := InventoryCountEmptySlotsRobust();
    adjustedAmount := amount;

    if adjustedAmount > freeSlots then
    begin
      adjustedAmount := freeSlots;

      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Adjusted amount from ' + ToStr(amount) +
                 ' to ' + ToStr(adjustedAmount) + ' (available slots)');
    end;

    if Self.GetDebugMode() then
      DebugMsg('WithdrawHelper -> Attempt ' + ToStr(attempt) + '/3: Withdrawing ' +
               ToStr(adjustedAmount) + ' ' + item + ' (FreeSlots=' + ToStr(freeSlots) + ')');

    beforeCount := Self.CountItemRobust(item);

    if not Bank.ContainsItem(bankItem) then
    begin
      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> ' + item + ' not found in bank');
      Exit;
    end;

    if not Bank.GetButton(EBankQuantityButton.ALL).Enabled() then
    begin
      Bank.GetButton(EBankQuantityButton.ALL).Enable();
      Wait(100, 200);

      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Enabled "All" quantity button');
    end;

    useLeftClick := (adjustedAmount >= freeSlots);

    if useLeftClick then
    begin
      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Left-clicking to withdraw all (' + ToStr(adjustedAmount) + ')');

      Bank.MouseItem(item);
      Wait(100, 200);
      Mouse.Click(MOUSE_LEFT);
      Wait(200, 300);
    end
    else
    begin
      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Right-clicking for Withdraw-X (' + ToStr(adjustedAmount) + ')');

      Bank.MouseItem(item);
      Wait(100, 200);

      menuOpen := False;
      Mouse.Click(MOUSE_RIGHT);

      if WaitUntil(ChooseOption.IsOpen(), 50, 1500) then
        menuOpen := True;

      if not menuOpen then
      begin
          if Self.GetDebugMode() then
            DebugMsg('WithdrawHelper -> Right-click failed to open menu, retrying...');
          Mouse.Click(MOUSE_RIGHT);
          if WaitUntil(ChooseOption.IsOpen(), 50, 1500) then
             menuOpen := True;
      end;

      if not menuOpen then
      begin
        if Self.GetDebugMode() then
          DebugMsg('WithdrawHelper -> Right-click menu did not open after retries');

        if attempt < 3 then
        begin
          Wait(400, 600);
          Continue;
        end;
        Exit;
      end;

      if not ChooseOption.Select('Withdraw-X') then
      begin
        if Self.GetDebugMode() then
          DebugMsg('WithdrawHelper -> Failed to select "Withdraw-X"');

        if attempt < 3 then
        begin
          Wait(400, 600);
          Continue;
        end;
        Exit;
      end;

      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Selected "Withdraw-X"');

      Wait(850, 900);

      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Answering query with ' + ToStr(adjustedAmount));

      Keyboard.Send(ToStr(adjustedAmount), VK_ENTER);

      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Query answered');

      Wait(200, 300);
    end;

    if not WaitUntil(Self.CountItemRobust(item) > beforeCount, 100, 2500) then
    begin
      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Items did not appear in inventory on attempt ' + ToStr(attempt));

      if attempt < 3 then
      begin
        Wait(400, 600);
        Continue;
      end;
      Exit;
    end;

    afterCount := Self.CountItemRobust(item);

    if afterCount - beforeCount = adjustedAmount then
    begin
      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> SUCCESS: Withdrew exactly ' + ToStr(adjustedAmount) + ' ' + item);

      Result := True;
      Exit;
    end
    else
    begin
      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> MISMATCH: Expected ' + ToStr(adjustedAmount) +
                 ' but got ' + ToStr(afterCount - beforeCount) + ' ' + item);

      if Self.GetDebugMode() then
        DebugMsg('WithdrawHelper -> Depositing unexpected items, keeping gloves/coal bag');

      Bank.DepositRandomItems(allowedItems);
      Wait(400, 600);

      if attempt < 3 then
      begin
        if Self.GetDebugMode() then
          DebugMsg('WithdrawHelper -> Cleanup complete, retrying withdrawal');

        Wait(400, 600);
        Continue;
      end
      else
      begin
        if Self.GetDebugMode() then
          DebugMsg('WithdrawHelper -> All 3 attempts failed');
        Exit;
      end;
    end;
  end;
end;

function TScript.NeedsMoreCoal(): Boolean;
begin
  if (Self.CoalRatio = 0) or (LowerCase(Self.BarType) = 'gold') then
    Exit(False);

  Result := (Self.LoadedCoal + Self.CoalBagAmount) < (Self.AvailableSlots * Self.CoalRatio);

  DebugMsg('NeedsMoreCoal -> LoadedCoal=' + ToStr(Self.LoadedCoal) +
             ' | Bag=' + ToStr(Self.CoalBagAmount) +
             ' | Req=' + ToStr(Self.AvailableSlots * Self.CoalRatio) +
             ' | Result=' + ToStr(Result));
end;

function TScript.WithdrawCoal(amount: Int32): Boolean;
var
  coalBefore, coalAfter, withdrawn: Int32;
begin
  Result := False;

  if not Bank.IsOpen() then
    Exit(False);

  coalBefore := Self.CountItemRobust(Self.Coal);

  if Self.WithdrawHelper(Self.Coal, amount) then
  begin
    coalAfter := Self.CountItemRobust(Self.Coal);
    withdrawn := coalAfter - coalBefore;

    if withdrawn <> amount then
    begin
      DebugMsg('WithdrawCoal -> WARNING: Expected ' + ToStr(amount) +
                 ' but got ' + ToStr(withdrawn) + ' | Setting OutOfSync flag');
      Self.OutOfSync := True;
      Inc(Self.DesyncCount);
    end;

    Self.CoalToWithdraw := withdrawn;

    DebugMsg('WithdrawCoal -> Withdrew ' + ToStr(withdrawn) + ' coal');

    Result := withdrawn > 0;
  end
  else
    DebugMsg('WithdrawCoal -> Failed to withdraw coal');
end;

function TScript.WithdrawOre(amount: Int32): Boolean;
var
  oreBefore, oreAfter, withdrawn: Int32;
begin
  Result := False;

  if not Bank.IsOpen() then
    Exit(False);

  oreBefore := Self.CountItemRobust(Self.Ore);

  if Self.WithdrawHelper(Self.Ore, amount) then
  begin
    oreAfter := Self.CountItemRobust(Self.Ore);
    withdrawn := oreAfter - oreBefore;

    if withdrawn <> amount then
    begin
      DebugMsg('WithdrawOre -> WARNING: Expected ' + ToStr(amount) +
                 ' but got ' + ToStr(withdrawn) + ' | Setting OutOfSync flag');
      Self.OutOfSync := True;
      Inc(Self.DesyncCount);
    end;

    Self.OreToWithdraw := withdrawn;

    DebugMsg('WithdrawOre -> Withdrew ' + ToStr(withdrawn) + ' ore');

    Result := withdrawn > 0;
  end
  else
    DebugMsg('WithdrawOre -> Failed to withdraw ore');
end;

procedure TScript.ValidateCoalBag();
begin
  if (Self.CoalBagAmount <> 0) and (Self.CoalBagAmount <> 27) then
  begin
    DebugMsg('ValidateCoalBag -> CRITICAL ERROR: CoalBagAmount=' + ToStr(Self.CoalBagAmount) + ' (must be 0 or 27) | Forcing resync');

    Self.OutOfSync := True;
    Inc(Self.DesyncCount);

    Self.CoalBagAmount := 0;
  end;
end;

function TScript.LoadCoal(): Boolean;
var
  coalBefore, coalLoaded, totalItemsLoaded, currentSyncTripIndex: Int32;
  xpAfterCoalLoad: Int32;
  currentTrip: TTrip;
begin
  Result := False;

  DebugMsg('LoadCoal -> Starting');

  if Self.UseCoalBag and not Inventory.ContainsItem(Self.CoalBag) then
  begin
    DebugMsg('LoadCoal -> CRITICAL: Coal bag missing! Cannot load safely, returning to bank');
    Exit(False);
  end;

  if Self.UseSyncTrip then
  begin
    currentSyncTripIndex := Self.MultiSyncTrip.CurrentSyncTrip - 1;
    currentTrip.Coal := Self.MultiSyncTrip.TripCoal[currentSyncTripIndex];
    currentTrip.Ore := Self.MultiSyncTrip.TripOre[currentSyncTripIndex];
    currentTrip.ShouldCollect := Self.MultiSyncTrip.IsCollectionTrip[currentSyncTripIndex];
  end
  else
    currentTrip := Self.TripSequence[Self.CurrentTrip];

  coalBefore := Self.CountItemRobust(Self.Coal);

  DebugMsg('LoadCoal -> Pre-load coal count: ' + ToStr(coalBefore));

  if Self.UseCoalBag and (coalBefore > 27) then
  begin
    DebugMsg('LoadCoal -> CRITICAL: Have ' + ToStr(coalBefore) + ' coal (>27) with coal bag! Cannot load');
    Exit(False);
  end;

  if coalBefore > 28 then
  begin
    DebugMsg('LoadCoal -> CRITICAL: Have ' + ToStr(coalBefore) + ' coal (>28)! Invalid inventory state');
    Exit(False);
  end;

  Self.LastXPGained := Self.CheckXP();

  DebugMsg('LoadCoal -> Recording XP before load: ' + ToStr(Self.LastXPGained));

  Result := Self._Load(totalItemsLoaded);

  if (not Result) and (coalBefore > 0) then
  begin
    if Self.CountItemRobust(Self.Coal) = 0 then
    begin
      DebugMsg('LoadCoal -> Recovery: _Load returned False but Inventory is empty. Forcing Success.');
      Result := True;
      totalItemsLoaded := coalBefore;
    end;
  end;

  if Result then
  begin
    coalLoaded := totalItemsLoaded;

    if Self.UseCoalBag and (Self.CoalBagAmount > 0) then
    begin
      DebugMsg('LoadCoal -> Emptying coal bag, CoalBagAmount=' + ToStr(Self.CoalBagAmount));

      if Self.ShiftClickCoalBag() then
      begin
        DebugMsg('LoadCoal -> Coal bag emptied successfully');

        xpAfterCoalLoad := Self.CheckXP();

        if xpAfterCoalLoad > Self.LastXPGained then
        begin
          DebugMsg('LoadCoal -> XP increased after coal bag emptied, bars starting');
          Self.LastXPGained := xpAfterCoalLoad;
        end;
      end
      else
      begin
        DebugMsg('LoadCoal -> Failed to empty coal bag');
      end;
    end;

    Self.LoadedCoal := Self.LoadedCoal + coalLoaded;
    Self.ConveyorFailCount := 0;

    if ((Self.LoadedCoal + Self.CoalBagAmount) >= (Self.TripStartCoal + currentTrip.Coal)) and
       ((currentTrip.Ore = 0) or (Self.LoadedOre >= (Self.TripStartOre + currentTrip.Ore))) then
    begin
      Self.CurrentTripLoaded := True;
      Self.WaitingForBars := True;

      DebugMsg('LoadCoal -> Trip complete after loading coal, waiting for bars');
    end;

    if (Self.LoadedCoal + Self.LoadedOre) >= 54 then
    begin
      if (Self.LoadedCoal > 0) and (Self.LoadedOre > 0) then
      begin
        Self.PotFull := True;

        DebugMsg('LoadCoal -> Pot full (capacity check)');
      end;
    end;

    DebugMsg('LoadCoal -> Moved ' + ToStr(coalLoaded) +
               ' coal, LoadedCoal=' + ToStr(Self.LoadedCoal) +
               ', LoadedOre=' + ToStr(Self.LoadedOre) +
               ', CurrentTripLoaded=' + ToStr(Self.CurrentTripLoaded) +
               ', PotFull=' + ToStr(Self.PotFull));
  end
  else
  begin
    DebugMsg('LoadCoal -> Failed to load coal');
    Inc(Self.ConveyorFailCount);
  end;

  Self.ValidateTracking();
end;

function TScript.LoadOre(): Boolean;
var
  oreBefore, oreAfter, oreLoaded: Int32;
  coalBefore, coalAfter, coalLoaded, coalBagBefore, coalBagAfter: Int32;
  totalItemsLoaded, xpAfterOreLoad, currentSyncTripIndex: Int32;
  currentTrip: TTrip;
  coalMsg: String;
begin
  Result := False;

  DebugMsg('LoadOre -> Starting');

  if Self.UseCoalBag and not Inventory.ContainsItem(Self.CoalBag) then
  begin
    DebugMsg('LoadOre -> CRITICAL: Coal bag missing! Cannot load safely, returning to bank');
    Exit(False);
  end;

  if Self.UseSyncTrip then
  begin
    currentSyncTripIndex := Self.MultiSyncTrip.CurrentSyncTrip - 1;
    currentTrip.Coal := Self.MultiSyncTrip.TripCoal[currentSyncTripIndex];
    currentTrip.Ore := Self.MultiSyncTrip.TripOre[currentSyncTripIndex];
    currentTrip.ShouldCollect := Self.MultiSyncTrip.IsCollectionTrip[currentSyncTripIndex];
  end
  else
    currentTrip := Self.TripSequence[Self.CurrentTrip];

  oreBefore := Self.CountItemRobust(Self.Ore);
  coalBefore := Self.CountItemRobust(Self.Coal);

  DebugMsg('LoadOre -> Pre-load validation: Ore=' + ToStr(oreBefore) + ', Coal=' + ToStr(coalBefore));

  if Self.UseCoalBag and (oreBefore > 27) then
  begin
    DebugMsg('LoadOre -> CRITICAL: Have ' + ToStr(oreBefore) + ' ore (>27) with coal bag! Cannot load');
    Exit(False);
  end;

  if oreBefore > 28 then
  begin
    DebugMsg('LoadOre -> CRITICAL: Have ' + ToStr(oreBefore) + ' ore (>28)! Invalid inventory state');
    Exit(False);
  end;

  if (coalBefore > 0) and (LowerCase(Self.BarType) <> 'cupronickel') then
  begin
    DebugMsg('LoadOre -> ERROR: Have ' + ToStr(coalBefore) + ' coal in inventory while loading ore');
    Exit(False);
  end;

  coalBagBefore := Self.CoalBagAmount;
  Self.LastXPGained := Self.CheckXP();

  DebugMsg('LoadOre -> Recording XP before load: ' + ToStr(Self.LastXPGained));

  Result := Self._Load(totalItemsLoaded);

  oreAfter := Self.CountItemRobust(Self.Ore);

  if (LowerCase(Self.BarType) = 'cupronickel') and (oreAfter = 0) and Inventory.ContainsItem(Self.Coal) then
  begin
    DebugMsg('LoadOre -> Cupronickel: Ore loaded, waiting for Copper (Coal) to sync...');
    WaitUntil(not Inventory.ContainsItem(Self.Coal), 100, 3000);
  end;

  coalAfter := Self.CountItemRobust(Self.Coal);
  coalBagAfter := Self.CoalBagAmount;
  oreLoaded := oreBefore - oreAfter;
  coalLoaded := coalBefore - coalAfter;

  if Self.UseCoalBag then
  begin
    if coalBagAfter < coalBagBefore then
    begin
      coalLoaded := coalLoaded + (coalBagBefore - coalBagAfter);
      DebugMsg('LoadOre -> Coal bag auto-refilled ' + ToStr(coalBagBefore - coalBagAfter) + ' coal, adjusting coalLoaded to ' + ToStr(coalLoaded));
    end;
  end;

  if (not Result) and (oreBefore > 0) then
  begin
    if oreAfter = 0 then
    begin
      DebugMsg('LoadOre -> Recovery: _Load returned False but Ore is gone. Forcing Success.');
      Result := True;
      totalItemsLoaded := oreLoaded + coalLoaded;
    end;
  end;

  if totalItemsLoaded <> (oreLoaded + coalLoaded) then
  begin
    DebugMsg('LoadOre -> WARNING: Tracking mismatch! _Load reported ' + ToStr(totalItemsLoaded) +
               ' but counted ' + ToStr(oreLoaded) + ' ore + ' + ToStr(coalLoaded) + ' coal = ' + ToStr(oreLoaded + coalLoaded));
  end;

  if Result then
  begin
    Self.LoadedOre := Self.LoadedOre + oreLoaded;
    Self.LoadedCoal := Self.LoadedCoal + coalLoaded;
    Self.ConveyorFailCount := 0;

    if Self.GetDebugMode() and (coalLoaded > 0) then
      DebugMsg('LoadOre -> Also loaded ' + ToStr(coalLoaded) + ' coal with the ore');

    xpAfterOreLoad := Self.CheckXP();

    if xpAfterOreLoad > Self.LastXPGained then
    begin
      DebugMsg('LoadOre -> XP increased immediately after ore load, bars starting early');
      Self.LastXPGained := xpAfterOreLoad;
    end;

    if ((Self.LoadedCoal + Self.CoalBagAmount) >= (Self.TripStartCoal + currentTrip.Coal)) and
       (Self.LoadedOre >= (Self.TripStartOre + currentTrip.Ore)) then
    begin
      if (not Self.UseCoalBag) or (Self.CoalBagAmount = 0) then
      begin
        Self.CurrentTripLoaded := True;
        Self.WaitingForBars := True;
        DebugMsg('LoadOre -> Trip complete after loading ore, waiting for bars');
      end
      else
      begin
        Self.CurrentTripLoaded := False;
        Self.WaitingForBars := False;
        DebugMsg('LoadOre -> Materials loaded but coal bag still needs emptying (bag=' + ToStr(Self.CoalBagAmount) + ')');
      end;
    end;

    if Self.CoalRatio = 0 then
    begin
      if Self.LoadedOre >= 27 then
      begin
        Self.PotFull := True;
        DebugMsg('LoadOre -> Gold ore loaded, pot full');
      end;
    end
    else
    begin
      if (Self.LoadedCoal + Self.LoadedOre) >= 54 then
      begin
        if (Self.LoadedCoal > 0) and (Self.LoadedOre > 0) then
        begin
          Self.PotFull := True;
          DebugMsg('LoadOre -> Ore loaded, pot full (capacity check)');
        end;
      end;
    end;

    if coalLoaded > 0 then
      coalMsg := ' and ' + ToStr(coalLoaded) + ' coal'
    else
      coalMsg := '';
      DebugMsg('LoadOre -> Moved ' + ToStr(oreLoaded) + ' ore' + coalMsg + ', LoadedOre=' + ToStr(Self.LoadedOre) +
               ', LoadedCoal=' + ToStr(Self.LoadedCoal) + ', CurrentTripLoaded=' + ToStr(Self.CurrentTripLoaded) +
               ', PotFull=' + ToStr(Self.PotFull));
  end
  else
  begin
    DebugMsg('LoadOre -> Failed to load ore');
    Inc(Self.ConveyorFailCount);
  end;

  Self.ValidateTracking();
end;

procedure TScript.WaitMoving(doAntiban: Boolean = True; change: Boolean = False; settleTime: Int32 = 0);
var
  timeout, settle: TCountDown;
  isMoving: Boolean;
  currentXP, settleMin, settleMax: Int32;
  checkFlag: Boolean;
begin
  timeout.Init(Round(SRL.TruncatedGauss(15000, 20000)));
  checkFlag := (settleTime = 0);

  if settleTime > 0 then
  begin
    settleMin := Round(settleTime * 0.8);
    settleMax := Round(settleTime * 1.2);
    settle.Init(Round(SRL.TruncatedGauss(settleMin, settleMax)));
    settle.timeout := GetTickCount() + Round(SRL.TruncatedGauss(settleMax, settleMax + 1000));
  end
  else
  begin
    settle.Init(Round(SRL.TruncatedGauss(1200, 3500)));
    settle.timeout := GetTickCount() + Round(SRL.TruncatedGauss(3500, 4500));
  end;

  DebugMsg('WaitMoving -> Init (settleTime=' + ToStr(settleTime) + ', checkFlag=' + ToStr(checkFlag) + ')');

  repeat
    currentXP := Self.CheckXP();
    if currentXP > Self.LastXPGained then
    begin
      Self.LastXPGained := currentXP;
      DebugMsg('WaitMoving -> XP increased while walking, bars being made');
    end;
    if not Self.DispenserFull and not Bank.IsOpen() then
      Self.DispenserFull := Self.EarnedXP();
    isMoving := Minimap.IsPlayerMoving();
    if isMoving then
    begin
      settle.Restart();
      DebugMsg('WaitMoving -> Movement detected, settle timer restarted');
    end;
  until timeout.IsFinished() or (not isMoving and settle.IsFinished()) or (checkFlag and not Minimap.HasFlag()) or Bank.IsOpen();

  DebugMsg('WaitMoving -> Exit (timeout=' + ToStr(timeout.IsFinished) + ', settle=' + ToStr(settle.IsFinished) +
             ', flag=' + ToStr(Minimap.HasFlag) + ', bank=' + ToStr(Bank.IsOpen) + ')');
end;

function TScript.IsItemHovered(const ItemName: String): Boolean;
var
  upText: String;
begin
  upText := LowerCase(Mainscreen.GetUpText());
  Result := (upText <> '') and (Pos(LowerCase(ItemName), upText) > 0);
end;

function TScript.WalkDispenser(): Boolean;
var
  waitTile: TPoint;
  iceGloveSlot: Int32;
begin
  Result := False;

  if Length(Self.DispenserWaitTiles) = 0 then
  begin
    DebugMsg('WalkDispenser -> No wait tiles defined');
    Exit;
  end;

  waitTile := Map.Map2MM(Self.DispenserWaitTiles.RandomValue());
  Result := Map.Walker.Click(waitTile, 0);

  if not Result then
  begin
    DebugMsg('WalkDispenser -> WebWalk failed');
    Exit;
  end;

  if Self.BarType = 'Gold' then
  begin
    if Inventory.FindItem(Self.IceGloves, iceGloveSlot) then
    begin
      DebugMsg('WalkDispenser -> Hovering ice gloves (slot ' + ToStr(iceGloveSlot) + ') while walking');
      Mouse.Move(Inventory.GetSlotBox(iceGloveSlot));
    end
    else
      DebugMsg('WalkDispenser -> WARNING: Ice gloves not found in inventory!');
  end;

  Self.WaitMoving(False, False, 1000);

  DebugMsg('WalkDispenser -> Completed, Result=' + ToStr(Result));
end;

procedure TScript.HandleMakeMenu();
var
  currentTrip: TTrip;
  barsBefore, barsAfter, barsCollected, coalUsed, oreUsed, expectedBars, batchProfit: Int32;
  barPrice, coalPrice, orePrice: Int32;
  currentSyncTripIndex, oldTrip: Int32;
begin
  if Self.UseSyncTrip then
  begin
    currentSyncTripIndex := Self.MultiSyncTrip.CurrentSyncTrip - 1;
    currentTrip.Coal := Self.MultiSyncTrip.TripCoal[currentSyncTripIndex];
    currentTrip.Ore := Self.MultiSyncTrip.TripOre[currentSyncTripIndex];
    currentTrip.ShouldCollect := Self.MultiSyncTrip.IsCollectionTrip[currentSyncTripIndex];
  end
  else
    currentTrip := Self.TripSequence[Self.CurrentTrip];
  DebugMsg('HandleMakeMenu -> Trying index 0');

  barsBefore := Self.CountItemRobust(Self.Bar);
  DebugMsg('HandleMakeMenu -> Bars in inventory before: ' + ToStr(barsBefore));

  Make.Select(0, Make.QUANTITY_ALL, True);
  expectedBars := currentTrip.Ore;

  if Self.BarType = 'Lead' then
    expectedBars := expectedBars div 2;

  DebugMsg('HandleMakeMenu -> Waiting for NEW bars to appear (timeout 7.5s)');
  WaitUntil(Self.CountItemRobust(Self.Bar) > barsBefore, 50, 7500);

  barsAfter := Self.CountItemRobust(Self.Bar);
  barsCollected := barsAfter - barsBefore;

  begin
    if barsCollected >= expectedBars then
      DebugMsg('HandleMakeMenu -> Collected expected bars (' + ToStr(barsCollected) + ')')
    else
      DebugMsg('HandleMakeMenu -> Collected ' + ToStr(barsCollected) + ' bars (expected ' + ToStr(expectedBars) + ')');
  end;

  if barsCollected > 0 then
  begin
    oreUsed := barsCollected;
    if Self.BarType = 'Lead' then
      oreUsed := barsCollected * 2;
    coalUsed := barsCollected * Self.CoalRatio;
  end
  else
  begin
    oreUsed := 0;
    coalUsed := 0;
  end;
  barPrice := Self.Prices.Bar;
  coalPrice := Self.Prices.Coal;
  orePrice := Self.Prices.Ore;
  batchProfit := (barsCollected * barPrice) - (coalUsed * coalPrice) - (oreUsed * orePrice);
  Self.TotalProfit := Self.TotalProfit + batchProfit;
  Self.totalBars := Self.totalBars + barsCollected;

  if barsCollected > 0 then
  begin
    if not Bank.IsOpen() then
    begin
      DebugMsg('HandleMakeMenu -> Opening bank to deposit bars');
      Self.WalkOpenBank();
    end;

    Bank.DepositItem(Self.Bar, True);
    Wait(100, 300);

    DebugMsg('HandleMakeMenu -> Deposited ' + ToStr(barsCollected) + ' bars into bank');
  end;

  DebugMsg('HandleMakeMenu -> BarsMade=' + ToStr(barsCollected) + ' | CoalUsed=' + ToStr(coalUsed) +
             ' | OreUsed=' + ToStr(oreUsed) + ' | TotalBars=' + ToStr(Self.TotalBars) +
             ' | Profit this batch: ' + ToStr(batchProfit) + ', Total profit: ' + ToStr(Self.TotalProfit) +
             ' | Before: LoadedCoal=' + ToStr(Self.LoadedCoal) + ', LoadedOre=' + ToStr(Self.LoadedOre) +
             ', CoalBagAmount=' + ToStr(Self.CoalBagAmount));

  Self.LoadedCoal := Self.LoadedCoal - coalUsed;
  Self.LoadedOre := Self.LoadedOre - oreUsed;

  if Self.LoadedCoal < 0 then
  begin
    DebugMsg('HandleMakeMenu -> WARNING: coalUsed (' + ToStr(coalUsed) + ') > LoadedCoal (' + ToStr(Self.LoadedCoal + coalUsed) + '), clamping to 0');
    Self.LoadedCoal := 0;
  end;

  if Self.LoadedOre < 0 then
  begin
    DebugMsg('HandleMakeMenu -> WARNING: oreUsed (' + ToStr(oreUsed) + ') > LoadedOre (' + ToStr(Self.LoadedOre + oreUsed) + '), clamping to 0');
    Self.LoadedOre := 0;
  end;

  Self.ValidateTracking();
  Self.ReceivedXPDrops := 0;

  DebugMsg('HandleMakeMenu -> XP drop counter reset');

  if Self.UseSyncTrip then
  begin
    if Self.MultiSyncTrip.IsCollectionTrip[currentSyncTripIndex] then
    begin
      if barsCollected < expectedBars then
      begin
        DebugMsg('HandleMakeMenu -> Collection trip: Only collected ' + ToStr(barsCollected) +
                   '/' + ToStr(expectedBars) + ' bars, forcing resync');
        Self.CurrentTripLoaded := False;
        Self.OutOfSync := True;
        Inc(Self.DesyncCount);
        Exit;
      end;
    end;

    DebugMsg('HandleMakeMenu -> Multi-sync trip ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip) + '/' +
               ToStr(Self.MultiSyncTrip.TotalTrips) + ' collected bars, reading pot');

    if Bank.IsOpen() then
    begin
      GameInterface.Close(True);
      WaitUntil(not Bank.IsOpen(), 50, 7500);
      Wait(200, 400);
    end;

    if Self.OpenPot() then
    begin
      Self.ReadPot();
      DebugMsg('HandleMakeMenu -> Pot verification read: LoadedCoal=' + ToStr(Self.LoadedCoal) + ', LoadedOre=' + ToStr(Self.LoadedOre));
    end
    else
      DebugMsg('HandleMakeMenu -> WARNING: Failed to open pot for verification read');

    if Self.MultiSyncTrip.CurrentSyncTrip < Self.MultiSyncTrip.TotalTrips then
    begin
      Self.MultiSyncTrip.CurrentSyncTrip := Self.MultiSyncTrip.CurrentSyncTrip + 1;
      Self.CurrentTripLoaded := False;
      Self.PotFull := False;
      DebugMsg('HandleMakeMenu -> Advancing to sync trip ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip) + '/' +
                 ToStr(Self.MultiSyncTrip.TotalTrips) + ' | TripStart remains: Coal=' + ToStr(Self.TripStartCoal) + ', Ore=' + ToStr(Self.TripStartOre));
    end
    else
    begin
      if (Self.LoadedCoal <> 0) or (Self.LoadedOre <> 0) then
      begin
        DebugMsg('HandleMakeMenu -> MULTI-SYNC NOT FULLY COMPLETE: Pot still has Coal=' +
                   ToStr(Self.LoadedCoal) + ', Ore=' + ToStr(Self.LoadedOre) + ' after all sync trips | Generating additional sync trip');
        Self.SetupMultiSyncTrips(Self.LoadedCoal, Self.LoadedOre);
        Exit;
      end;

      Self.CurrentTrip := 0;
      Self.UseSyncTrip := False;
      Self.PotFull := False;
      Self.TripStartCoal := 0;
      Self.TripStartOre := 0;
      Self.CurrentTripLoaded := False;
      Self.MultiSyncTrip.TotalTrips := 0;
      Self.MultiSyncTrip.CurrentSyncTrip := 0;

      DebugMsg('HandleMakeMenu -> !!! MULTI-SYNC COMPLETE !!! Pot verified 0/0, resuming normal Trip 1');
    end;
  end
  else
  begin
    if currentTrip.ShouldCollect then
    begin
      if barsCollected < expectedBars then
      begin
        DebugMsg('HandleMakeMenu -> Collection trip: Only collected ' + ToStr(barsCollected) + '/' + ToStr(expectedBars) + ' bars, not advancing');
        Exit;
      end;

      oldTrip := Self.CurrentTrip;
      Self.CurrentTrip := (Self.CurrentTrip + 1) mod Length(Self.TripSequence);
      Self.CurrentTripLoaded := False;
      Self.PotFull := False;
      Self.TripStartCoal := Self.LoadedCoal;
      Self.TripStartOre := Self.LoadedOre;

      DebugMsg('HandleMakeMenu -> Trip ' + ToStr(oldTrip + 1) + ' complete, advancing to trip ' + ToStr(Self.CurrentTrip + 1) +
                 ' | After: LoadedCoal=' + ToStr(Self.LoadedCoal) + ', LoadedOre=' + ToStr(Self.LoadedOre) +
                 ', CoalBagAmount=' + ToStr(Self.CoalBagAmount) + ' | TripStart updated: Coal=' + ToStr(Self.TripStartCoal) +
                 ', Ore=' + ToStr(Self.TripStartOre));
    end
    else
    begin
      Self.TripStartCoal := Self.LoadedCoal;
      Self.TripStartOre := Self.LoadedOre;
      DebugMsg('HandleMakeMenu -> Non-collecting trip, TripStart updated: Coal=' + ToStr(Self.TripStartCoal) + ', Ore=' + ToStr(Self.TripStartOre));
    end;
  end;
  Self.OutOfSync := False;
  Self.WaitingForBars := False;

  DebugMsg('HandleMakeMenu -> Finished | LoadedCoal=' + ToStr(Self.LoadedCoal) + ', LoadedOre=' + ToStr(Self.LoadedOre) + ' | OutOfSync cleared');
end;

function TScript.EquipIceGloves(): Boolean;
var
  slot: Int32;
begin
  Result := False;
  if not Inventory.FindItem(Self.IceGloves, slot) then
  begin
    DebugMsg('EquipIceGloves -> No ice gloves detected');
    Exit;
  end;
  if Inventory.ClickSlot(slot) then
  begin
    Result := WaitUntil(Inventory.Items.WaitFade(slot), 600, 6000);
    if Result then
    begin
      WaitUntil(not Inventory.ContainsItem(Self.IceGloves), 600, 2400);
      Self.HoveringBarDispenser('EquipIceGloves');
      DebugMsg('EquipIceGloves -> Successfully equipped, hovering dispenser');
    end
    else
      DebugMsg('EquipIceGloves -> Timeout while waiting for equip');
  end
  else
    DebugMsg('EquipIceGloves -> ClickSlot failed at ' + ToStr(slot));
end;

function TScript.ToggleRun(): Boolean;
begin
  Result := Minimap.EnableRun();

  if Result then
  begin
    DebugMsg('ToggleRun -> Run enabled, MinEnergy set to ' + ToStr(Self.MinEnergy));
  end
  else
    DebugMsg('ToggleRun -> Failed to enable run');
end;

function TScript.CoalBagFull(): Boolean;
begin
  Result := Self.CoalBagAmount = Self.MaxCoalBag;
  DebugMsg('CoalBagFull -> Amount=' + ToStr(Self.CoalBagAmount) + ' / Max=' + ToStr(Self.MaxCoalBag) + ' => ' + ToStr(Result));
end;

procedure TScript.RightClickCoalBag();
var
  beforeSlots, afterSlots, coalEmptied: Int32;
begin
  beforeSlots := InventoryCountEmptySlotsRobust();

  if Inventory.ClickItem(Self.CoalBag, 'Empty ') then
  begin
    DebugMsg('RightClickCoalBag -> Sent Empty command');
    Wait(1);
  end;

  if WaitUntil(beforeSlots <> (afterSlots := InventoryCountEmptySlotsRobust()), 100, 6000) then
  begin
    coalEmptied := beforeSlots - afterSlots;
    Self.CoalBagAmount := Self.CoalBagAmount - coalEmptied;
    DebugMsg('RightClickCoalBag -> Success, emptied ' + ToStr(coalEmptied) +
               ' coal, CoalBagAmount = ' + ToStr(Self.CoalBagAmount) + ', LoadedCoal = ' + ToStr(Self.LoadedCoal));
  end
  else
  begin
    Self.CoalBagAmount := 0;
    DebugMsg('RightClickCoalBag -> No change detected, reset amount to 0');
  end;
end;

function TScript.ShiftClickCoalBag(): Boolean;
var
  coalBefore, coalAfter, coalEmptied, coalRemaining: Int32;
  invSlotsBefore, stableCount, lastReading, currentReading: Int32;
  attempt, slot: Int32;
  atpa: T2DPointArray;
  conveyorBox, bottomArea: TBox;
begin
  Result := False;

  DebugMsg('ShiftClickCoalBag -> Starting coal bag empty');

  if Self.CoalBagAmount = 0 then
  begin
    DebugMsg('ShiftClickCoalBag -> WARNING: Called with CoalBagAmount=0, bag already empty!');
    Result := True;
    Exit;
  end;

  coalEmptied := 0;

  for attempt := 1 to 3 do
  begin
    stableCount := 0;
    lastReading := -1;

    while stableCount < 5 do
    begin
      Wait(20, 40);
      currentReading := Self.CountItemRobust('Coal');

      if currentReading = lastReading then
        Inc(stableCount)
      else
      begin
        stableCount := 1;
        lastReading := currentReading;
      end;
    end;

    coalBefore := lastReading;
    invSlotsBefore := InventoryCountEmptySlotsRobust();

    DebugMsg('ShiftClickCoalBag -> Attempt ' + ToStr(attempt) + ' Start | Coal=' + ToStr(coalBefore) +
               ', EmptySlots=' + ToStr(invSlotsBefore) + ', CoalBagAmount=' + ToStr(Self.CoalBagAmount));

    if Inventory.FindItem(Self.CoalBag, slot) then
    begin
      bottomArea := [0, 0, 0, 0];
      if Self.ConveyorBelt.Find(atpa) then
      begin
        conveyorBox := atpa.Merge().Bounds();
        bottomArea.X1 := conveyorBox.X1 + 4;
        bottomArea.Y1 := conveyorBox.Y1 + ((conveyorBox.Y2 - conveyorBox.Y1) div 2);
        bottomArea.X2 := conveyorBox.X2 - 4;
        bottomArea.Y2 := conveyorBox.Y2 - 4;
      end;

      Keyboard.KeyDown(VK_SHIFT);
      Inventory.MouseSlot(slot);
      Mouse.Click(MOUSE_LEFT);

      if (bottomArea.X2 > bottomArea.X1) then
        Self.ConveyorBelt.SmartHover('Put-ore-on', bottomArea)
      else
        Self.ConveyorBelt.SmartHover('Put-ore-on');

      Keyboard.KeyUp(VK_SHIFT);
    end
    else
    begin
      Inventory.ShiftDrop([Self.CoalBag], Inventory.RandomPattern());
    end;

    DebugMsg('ShiftClickCoalBag -> Attempt ' + ToStr(attempt) + ' Shift-empty action sent');

    WaitUntil(Inventory.IsFull() or (Self.CountItemRobust('Coal') > coalBefore), 50, 2000);

    stableCount := 0;
    lastReading := -1;

    while stableCount < 5 do
    begin
      Wait(20, 40);
      currentReading := Self.CountItemRobust('Coal');

      if currentReading = lastReading then
        Inc(stableCount)
      else
      begin
        stableCount := 1;
        lastReading := currentReading;
      end;
    end;

    coalAfter := lastReading;
    coalEmptied := coalAfter - coalBefore;

    if coalEmptied > 0 then
    begin
      DebugMsg('ShiftClickCoalBag -> Attempt ' + ToStr(attempt) + ' Shift Success: Emptied ' + ToStr(coalEmptied));
      Break;
    end;

    if Inventory.ClickItem(Self.CoalBag, 'Empty') then
    begin
      Wait(50, 150);
      WaitUntil(Inventory.IsFull() or (Self.CountItemRobust('Coal') > coalBefore), 50, 2000);

      stableCount := 0;
      lastReading := -1;

      while stableCount < 5 do
      begin
        Wait(20, 40);
        currentReading := Self.CountItemRobust('Coal');

        if currentReading = lastReading then
          Inc(stableCount)
        else
        begin
          stableCount := 1;
          lastReading := currentReading;
        end;
      end;

      coalAfter := lastReading;
      coalEmptied := coalAfter - coalBefore;

      if coalEmptied > 0 then
      begin
        Break;
      end;
    end;
  end;

  if coalEmptied < 0 then
    coalEmptied := 0;

  if (Self.CoalBagAmount > 0) and (coalEmptied = 0) then
  begin
    Self.CoalBagAmount := 0;
    Result := True;
    Exit;
  end;

  coalRemaining := Self.CoalBagAmount - coalEmptied;
  if coalRemaining < 0 then coalRemaining := 0;
  Self.CoalBagAmount := coalRemaining;

  Result := True;
end;

procedure TScript.HandleBagRefill();
var
  coalNeeded, bagCoal, invCoal, oreLoadedThisTrip, remainingOre, availableSlots: Int32;
  slot: Int32;
  currentTrip: TTrip;
  SafeItems: TItemArray;
begin
  DebugMsg('HandleBagRefill -> Starting coal bag refill sequence');

  SafeItems := [Self.CoalBag, Self.Coal];

  if (Inventory.Count > 1) then
  begin
    DebugMsg('HandleBagRefill -> Ensuring only safe items are in inventory...');
    Bank.DepositRandomItems(SafeItems);
    WaitUntil(Inventory.Count <= 2, 100, 2000);
  end;

  if Self.UseSyncTrip then
    currentTrip := Self.SyncTrip
  else
    currentTrip := Self.TripSequence[Self.CurrentTrip];

  coalNeeded := currentTrip.Coal - (Self.LoadedCoal - Self.TripStartCoal);
  if coalNeeded < 0 then coalNeeded := 0;

  bagCoal := 0;
  invCoal := 0;

  if Self.UseCoalBag then
  begin
    if Self.CoalBagAmount < 27 then
    begin
      bagCoal := 27 - Self.CoalBagAmount;
      invCoal := coalNeeded - bagCoal;
    end
    else
      invCoal := coalNeeded;
  end
  else
    invCoal := coalNeeded;

  availableSlots := 28 - Inventory.Count;

  if invCoal > availableSlots then
  begin
    DebugMsg('HandleBagRefill -> Clamping invCoal (' + ToStr(invCoal) + ') to available space (' + ToStr(availableSlots) + ')');
    invCoal := availableSlots;
  end;

  if invCoal < 0 then invCoal := 0;

  if (bagCoal > 0) and (Self.CoalBagAmount < 27) then
  begin
    if Inventory.FindItem(Self.CoalBag, slot) then
    begin
      Inventory.MouseSlot(slot);
      Mouse.Click(MOUSE_RIGHT);
      if WaitUntil(ChooseOption.IsOpen(), 150, 1000) then
      begin
        if ChooseOption.HasOption('Fill') then
        begin
          if ChooseOption.Select('Fill') then
          begin
            Self.CoalBagAmount := 27;
            Wait(200, 400);
          end;
        end
        else
        begin
          Self.CoalBagAmount := 27;
          Mouse.Click(MOUSE_LEFT);
        end;
      end;
    end;
  end;

  if invCoal > 0 then
  begin
    DebugMsg('HandleBagRefill -> Withdrawing ' + ToStr(invCoal) + ' coal');

    if invCoal >= availableSlots then
      Bank.WithdrawItem(Self.Coal, True)
    else
      Self.WithdrawSyncAmount(Self.Coal, invCoal);

    if not WaitUntil((Self.CountItemRobust(Self.Coal) >= invCoal) or (Inventory.IsFull()), 100, 3000) then
    begin
      DebugMsg('HandleBagRefill -> Withdrawal incomplete. Got ' + ToStr(Self.CountItemRobust(Self.Coal)));

      if Self.CountItemRobust(Self.Coal) = 0 then
      begin
         Bank.DepositItem(Self.Coal, True);
         Exit;
      end;
    end;
  end;

  oreLoadedThisTrip := Self.LoadedOre - Self.TripStartOre;
  remainingOre := currentTrip.Ore - oreLoadedThisTrip;

  if remainingOre <= 0 then
  begin
    GameInterface.Close(True);
    WaitUntil(not Bank.IsOpen(), 100, 1500);
  end;

  Self.ValidateCoalBag();
end;

function TScript.HoveringCoffer(): Boolean;
var
  cofferTile, clickPoint: TPoint;
  cofferRect: TRectangle;
  clickBounds: TBox;
  upText: String;
  offsetX, offsetY, offsetZ: Int32;
begin
  Result := False;

  cofferTile := [3688, 30602];

  offsetX := 0;
  offsetY := 0;
  offsetZ := 2;

  cofferTile.X := cofferTile.X + offsetX;
  cofferTile.Y := cofferTile.Y + offsetY;

  cofferRect := Map.Walker.GetRectMS(Map.Position(), cofferTile);

  if not MainScreen.Bounds.Contains(cofferRect.Bounds) then
  begin
    DebugMsg('HoveringCoffer -> Coffer not on screen');
    Exit;
  end;

  GameClient.Image.DrawBox(cofferRect.Bounds, $0000FF);  // Red

  clickBounds := cofferRect.Bounds.Expand(-3);

  clickBounds.Y1 := clickBounds.Y1 - offsetZ;
  clickBounds.Y2 := clickBounds.Y2 - offsetZ;

  GameClient.Image.DrawBox(clickBounds, $00FF00);  // Green

  clickPoint.X := (clickBounds.X1 + clickBounds.X2) div 2;
  clickPoint.Y := (clickBounds.Y1 + clickBounds.Y2) div 2;

  Mouse.Move(clickPoint);

  upText := MainScreen.GetUpText();
  Result := ('Use' in upText) or ('Coffer' in upText);

  DebugMsg('HoveringCoffer -> Hovered tile, Result=' + ToStr(Result));
end;

function TScript.ClickCoffer(): Boolean;
begin
  Result := False;

  if not Self.HoveringCoffer() then
  begin
    DebugMsg('ClickCoffer -> Could not hover coffer');
    Exit;
  end;

  Self.Coffer.SmartClick('Use');

  DebugMsg('ClickCoffer -> Clicked coffer');

  Self.WaitMoving(False, False, 1000);
  Result := WaitUntil('Select an' in Chat.GetChatTitle(), 100, 3000);

  DebugMsg('ClickCoffer -> Chat title check = ' + ToStr(Result));
end;

function TScript.HandleCofferChat(): Boolean;
begin
  Result := False;

  if not Chat.ClickOption('Deposit') then
  begin
    DebugMsg('HandleCofferChat -> Failed to click "Deposit" option');
    Exit;
  end;

  Result := Chat.FindQuery('Deposit how', 3000);

  DebugMsg('HandleCofferChat -> Query "Deposit how" found = ' + ToStr(Result));
end;

procedure TScript.AddMoney();
var
  invCoins, cofferBefore, cofferAfter, depositAmount: Int32;
begin
  invCoins := Inventory.CountItemStack('Coins');
  depositAmount := invCoins + 1000;

    DebugMsg('AddMoney -> Starting deposit procedure');
    DebugMsg('AddMoney -> Coins in inventory before deposit = ' + ToStr(invCoins));
    DebugMsg('AddMoney -> Intended deposit amount = ' + ToStr(depositAmount));

  if not ('Deposit how' in Chat.GetQuery()) then
  begin
    DebugMsg('AddMoney -> No "Deposit how" prompt detected');
    Exit;
  end;

  cofferBefore := Self.CountCofferMoney(0, False);
  DebugMsg('AddMoney -> Coffer before deposit = ' + ToStr(cofferBefore));

  if not Chat.AnswerQuery('Deposit how', ToStr(depositAmount), 5000) then
    begin
      DebugMsg('AddMoney -> Failed to answer deposit query');
      Exit;
    end;

  WaitUntil(not ('Deposit how' in Chat.GetQuery()), 200, 5000);
  Wait(1200);

  cofferAfter := Self.CountCofferMoney(0, False);

  if cofferAfter > cofferBefore then
  begin
    DebugMsg('AddMoney -> Deposit successful! Coffer before: ' + ToStr(cofferBefore) +
             ', after: ' + ToStr(cofferAfter) + ', diff: ' + ToStr(cofferAfter - cofferBefore));
    Self.LastCofferDepositTime := GetSystemTime();
    Self.LastCofferAmount := cofferAfter;
    Self.CofferGraceEnd := GetSystemTime() + 5000;
    Self.FilledCoffer := True;
    DebugMsg('AddMoney -> FilledCoffer1 -> ' + ToStr(Self.FilledCoffer));
    DebugMsg('AddMoney -> Deposit succeeded, coffer grace active for 5s');
  end
  else
  begin
    DebugMsg('AddMoney -> Deposit failed or amount unchanged. Coffer = ' + ToStr(cofferAfter));
    Self.FilledCoffer := True;
    DebugMsg('AddMoney -> FilledCoffer2 -> ' + ToStr(Self.FilledCoffer));
  end;

  invCoins := Inventory.CountItemStack('Coins');
  DebugMsg('AddMoney -> Coins remaining in inventory = ' + ToStr(invCoins));
end;

function TScript.GetBarDispenserPoint(): TPoint;
var
  dispenserTile: TPoint;
  dispenserRect: TRectangle;
  originalBounds, clickBounds: TBox;
  clickPoint: TPoint;
  allPoints: TPointArray;
  i: Int32;
  centerX, centerY: Int32;
begin
  Result := Point(-1, -1);

  if Bank.IsOpen() then
  begin
    DebugMsg('GetBarDispenserPoint -> Skipped (bank is open)');
    Exit;
  end;

  dispenserTile := [3664, 30578];

  dispenserRect := Map.Walker.GetRectMS(Map.Position(), dispenserTile);

  if not MainScreen.Bounds.Contains(dispenserRect.Bounds) then
  begin
    DebugMsg('GetBarDispenserPoint -> Dispenser not on screen (bounds: [' +
               ToStr(dispenserRect.Bounds.X1) + ',' + ToStr(dispenserRect.Bounds.Y1) + ',' +
               ToStr(dispenserRect.Bounds.X2) + ',' + ToStr(dispenserRect.Bounds.Y2) + '])');
    Exit;
  end;

  originalBounds := dispenserRect.Bounds;

  DebugMsg('GetBarDispenserPoint -> Dispenser bounds: [' +
             ToStr(originalBounds.X1) + ',' + ToStr(originalBounds.Y1) + ',' +
             ToStr(originalBounds.X2) + ',' + ToStr(originalBounds.Y2) + ']');

  clickBounds.X1 := originalBounds.X1 + (originalBounds.Width() div 4);
  clickBounds.X2 := originalBounds.X2 - (originalBounds.Width() div 4);
  clickBounds.Y1 := originalBounds.Y1 + (originalBounds.Height() div 3);
  clickBounds.Y2 := originalBounds.Y2 - (originalBounds.Height() div 4);

  if clickBounds.Width() < 8 then
  begin
    centerX := (originalBounds.X1 + originalBounds.X2) div 2;
    clickBounds.X1 := centerX - 4;
    clickBounds.X2 := centerX + 4;
  end;

  if clickBounds.Height() < 8 then
  begin
    centerY := (originalBounds.Y1 + originalBounds.Y2) div 2;
    clickBounds.Y1 := centerY - 4;
    clickBounds.Y2 := centerY + 4;
  end;

  DebugMsg('GetBarDispenserPoint -> Click bounds: [' +
             ToStr(clickBounds.X1) + ',' + ToStr(clickBounds.Y1) + ',' +
             ToStr(clickBounds.X2) + ',' + ToStr(clickBounds.Y2) + ']');

  SetLength(allPoints, 0);
  for i := 0 to clickBounds.Area() - 1 do
  begin
    clickPoint.X := clickBounds.X1 + (i mod clickBounds.Width());
    clickPoint.Y := clickBounds.Y1 + (i div clickBounds.Width());

    if MainScreen.Bounds.Contains(clickPoint) then
      allPoints += clickPoint;
  end;

  if Length(allPoints) = 0 then
  begin
    DebugMsg('GetBarDispenserPoint -> No valid points found, using center of bounds');
    Result.X := (originalBounds.X1 + originalBounds.X2) div 2;
    Result.Y := (originalBounds.Y1 + originalBounds.Y2) div 2;
    Exit;
  end;

  Result := allPoints.RandomMean();

  DebugMsg('GetBarDispenserPoint -> Calculated center point: [' +
             ToStr(Result.X) + ',' + ToStr(Result.Y) + '] from ' + ToStr(Length(allPoints)) + ' points');
end;

function TScript.HoveringBarDispenser(context: String): Boolean;
var
  upText: String;
begin
  Result := False;

  if Self.BarDispenser.SmartHover('Bar') then
  begin
    upText := MainScreen.GetUpText();

    DebugMsg('HoveringBarDispenser(' + context + ') -> Hover successful. UpText: "' + upText + '"');

    if 'Take' in upText then
    begin
      Result := True;
      Exit;
    end;

    if 'Check' in upText then
    begin
      Result := True;
      Exit;
    end;
  end
  else
    DebugMsg('HoveringBarDispenser(' + context + ') -> SmartHover failed to find or confirm object');
end;

function TScript.GetBars(): Boolean;
var
  beforeBars, afterBars: Int32;
  freedDetected: Boolean;
begin
  Result := False;
  Self.BarsGetAttempts += 1;
  DebugMsg('GetBars -> Attempt #' + ToStr(Self.BarsGetAttempts));

  beforeBars := Self.CountItemRobust(Self.Bar);
  freedDetected := False;

  if Self.HoveringBarDispenser('GetBars') then
  begin
    DebugMsg('GetBars -> Current UpText = "' + MainScreen.GetUpText() + '"');
    Mouse.Click(MOUSE_LEFT);
    DebugMsg('GetBars -> Clicked dispenser, waiting for result...');

    if MainScreen.DidRedClick() then
    begin
      DebugMsg('GetBars -> Red click detected, waiting for Make or Continue');
      Result := Make.IsOpen(3000, 100) or WaitUntil(Pos('free', LowerCase(Chat.GetChat())) > 0, 100, 3000);
      freedDetected := Pos('free', LowerCase(Chat.GetChat())) > 0;
    end;
  end;

  if Result then
  begin
    DebugMsg('GetBars -> Dispenser interaction result = True');

    Wait(100, 200);
    afterBars := Self.CountItemRobust(Self.Bar);

    if (afterBars > beforeBars) or freedDetected then
    begin
      Self.DispenserFull := False;
      DebugMsg('GetBars -> Bars freed successfully (' + 'Before=' + ToStr(beforeBars) +
                 ', After=' + ToStr(afterBars) + ', ChatFree=' + ToStr(freedDetected) + ')');
    end
    else
    begin
      DebugMsg('GetBars -> Bars not detected; keeping DispenserFull=True for retry');
      Self.DispenserFull := True;
    end;

    if Chat.HasContinue() then
    begin
      DebugMsg('GetBars -> Clicking through continue');
      Chat.ClickContinue();
    end;

    if Inventory.ContainsItem(Self.Bar) or Make.IsOpen() then
    begin
      DebugMsg('GetBars -> Bars in inventory or Make menu open, queuing BANK_OPEN');
      Self.NextState := EState.BANK_OPEN;
    end;

    Exit(True);
  end
  else
  begin
    DebugMsg('GetBars -> Dispenser interaction failed (No result detected)');

    if Self.BarsGetAttempts < 3 then
    begin
      DebugMsg('GetBars -> Retrying bar retrieval...');
      Wait(600 + Random(400));
      Exit(Self.GetBars());
    end
    else
    begin
      DebugMsg('GetBars -> All attempts failed, marking OutOfSync');
      Self.OutOfSync := True;
      Inc(Self.DesyncCount);
      Self.DispenserFull := True;
      Self.BarsGetAttempts := 0;
      Exit(False);
    end;
  end;
end;

function TScript.ToVariantArray(const arr: TStringArray): TVariantArray;
var
  i: Int32;
begin
  SetLength(Result, Length(arr));
  for i := 0 to High(arr) do
    Result[i] := arr[i];
end;

function TScript.WithdrawCoins(): Boolean;
var
  withdrawCoins, currentCoins, freeSlots: Int32;
begin
  Result := False;

  if Inventory.ContainsItem('Coins') then
  begin
    currentCoins := Inventory.CountItemStack('Coins');

    DebugMsg('WithdrawCoins -> Already have ' + ToStr(currentCoins) + ' coins in inventory');

    if (currentCoins >= 250000) and (currentCoins <= 300000) then
    begin
      DebugMsg('WithdrawCoins -> Coin amount in valid range, skipping withdrawal');

      if Bank.IsOpen() then
      begin
        GameInterface.Close(True);
        WaitUntil(not GameInterface.IsOpen(), 600, 3000);
      end;

      Exit(True);
    end
    else
    begin

      DebugMsg('WithdrawCoins -> Coins out of range, depositing first');

      if not Bank.IsOpen() then
      begin
        DebugMsg('WithdrawCoins -> Bank not open, cannot deposit coins');
        Exit(False);
      end;

      Bank.DepositItem('Coins', True);
      Wait(400 + Random(200));

      if Inventory.ContainsItem('Coins') then
      begin
        DebugMsg('WithdrawCoins -> Failed to deposit coins');
        Exit(False);
      end;
    end;
  end;

  freeSlots := InventoryCountEmptySlotsRobust();

  if freeSlots < 1 then
  begin
    DebugMsg('WithdrawCoins -> No inventory space, need to make room');

    if Bank.IsOpen() then
    begin
      DebugMsg('WithdrawCoins -> Depositing items to make space');

      if Inventory.ContainsItem(Self.Bar) then
        Bank.DepositItem(Self.Bar, True);

      if Inventory.ContainsItem(Self.Ore) then
        Bank.DepositItem(Self.Ore, True);

      if Inventory.ContainsItem(Self.Coal) then
        Bank.DepositItem(Self.Coal, True);

      Wait(400 + Random(200));

      freeSlots := InventoryCountEmptySlotsRobust();
      if freeSlots < 1 then
      begin
        DebugMsg('WithdrawCoins -> Still no space after depositing');
        Exit(False);
      end;
    end
    else
    begin
      DebugMsg('WithdrawCoins -> Bank not open, cannot make space');
      Exit(False);
    end;
  end;

  withdrawCoins := RandomRange(250000, 300001);

  withdrawCoins := (withdrawCoins div 1000) * 1000;

  DebugMsg('WithdrawCoins -> Withdrawing rounded amount: ' + ToStr(withdrawCoins));

  Self.CoinB.Quantity := withdrawCoins;

  if not Bank.WithdrawItem(Self.CoinB, False) then
  begin
    DebugMsg('WithdrawCoins -> FAILED: Bank.WithdrawItem call failed');
    Exit(False);
  end;

  if not WaitUntil(Inventory.ContainsItem('Coins'), 300, 3000) then
  begin
    DebugMsg('WithdrawCoins -> FAILED: Coins not detected in inventory');
    Exit(False);
  end;

  DebugMsg('WithdrawCoins -> Withdrew ' + ToStr(withdrawCoins) + ' coins');

  GameInterface.Close(True);
  WaitUntil(not GameInterface.IsOpen(), 600, 3000);

  DebugMsg('WithdrawCoins -> Bank closed, ready to deposit to coffer');

  Result := True;
end;

procedure TScript.CheckBankItems();
var
  requiredItems: array of record
    names: TItemArray;
    labelName: String;
    mandatory: Boolean;
    withdraw: Boolean;
    found: Boolean;
    foundSource: String;
  end;
  i, slot, selection: Int32;
  itemsToDeposit, itemsToCheck: TItemArray;
  staminaNames: TItemArray;
  needToEquipIceGloves: Boolean;

  procedure LogCheck(const source, labelName: String; found: Boolean; var tracker: Boolean; var src: String);
  begin
    if found then
    begin
      DebugMsg('CheckBankItems -> Found in ' + source + ': ' + labelName);
      tracker := True;
      if src = '' then
        src := source;
    end
    else
      DebugMsg('CheckBankItems -> NOT in ' + source + ': ' + labelName);
  end;

  function HasCoalBag: Boolean;
  begin
    Result := Inventory.ContainsItem(Self.CoalBag);
  end;

  function HasGoldGloves: Boolean;
  begin
    Result := Inventory.ContainsItem(Self.GoldGloves);
  end;

  function HasIceGloves: Boolean;
  begin
    Result := Inventory.ContainsItem(Self.IceGloves);
  end;

var
  cofferCoins, bankCoins, totalCoins, numRefills, avgWithdraw: Int32;
  approxHours: Double;

begin
  DebugMsg('CheckBankItems -> Starting check...');

  needToEquipIceGloves := False;
  SetLength(requiredItems, 0);
  cofferCoins := Self.CountCofferMoney();

  if Self.UseCoalBag then
    requiredItems += [[[Self.CoalBag], Self.CoalBag, True, True, False, '']];

  if Self.BarType = 'Gold' then
    requiredItems += [[[Self.GoldGloves], Self.GoldGloves, True, True, False, '']];

  requiredItems += [[[Self.IceGloves], Self.IceGloves, True, True, False, '']];
  requiredItems += [[[Self.Ore], Self.Ore, True, False, False, '']];

  if (Self.CoalRatio > 0) then
    requiredItems += [[[Self.Coal], Self.Coal, True, False, False, '']];

  if Self.UseEnergyBoosts then
  begin
    selection := GUI.Config.GetInt('staminas');
    case selection of
      1: staminaNames := STAMINA_POTIONS;
      2: staminaNames := EXT_STAMINA_POTIONS;
    end;

    if Length(staminaNames) > 0 then
      requiredItems += [[staminaNames, 'Stamina potions', False, False, False, '']];
  end;

  itemsToCheck := [Self.Ore, Self.Coal, Self.Bar, 'Copper ore', 'Tin ore', 'Iron ore', 'Silver ore', 'Gold ore',
                   'Mithril ore', 'Adamantite ore', 'Runite ore', 'Bronze bar', 'Iron bar', 'Silver bar',
                   'Steel bar', 'Gold bar', 'Mithril bar', 'Adamantite bar', 'Runite bar', 'Vial'];

  if not Self.UseCoalBag then
    itemsToCheck += [Self.CoalBag];

  if Self.BarType <> 'Gold' then
    itemsToCheck += [Self.GoldGloves];

  itemsToCheck += ['Smithing cape', 'Smithing cape(t)', 'Max cape'];

  Inventory.Open();
  for i := 0 to High(requiredItems) do
    LogCheck('inventory', requiredItems[i].labelName,
      Inventory.ContainsAny(requiredItems[i].names),
      requiredItems[i].found, requiredItems[i].foundSource);

  Equipment.Open();
  for i := 0 to High(requiredItems) do
    LogCheck('equipment', requiredItems[i].labelName,
      Equipment.ContainsAny(requiredItems[i].names),
      requiredItems[i].found, requiredItems[i].foundSource);

  DebugMsg('CheckBankItems -> Bank.IsOpen() = ' + ToStr(Bank.IsOpen()) + ', calling WalkOpenBank...');
  if not Self.WalkOpenBank() then
    begin
      DebugMsg('CheckBankItems -> Could not open bank! Are all standard bank buttons present?');
      TerminateScript();
    end;
  WaitUntil(Bank.IsOpen(), 300, 5000);
  DebugMsg('CheckBankItems -> Bank opened successfully');

  bankCoins := 0;
  if Self.AutoFillCoffer and Bank.ContainsItem(Self.CoinB) then
    bankCoins := Bank.CountItemStack(Self.Coin);

  totalCoins := cofferCoins + bankCoins;
  approxHours := totalCoins / 72000.0;
  avgWithdraw := 275000;
  numRefills := bankCoins div avgWithdraw;

  DebugMsg('Coffer: ' + ToStr(cofferCoins) + ' | Bank: ' + ToStr(bankCoins) + ' | Total: ' + ToStr(totalCoins) + ' (~' + FormatFloat('0.0', approxHours) + 'h)');

  if Inventory.ContainsAny(itemsToCheck) then
  begin
    Bank.DepositItems(itemsToCheck, True);
    Wait(400, 600);
  end;

  for i := 0 to High(requiredItems) do
  begin
    if Bank.ContainsAny(requiredItems[i].names) then
    begin
      if requiredItems[i].withdraw and (requiredItems[i].foundSource = '') then
      begin
        Bank.WithdrawItem(requiredItems[i].names[0], False);
        Wait(400, 600);

        if requiredItems[i].labelName = Self.CoalBag then
        begin
          if WaitUntil(HasCoalBag, 300, 3000) then
          begin
            if Inventory.FindItem(Self.CoalBag, slot) then
            begin
              if slot <> 0 then
                Inventory.Drag(slot, 0);

              if Self.CoalBagFull() then
                Self.CoalBagAmount := Self.CoalBagCapacity
              else
                Self.CoalBagAmount := 0;
            end;
          end;
        end;

        if requiredItems[i].labelName = Self.GoldGloves then
        begin
          if WaitUntil(HasGoldGloves, 300, 3000) then
            if Inventory.FindItem(Self.GoldGloves, slot) then
              if slot <> 1 then
                Inventory.Drag(slot, 0);
        end;

        if requiredItems[i].labelName = Self.IceGloves then
        begin
          if WaitUntil(HasIceGloves, 300, 3000) then
            needToEquipIceGloves := True;
        end;
      end;

      LogCheck('bank', requiredItems[i].labelName, True, requiredItems[i].found, requiredItems[i].foundSource);
    end
    else
      LogCheck('bank', requiredItems[i].labelName, False, requiredItems[i].found, requiredItems[i].foundSource);

    if (not requiredItems[i].found) and requiredItems[i].mandatory then
      begin
        DebugMsg('Missing required item: ' + requiredItems[i].labelName);
        TerminateScript();
      end;
  end;

  Bank.Close();
  WaitUntil(not Bank.IsOpen(), 100, 2000);

  if needToEquipIceGloves then
  begin
    Wait(200, 300);

    if Inventory.FindItem(Self.IceGloves, slot) then
    begin
      DebugMsg('CheckBankItems -> Found ' + Self.IceGloves + ' in slot ' + ToStr(slot) + ', equipping...');

      Inventory.MouseSlot(slot);
      Mouse.Click(MOUSE_RIGHT);
      WaitUntil(ChooseOption.IsOpen(), 100, 2000);
      Wait(100, 200);

      if ChooseOption.Select('Wear') then
      begin
        Wait(200, 300);
        DebugMsg('CheckBankItems -> ' + Self.IceGloves + ' equipped');
      end
      else
        DebugMsg('CheckBankItems -> Failed to select Wear option');
    end
    else
      DebugMsg('CheckBankItems -> Could not find ' + Self.IceGloves + ' in inventory');
  end;
end;

procedure TScript.HandleBarsGet(skipXPCheck: Boolean = False);
var
  upText: String;
  expectedBars, currentXP, xpGained, xpWaitAttempts, deposited, collectedBars: Int32;
  hasBars: Boolean;
  inventoryBefore: Int32;
begin
  DebugMsg('HandleBarsGet -> Starting bar collection sequence (skipXPCheck=' + ToStr(skipXPCheck) + ')');

  expectedBars := Self.LoadedOre;

  DebugMsg('HandleBarsGet -> Expected bars: ' + ToStr(expectedBars) +
             ' | Expected XP: ' + ToStr(Self.ExpectedXP));

  if (Self.BarType = 'Gold') and not skipXPCheck then
  begin
    DebugMsg('HandleBarsGet -> Waiting for XP drop to equip ice gloves');

    xpWaitAttempts := 0;
    repeat
      Inc(xpWaitAttempts);
      currentXP := Self.CheckXP();
      xpGained := currentXP - Self.XPAfterClose;

      if xpGained >= Self.ExpectedXP then
      begin
        DebugMsg('HandleBarsGet -> XP drop detected (' + ToStr(xpGained) + ' XP), swapping to ice gloves');

        if Inventory.ContainsItem(Self.IceGloves) then
        begin
          Inventory.ClickItem(Self.IceGloves);
          Wait(300, 500);
          DebugMsg('HandleBarsGet -> Ice gloves equipped');
        end;

        Break;
      end;

      if xpWaitAttempts >= 20 then
      begin
        DebugMsg('HandleBarsGet -> XP timeout (10+ seconds): only gained ' + ToStr(xpGained) +
                   ' XP (expected ' + ToStr(Self.ExpectedXP) + ') - continuing anyway');
        Break;
      end;

      Wait(500);
    until False;
  end
  else if not skipXPCheck then
  begin
    DebugMsg('HandleBarsGet -> Waiting for XP confirmation (non-gold bars)');

    xpWaitAttempts := 0;
    repeat
      Inc(xpWaitAttempts);
      currentXP := Self.CheckXP();
      xpGained := currentXP - Self.XPAfterClose;

      if xpGained >= Self.ExpectedXP then
      begin
        DebugMsg('HandleBarsGet -> XP confirmed: gained ' + ToStr(xpGained) +
                   ' XP (expected ' + ToStr(Self.ExpectedXP) + ') after ' +
                   ToStr(xpWaitAttempts) + ' attempts');
        Break;
      end;

      if xpWaitAttempts >= 20 then
      begin
        DebugMsg('HandleBarsGet -> XP timeout (10+ seconds): only gained ' + ToStr(xpGained) +
                   ' XP (expected ' + ToStr(Self.ExpectedXP) + ') - continuing anyway');
        Break;
      end;

      Wait(500);
    until False;
  end
  else
    DebugMsg('HandleBarsGet -> Skipping XP check (Init mode)');

  if not Self.HoveringBarDispenser('HandleBarsGet') then
  begin
    DebugMsg('HandleBarsGet -> No bars ready (hover did not find "Take")');
    Exit;
  end;

  inventoryBefore := Self.CountItemRobust(Self.Bar);
  upText := MainScreen.GetUpText();

  DebugMsg('HandleBarsGet -> UpText="' + upText + '"');

  if 'Take' in upText then
  begin
     DebugMsg('HandleBarsGet -> Mouse already positioned, left-clicking');
     Mouse.Click(MOUSE_LEFT);
  end
  else
  begin
     DebugMsg('HandleBarsGet -> UpText lost, falling back to SmartClick');
     if not Self.BarDispenser.SmartClick('Take') then
     begin
       DebugMsg('HandleBarsGet -> SmartClick failed');
       Exit;
     end;
  end;

  if WaitUntil(Make.IsOpen() or (Self.CountItemRobust(Self.Bar) > inventoryBefore), 50, 8000) then
  begin
    if Make.IsOpen() then
    begin
        if skipXPCheck then
        begin
          DebugMsg('HandleBarsGet -> Init: Make interface opened, collecting all bars inline');

          Make.Select(Make.GetItemButtons()[0].Index, MAKE_QUANTITY_ALL, False);
          WaitUntil(not Make.IsOpen(), 50, 3000);

          DebugMsg('HandleBarsGet -> Init: Make interface closed, counting bars');

          collectedBars := Self.CountItemRobust(Self.Bar);
          DebugMsg('HandleBarsGet -> Init: Bars in inventory: ' + ToStr(collectedBars));

          Wait(300, 500);
        end
        else
        begin
          DebugMsg('HandleBarsGet -> Make interface opened, state machine will handle via MAKE_USE');
          Exit;
        end;
    end;
  end;

  Wait(100, 200);

  if skipXPCheck then
    hasBars := Inventory.ContainsItem(Self.Bar)
  else
    hasBars := Inventory.ContainsItem(Self.Bar);

  if not hasBars then
  begin
    if skipXPCheck then
    begin
      DebugMsg('HandleBarsGet -> No bars in inventory (Init mode - expected)');
    end
    else
    begin
      DebugMsg('HandleBarsGet -> No bars in inventory - OUT OF SYNC');
      Self.OutOfSync := True;
      Inc(Self.DesyncCount);
    end;
    Exit;
  end;

  if not skipXPCheck then
  begin
    collectedBars := Self.CountItemRobust(Self.Bar);
    if collectedBars <> expectedBars then
    begin
      DebugMsg('HandleBarsGet -> Expected ' + ToStr(expectedBars) + ' bars but got ' + ToStr(collectedBars) + ' - OUT OF SYNC');
      Self.OutOfSync := True;
      Inc(Self.DesyncCount);
    end;
  end;

  DebugMsg('HandleBarsGet -> Walking to bank (single bar collection)');

  if skipXPCheck then
  begin
    collectedBars := Self.CountItemRobust(Self.Bar);
    DebugMsg('HandleBarsGet -> Init: Collected ' + ToStr(collectedBars) + ' bars');

    if collectedBars > 0 then
      Self.DepositBars();

    Self.LoadedOre := 0;
    Self.PotFull := False;
  end
  else
  begin
    deposited := Self.DepositBars();
    DebugMsg('HandleBarsGet -> Deposited ' + ToStr(deposited) + ' bars');
    Self.LoadedOre := Self.LoadedOre - deposited;
    if Self.LoadedOre < 0 then Self.LoadedOre := 0;
    DebugMsg('HandleBarsGet -> Updated pot state: LoadedOre=' + ToStr(Self.LoadedOre));

    Self.PotFull := Self.LoadedOre > 0;
  end;

  if GameInterface.IsOpen() then
  begin
    GameInterface.Close(True);
    WaitUntil(not GameInterface.IsOpen(), 50, 2000);
  end;

  DebugMsg('HandleBarsGet -> Post-bank hover check');

  if not skipXPCheck and Self.HoveringBarDispenser('HandleBarsGet-PostDeposit') then
  begin
    upText := MainScreen.GetUpText();
    if Pos('Take', upText) > 0 then
    begin
      DebugMsg('HandleBarsGet -> Additional bars ready after deposit -> queue BARS_GET');
      Self.NextState := EState.BARS_GET;
    end;
  end;

  DebugMsg('HandleBarsGet -> Finished');
end;

function TScript.GetLibraryVersion(LibraryName: String): String;
var
  ChangelogPath, Line: String;
  FileHandle, VersionStart, VersionEnd: Integer;
begin
  Result := 'Unknown';
  ChangelogPath := IncludePath + LibraryName + '/CHANGELOG.md';

  if not FileExists(ChangelogPath) then
  begin
    DebugMsg('GetLibraryVersion -> File not found: ' + ChangelogPath);
    Exit;
  end;

  FileHandle := OpenFile(ChangelogPath, False);
  if FileHandle = -1 then
  begin
    DebugMsg('GetLibraryVersion -> Failed to open file: ' + ChangelogPath);
    Exit;
  end;

  try
    if ReadFileString(FileHandle, Line, 200) then
    begin

      VersionStart := Pos('## [', Line);
      if VersionStart > 0 then
      begin
        VersionStart := VersionStart + 4;
        VersionEnd := Pos(']', Line);

        if (VersionEnd > VersionStart) then
        begin
          Result := Copy(Line, VersionStart, VersionEnd - VersionStart);
          DebugMsg('GetLibraryVersion -> Extracted version = ' + Result);
        end
        else
          DebugMsg('GetLibraryVersion -> Malformed line, missing closing bracket');
      end
      else
        DebugMsg('GetLibraryVersion -> No version header found in line');
    end
    else
      DebugMsg('GetLibraryVersion -> Failed to read line from changelog');
  finally
    CloseFile(FileHandle);
  end;
end;

function TScript.ProgReport(ResultType: Int32; ScriptName, ScriptAuthor, ScriptVersion: String;
                    VarNames: TStringArray; VarValues: TVariantArray): Variant;
var
  TSA: TStringArray;
  s, s2, s3, s4: String;
  i, i2, L: Int32;
begin
  s3 := '=';
  s4 := ' ';
  if ResultType = 2 then
    Result := '';
  if Length(VarNames) <> Length(VarValues) then
  begin
    DebugMsg('VarNames and VarValues must be the same length');
    Exit;
  end;
  SetLength(TSA, 3 + Length(VarNames) + 2);
  s2 := 'by ' + ScriptAuthor;
  TSA[0] := s3;
  TSA[1] := ScriptName.Capitalize + ' ' + ScriptVersion;
  TSA[2] := s2;
  TSA[3] := s3;
  i2 := 3 + Length(VarNames);

  for i := 4 to i2 do
    L := Max(L, Length(VarNames[i - 4]));

  for i := 4 to i2 do
  begin
    s := VarValues[i - 4];
    if (Length(s) > 1) and (s[1] = 'v') and (s[2] in ['0'..'9']) then
      TSA[i] := Padr(VarNames[i - 4].Capitalize, L) + ' : ' + s
    else
      TSA[i] := Padr(VarNames[i - 4].Capitalize, L) + ' : ' + s.Capitalize;
  end;

  TSA[i2 + 1] := s3;
  i2 := 0;

  for i := 0 to High(TSA) do
    i2 := Max(i2, Length(TSA[i]));

  TSA[0] := s3.Replicate(i2);
  TSA[3] := s3.Replicate(i2);
  TSA[High(TSA)] := s3.Replicate(i2);
  TSA[1] := s4.Replicate(Round((i2 - Length(TSA[1])) / 2)) + TSA[1];
  TSA[2] := s4.Replicate(Round((i2 - Length(TSA[2])) / 2)) + TSA[2];

  for i := 0 to High(TSA) do
  begin
    if TSA[i][1] = s3 then
      s := '[=' + Padr(TSA[i], i2) + '=]'
    else
      s := '[ ' + Padr(TSA[i], i2 - 1) + ']';
    case ResultType of
      0, 1: Writeln(s);
      2:    Result := Result + s + Chr(13);
    else
      begin
        Writeln('Invalid Result Type');
        Exit;
      end;
    end;
  end;
  if ResultType <> 2 then
    Result := True;
end;

procedure TScript.Report();
var
  SArr: TStringArray;
  VArr: TVariantArray;
begin
  Self.XpGained := Max(0, (Self.LastXPAmount - Self.StartXP));

  Self.FullRunTime := GetTimeRunning;

  Self.LoggedInTime := Self.TrueRunTime.ElapsedTime;

  Self.LoggedInHours := Self.LoggedInTime / 1000 / 60 / 60;

  if Self.LoggedInHours < 0.0001 then
    Self.LoggedInHours := 0.0001;

  SArr := ['Runtime', 'XP gained', 'Bars made', 'Profit'];
  VArr := [
    Self.FormatTimeShort(ToStr(SRL.MsToTime(Self.FullRunTime, Time_Short))),
    ToStr(Self.XpGained) + ' (' + ToStr(Round(Self.XpGained / Self.LoggedInHours)) + '/hr)',
    ToStr(Self.totalBars) + ' (' + ToStr(Round(Self.totalBars / Self.LoggedInHours)) + '/hr)',
    ToStr(Self.TotalProfit) + ' (' + ToStr(Round(Self.TotalProfit / Self.LoggedInHours)) + '/hr)'
  ];

  if Self.TakeBreaks then
  begin
    SArr += 'Until break';
    VArr += Antiban.TimeUntilBreak(Antiban.Breaks[0]);
  end;

  if Self.TakeSleeps then
  begin
    SArr += 'Until sleep';
    VArr += SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - GetTimeRunning)), TIME_BARE);
  end;

  SArr += ['SRL-T', 'WaspLib'];
  VArr += ['v' + Self.SRLTVersion, 'v' + Self.WaspLibVersion];

  if WaspClient.HasAccess({$MACRO SCRIPT_ID}, {$MACRO SCRIPT_REVISION}) then
    ProgReport(1, 'Blast Furnace', 'Baconadors', VERSION, SArr, VArr)
  else
    ProgReport(1, 'Blast Furnace', 'Baconadors.', VERSION, SArr, VArr);
end;

procedure TScript.BreakPause(Task: PBreakTask);
begin
  Self.TrueRuntime.Pause();
end;

procedure TScript.BreakResume(Task: PBreakTask);
begin
  Self.TrueRuntime.Resume();
end;

procedure TScript.SleepPause(Task: PSleepTask);
begin
  Self.TrueRunTime.Pause();
end;

procedure TScript.SleepResume(Task: PSleepTask);
begin
  if GetTimeRunning() > Self.ShutdownTime then
    begin
      DebugMsg('Max run time exceeded. Time to shutdown!');
      TerminateScript();
    end;

  Self.TrueRunTime.Resume();
end;

procedure TScript.SetupAntiban();
begin
  Antiban.Skills := [ESKILL.SMITHING, ESKILL.TOTAL];

  Antiban.AddTask(ONE_MINUTE * 15, @Antiban.HoverSkills);

  Antiban.OnStartBreak  := @BreakPause;
  Antiban.OnFinishBreak := @BreakResume;
end;

procedure TScript.PrintContinuedWarnings();
begin
  if not (Self.ContinuedWithWaspWarning or Self.ContinuedWithFixedWarning or Self.ContinuedWithSubWarning) then
    Exit;

  DebugMsg('');
  DebugMsg('===========================================');
  DebugMsg('  Script ran with the following problems:  ');
  DebugMsg('===========================================');

  if Self.ContinuedWithWaspWarning then
    DebugMsg('- Not running via Wasp Launcher');

  if Self.ContinuedWithFixedWarning then
    DebugMsg('- Not using FIXED CLASSIC screen mode');

  if Self.ContinuedWithSubWarning then
    DebugMsg('- Subscription could not be verified');

  if GUI.gpuPluginActive then
    DebugMsg('- GPU plugin is ACTIVE');

  DebugMsg('===========================================');
end;

procedure TScript.SubmitMyStats();
begin
  APICLient.UpdatePayload(Self.xpGained, Self.TotalProfit, Self.FullRunTime);
  if APIClient.Timer.IsFinished then
    begin
      APIClient.SubmitStats(APIClient.GetUUID);
      DebugMsg('SubmitMyStats -> Submitted stats.');
    end;
end;

procedure TScript.EndScript();
begin
  Login.Players[Login.PlayerIndex].Worlds := Self.originalWorlds;

  DebugMsg('EndScript -> Restoring player''s original world list');

  try
    try
      GameClient.Image.Clear;
      DebugMsg('EndScript -> GameClient image cleared');
    except
      DebugMsg('EndScript -> Failed to clear GameClient image');
    end;

    try
      Self.Report();
      DebugMsg('EndScript -> Report generated');
    except
      DebugMsg('EndScript -> Failed to generate report');
    end;

    try
      Self.PrintContinuedWarnings();
      DebugMsg('EndScript -> Printed continued warnings');
    except
      DebugMsg('EndScript -> Failed to print continued warnings');
    end;

    try
      Self.PrintAntibanSettings();
      DebugMsg('EndScript -> Printed antiban settings');
    except
      DebugMsg('EndScript -> Failed to print antiban settings');
    end;

    try
    begin
      DebugMsg('EndSript -> Submitting stats to website...');

    end;
    except
      DebugMsg('EndScript -> Failed to submit stats.');
    end;

    try
    begin
      DebugMsg('Thanks for using Baconadors'' Blast Furnace!');
      TerminateScript();
    end;
    except
      DebugMsg('EndScript -> Failed to send goodbye message');
    end;

  except
    DebugMsg('EndScript exception');
  end;
end;

procedure TScript.CheckDisplaySettings();
begin
  DebugMsg('Checking Display settings...');

  if Options.OpenTab(EOptionsTab.DISPLAY) then
  begin
    if Options.GetBrightness() < 100 then
    begin
      DebugMsg('Set max brightness');
      Options.SetMaxBrightness();
    end;
  end;
end;

procedure TScript.DrawOverlay();
var
  bottomY, topY, boxHeight, lineCount: Int32;
begin
  bottomY := 336;
  lineCount := 10; // Status, Runtime, XP, Bars, Profit, Break, Sleep, Trip, Pot Ct, Desync

  boxHeight := lineCount * 16;
  topY := bottomY - boxHeight;

  Self.DrawUIOverlay(
    Box(5, topY, 225, bottomY),
    'Blast Furnace', Self.CurrentStateText, Self.FormatTimeShort(SRL.MsToTime(GetTimeRunning(), Time_Short)),
    ToStr(Round(XpGained / LoggedInHours)), ToStr(Round(Self.totalBars / LoggedInHours)),
    ToStr(Round(Self.TotalProfit / LoggedInHours)), Self.nextBreak, Self.nextSleep,
    '', True);
end;

function TScript.ValidateSyncTrip(coal, ore: Int32): Boolean;
var
  syncTotalItems, maxCoalWithBag, maxOreWithCoal: Int32;
begin
  Result := True;

  DebugMsg('ValidateSyncTrip -> Checking if sync trip can be completed (Coal=' + ToStr(coal) + ', Ore=' + ToStr(ore) + ')');

  syncTotalItems := coal + ore;

  if Self.UseCoalBag then
  begin
    maxCoalWithBag := 54;

    if coal > 0 then
    begin
      if coal <= 27 then
        maxOreWithCoal := 27
      else if coal <= 54 then
        maxOreWithCoal := 54 - coal
      else
      begin
        Result := False;
      end;

      if Result and (ore > maxOreWithCoal) then
        Result := False;
    end
    else if ore > 27 then
    begin
      Result := False;
    end;
  end
  else
  begin
    if syncTotalItems > 27 then
      Result := False;
  end;

  if not Result then
  begin
    DebugMsg('');
    DebugMsg('========================================');
    DebugMsg('CRITICAL ERROR: Sync trip too large!');
    DebugMsg('========================================');
    DebugMsg('The pot currently has materials that require');
    DebugMsg('MORE THAN ONE TRIP to balance.');
    DebugMsg('');
    DebugMsg('Current pot state:');
    DebugMsg('  Coal: ' + ToStr(Self.LoadedCoal));
    DebugMsg('  Ore: ' + ToStr(Self.LoadedOre));
    DebugMsg('');
    DebugMsg('Sync trip needs:');
    DebugMsg('  Coal: ' + ToStr(coal));
    DebugMsg('  Ore: ' + ToStr(ore));
    if Self.UseCoalBag then
    begin
      DebugMsg('  (Max capacity with coal bag: ' + ToStr(maxCoalWithBag) + ' coal + ' + ToStr(maxOreWithCoal) + ' ore)');
    end
    else
    begin
      DebugMsg('  Total: ' + ToStr(syncTotalItems) + ' (max 27 without coal bag)');
    end;
    DebugMsg('');
    DebugMsg('ACTION REQUIRED:');
    DebugMsg('Please manually empty the pot to 0/0 by:');
    DebugMsg('1. Manually adding ore or coal to the pot');
    DebugMsg('2. Collecting any bars at the dispenser');
    DebugMsg('3. Restart the script when pot is empty');
    DebugMsg('========================================');
    DebugMsg('');
    DebugMsg('Sync trip requires multiple trips - manual pot reset needed');
    TerminateScript();
  end;

  DebugMsg('ValidateSyncTrip -> Validation passed');
end;

procedure TScript.SetupMultiSyncTrips(currentCoal, currentOre: Int32);
var
  coalNeeded, oreNeeded: Int32;
  barsToMake, tripEndCoal, tripEndOre, remainingCoal, remainingOre: Int32;
  tripCoal, tripOre, coalOverflow, barsFromLeftovers, coalShortfall: Int32;
  incompleteBarCoal, savedIncompleteCoal, savedIncompleteOre: Int32;
begin
  DebugMsg('SetupMultiSyncTrips -> Starting with pot: Coal=' + ToStr(currentCoal) +
             ', Ore=' + ToStr(currentOre));

  savedIncompleteCoal := 0;
  savedIncompleteOre := 0;

  if (currentCoal > 0) and (currentOre > 0) then
  begin
    barsToMake := Min(currentOre, currentCoal div Self.CoalRatio);
    tripEndCoal := currentCoal - (barsToMake * Self.CoalRatio);
    tripEndOre := currentOre - barsToMake;

    DebugMsg('SetupMultiSyncTrips -> Can make ' + ToStr(barsToMake) +
               ' bars | Remaining: Coal=' + ToStr(tripEndCoal) + ', Ore=' + ToStr(tripEndOre));

    if (tripEndOre > 0) or (tripEndCoal > 0) then
    begin
      if tripEndOre > 0 then
      begin
        coalShortfall := (tripEndOre * Self.CoalRatio) - tripEndCoal;
        coalNeeded := Max(0, coalShortfall);
        oreNeeded := 0;
      end
      else if tripEndCoal > 0 then
      begin
        barsFromLeftovers := tripEndCoal div Self.CoalRatio;
        incompleteBarCoal := tripEndCoal mod Self.CoalRatio;

        if barsFromLeftovers > 0 then
        begin
          oreNeeded := barsFromLeftovers;
          coalNeeded := 0;

          if incompleteBarCoal > 0 then
          begin
            savedIncompleteOre := 1;
            savedIncompleteCoal := Self.CoalRatio - incompleteBarCoal;
          end;
        end
        else
        begin
          oreNeeded := 1;
          coalShortfall := Self.CoalRatio - tripEndCoal;
          coalNeeded := coalShortfall;
        end;
      end
      else
      begin
        coalNeeded := 0;
        oreNeeded := 0;
      end;
    end
    else
    begin
      coalNeeded := 0;
      oreNeeded := 0;
    end;
  end
  else if currentOre > 0 then
  begin
    coalNeeded := currentOre * Self.CoalRatio;
    oreNeeded := 0;
  end
  else if currentCoal > 0 then
  begin
    barsFromLeftovers := currentCoal div Self.CoalRatio;
    incompleteBarCoal := currentCoal mod Self.CoalRatio;

    if barsFromLeftovers > 0 then
    begin
      oreNeeded := barsFromLeftovers;
      coalNeeded := 0;

      if incompleteBarCoal > 0 then
      begin
        savedIncompleteOre := 1;
        savedIncompleteCoal := Self.CoalRatio - incompleteBarCoal;
      end;
    end
    else
    begin
      oreNeeded := 1;
      coalNeeded := Self.CoalRatio - currentCoal;
    end;

    DebugMsg('SetupMultiSyncTrips -> Coal-only: Have ' + ToStr(currentCoal) +
               ' coal (' + ToStr(barsFromLeftovers) + ' complete bars, ' +
               ToStr(incompleteBarCoal) + ' coal toward next) | Need ' +
               ToStr(oreNeeded) + ' ore, ' + ToStr(coalNeeded) + ' coal' +
               ' | Saved for final trip: ' + ToStr(savedIncompleteOre) + ' ore, ' +
               ToStr(savedIncompleteCoal) + ' coal');
  end
  else
  begin
    coalNeeded := 0;
    oreNeeded := 0;
  end;

  if (currentCoal + coalNeeded) > 254 then
  begin
    coalOverflow := (currentCoal + coalNeeded) - 254;
    coalNeeded := coalNeeded - coalOverflow;
    barsToMake := (currentCoal + coalNeeded) div Self.CoalRatio;
    oreNeeded := Max(0, barsToMake - currentOre);

    DebugMsg('SetupMultiSyncTrips -> Coal would exceed 254, reducing to fit ' +
               ToStr(barsToMake) + ' complete bars (Coal=' + ToStr(coalNeeded) + ', Ore=' + ToStr(oreNeeded) + ')');
  end;

  DebugMsg('SetupMultiSyncTrips -> Total needed: Coal=' + ToStr(coalNeeded) + ', Ore=' + ToStr(oreNeeded));

  remainingCoal := coalNeeded;
  remainingOre := oreNeeded;
  Self.MultiSyncTrip.CurrentSyncTrip := 1;
  SetLength(Self.MultiSyncTrip.TripCoal, 0);
  SetLength(Self.MultiSyncTrip.TripOre, 0);
  SetLength(Self.MultiSyncTrip.IsCollectionTrip, 0);

  while (remainingCoal > 0) or (remainingOre > 0) do
  begin
    tripCoal := 0;
    tripOre := 0;

    if (remainingCoal + remainingOre) <= 27 then
    begin
      tripCoal := remainingCoal;
      tripOre := remainingOre;
    end
    else
    begin
      if remainingCoal > 0 then
      begin
        tripCoal := Min(remainingCoal, 27);
        tripOre := Min(remainingOre, 27 - tripCoal);
      end
      else
      begin
        tripOre := Min(remainingOre, 27);
      end;
    end;

    SetLength(Self.MultiSyncTrip.TripCoal, Length(Self.MultiSyncTrip.TripCoal) + 1);
    SetLength(Self.MultiSyncTrip.TripOre, Length(Self.MultiSyncTrip.TripOre) + 1);
    SetLength(Self.MultiSyncTrip.IsCollectionTrip, Length(Self.MultiSyncTrip.IsCollectionTrip) + 1);
    Self.MultiSyncTrip.TripCoal[High(Self.MultiSyncTrip.TripCoal)] := tripCoal;
    Self.MultiSyncTrip.TripOre[High(Self.MultiSyncTrip.TripOre)] := tripOre;
    Self.MultiSyncTrip.IsCollectionTrip[High(Self.MultiSyncTrip.IsCollectionTrip)] := False;

    remainingCoal := remainingCoal - tripCoal;
    remainingOre := remainingOre - tripOre;
  end;

  if (savedIncompleteCoal > 0) or (savedIncompleteOre > 0) then
  begin
    if Length(Self.MultiSyncTrip.TripCoal) > 0 then
    begin
      Self.MultiSyncTrip.TripCoal[High(Self.MultiSyncTrip.TripCoal)] :=
        Self.MultiSyncTrip.TripCoal[High(Self.MultiSyncTrip.TripCoal)] + savedIncompleteCoal;
      Self.MultiSyncTrip.TripOre[High(Self.MultiSyncTrip.TripOre)] :=
        Self.MultiSyncTrip.TripOre[High(Self.MultiSyncTrip.TripOre)] + savedIncompleteOre;


        DebugMsg('SetupMultiSyncTrips -> Added incomplete bar materials to trip ' +
                 ToStr(Length(Self.MultiSyncTrip.TripCoal)) + ': Coal=' +
                 ToStr(Self.MultiSyncTrip.TripCoal[High(Self.MultiSyncTrip.TripCoal)]) +
                 ', Ore=' + ToStr(Self.MultiSyncTrip.TripOre[High(Self.MultiSyncTrip.TripOre)]));
    end;
  end
  else
  begin

    if Self.GetDebugMode() and (Length(Self.MultiSyncTrip.TripCoal) > 0) then
      DebugMsg('SetupMultiSyncTrips -> Trip ' + ToStr(Length(Self.MultiSyncTrip.TripCoal)) +
               ': Coal=' + ToStr(Self.MultiSyncTrip.TripCoal[High(Self.MultiSyncTrip.TripCoal)]) +
               ', Ore=' + ToStr(Self.MultiSyncTrip.TripOre[High(Self.MultiSyncTrip.TripOre)]));
  end;

  if Length(Self.MultiSyncTrip.TripCoal) > 0 then
  begin
    Self.MultiSyncTrip.IsCollectionTrip[High(Self.MultiSyncTrip.IsCollectionTrip)] := True;
    DebugMsg('SetupMultiSyncTrips -> Final trip ' + ToStr(Length(Self.MultiSyncTrip.TripCoal)) + ' marked as collection trip');
  end
  else
  begin
    SetLength(Self.MultiSyncTrip.TripCoal, 1);
    SetLength(Self.MultiSyncTrip.TripOre, 1);
    SetLength(Self.MultiSyncTrip.IsCollectionTrip, 1);
    Self.MultiSyncTrip.TripCoal[0] := 0;
    Self.MultiSyncTrip.TripOre[0] := 0;
    Self.MultiSyncTrip.IsCollectionTrip[0] := True;
    DebugMsg('SetupMultiSyncTrips -> Trip 1: Collect existing bars only');
  end;

  Self.MultiSyncTrip.TotalTrips := Length(Self.MultiSyncTrip.TripCoal);
  Self.UseSyncTrip := True;
  Self.TripStartCoal := currentCoal;
  Self.TripStartOre := currentOre;
  Self.CurrentTripLoaded := False;

  DebugMsg('SetupMultiSyncTrips -> Complete: ' + ToStr(Self.MultiSyncTrip.TotalTrips) +
             ' trips total (NO COAL BAG)');
end;

procedure TScript.CheckVersions();
var
  SRLTVersionInt, MinSRLTInt, WaspLibVersionInt, MinWaspLibInt: Int32;
  SRLTParts, MinSRLTParts, WaspParts, MinWaspParts: TStringArray;
  HasError: Boolean;
begin
  SRLTParts := Self.SRLTVersion.Split('.');
  MinSRLTParts := Self.MinSRLT.Split('.');
  WaspParts := Self.WaspLibVersion.Split('.');
  MinWaspParts := Self.MinWaspLib.Split('.');

  SRLTVersionInt := (StrToIntDef(SRLTParts[0], 0) * 10000) + (StrToIntDef(SRLTParts[1], 0) * 100) + StrToIntDef(SRLTParts[2], 0);
  MinSRLTInt := (StrToIntDef(MinSRLTParts[0], 0) * 10000) + (StrToIntDef(MinSRLTParts[1], 0) * 100) + StrToIntDef(MinSRLTParts[2], 0);
  WaspLibVersionInt := (StrToIntDef(WaspParts[0], 0) * 10000) + (StrToIntDef(WaspParts[1], 0) * 100) + StrToIntDef(WaspParts[2], 0);
  MinWaspLibInt := (StrToIntDef(MinWaspParts[0], 0) * 10000) + (StrToIntDef(MinWaspParts[1], 0) * 100) + StrToIntDef(MinWaspParts[2], 0);

  HasError := False;

  if (SRLTVersionInt < MinSRLTInt) or (WaspLibVersionInt < MinWaspLibInt) then
  begin
    DebugMsg('');
    DebugMsg('===============================================================');
    DebugMsg('                ERROR: Library version mismatch                ');
    DebugMsg('===============================================================');

    if SRLTVersionInt < MinSRLTInt then
    begin
      DebugMsg('SRL-T version too old. Current: ' + Self.SRLTVersion + ' | Required: ' + Self.MinSRLT);
      HasError := True;
    end;

    if WaspLibVersionInt < MinWaspLibInt then
    begin
      DebugMsg('WaspLib version too old. Current: ' + Self.WaspLibVersion + ' | Required: ' + Self.MinWaspLib);
      HasError := True;
    end;

    DebugMsg('          Please update your libraries and try again.          ');
    DebugMsg('===============================================================');
    DebugMsg('');
    TerminateScript();
  end;

  DebugMsg('Version check passed - SRL-T: ' + Self.SRLTVersion + ' | WaspLib: ' + Self.WaspLibVersion);
end;

procedure TScript.PrintAntibanSettings();
var
  antibanObj, tasksObj: TJSONObject;
  cameraEnabled, mouseEnabled, chatEnabled, gametabsEnabled, bankEnabled, antibanEnabled: Boolean;
begin
  antibanObj := WLSettings.GetObject('antiban');
  tasksObj := antibanObj.getJSONObject('tasks');

  cameraEnabled := tasksObj.getBoolean('camera');
  mouseEnabled := tasksObj.getBoolean('mouse');
  chatEnabled := tasksObj.getBoolean('chat');
  gametabsEnabled := tasksObj.getBoolean('gametabs');
  bankEnabled := tasksObj.getBoolean('bank');
  antibanEnabled := tasksObj.getBoolean('enabled');

  DebugMsg('');
  DebugMsg('===========================================');
  DebugMsg('             Antiban Settings:             ');
  DebugMsg('===========================================');
  DebugMsg('Enabled:  ' + ToStr(antibanEnabled));
  DebugMsg('Camera:   ' + ToStr(cameraEnabled));
  DebugMsg('Mouse:    ' + ToStr(mouseEnabled));
  DebugMsg('Chat:     ' + ToStr(chatEnabled));
  DebugMsg('Gametabs: ' + ToStr(gametabsEnabled));
  DebugMsg('Bank:     ' + ToStr(bankEnabled));
  DebugMsg('===========================================');
end;



function TScript.NeedsEnergy(): Boolean;
begin

  Result := UseEnergyBoosts
            and (Minimap.GetRunEnergy() < Self.MinEnergy)
            and not Minimap.HasStamina();
end;

function TScript.ShouldDepositOre(): Boolean;
begin
  Result := Inventory.ContainsItem(Self.Ore);
end;

function TScript.ShouldDepositCoal(): Boolean;
begin
  Result := Inventory.ContainsItem(Self.Coal);
end;

procedure TScript.HandlePotShouldCollect();
var
  dispenserUpText: String;
  barsCollected, totalBarsCollected, roundCount: Int32;
  maxRounds, inventoryBefore, inventoryAfter: Int32;
  redClickConfirmed, makeInterfaceOpened, noBarsAvailable: Boolean;
begin
  DebugMsg('HandlePotShouldCollect -> Starting full resync procedure');

  Chat.ClickContinue(True);
  Wait(800, 1200);

  DebugMsg('HandlePotShouldCollect -> Cleared chat continue');

  DebugMsg('HandlePotShouldCollect -> Opening bank for resync cleanup');

  if not Self.WalkOpenBank() then
  begin
    DebugMsg('HandlePotShouldCollect -> Failed to open bank for cleanup');
    Exit;
  end;

  DebugMsg('HandlePotShouldCollect -> Bank open, depositing random items');

  Wait(600, 800);

  Bank.DepositRandomItems([Self.CoalBag, Self.GoldGloves, Self.IceGloves]);

  Wait(600, 800);

  DebugMsg('HandlePotShouldCollect -> Inventory cleanup complete');

  if Self.UseCoalBag then
  begin
    if Inventory.ContainsItem(Self.CoalBag) then
    begin
      DebugMsg('HandlePotShouldCollect -> Emptying coal bag');
      Self.ShiftClickCoalBag();
      WaitUntil(Inventory.IsFull(), 100, 1200);

      if Inventory.ContainsItem('Coal') then
        Bank.DepositItem('Coal', True);
    end
    else
    begin
      DebugMsg('HandlePotShouldCollect -> Coal bag not in inventory');
    end;
  end;

  GameInterface.Close(True);
  Wait(200, 400);

  DebugMsg('HandlePotShouldCollect -> Closing bank');

  totalBarsCollected := 0;
  maxRounds := 10;
  roundCount := 0;
  noBarsAvailable := False;

  repeat
    Inc(roundCount);

    DebugMsg('HandlePotShouldCollect -> Bar collection round ' + ToStr(roundCount));

    if not Self.HoveringBarDispenser('HandlePotShouldCollect') then
    begin
      DebugMsg('HandlePotShouldCollect -> Failed to hover dispenser in round ' + ToStr(roundCount));
      Break;
    end;

    dispenserUpText := MainScreen.GetUpText();

    DebugMsg('HandlePotShouldCollect -> Dispenser UpText: "' + dispenserUpText + '"');

    if ('Take' in dispenserUpText) or ('Bar dispenser' in dispenserUpText) then
    begin
      DebugMsg('HandlePotShouldCollect -> Bars ready at dispenser (round ' + ToStr(roundCount) + '), taking them');
      inventoryBefore := Self.CountItemRobust(Self.Bar);
      Mouse.Click(MOUSE_LEFT);
      Wait(100, 200);
      DebugMsg('HandlePotShouldCollect -> Clicked dispenser, waiting for response');
      redClickConfirmed := WaitUntil(not Minimap.HasFlag(), 50, 8000);

      if not redClickConfirmed then
      begin
        DebugMsg('HandlePotShouldCollect -> Red click not confirmed');
        Break;
      end;

      DebugMsg('HandlePotShouldCollect -> Red click confirmed, waiting for Make interface or Bars');

      makeInterfaceOpened := WaitUntil(Make.IsOpen() or (Self.CountItemRobust(Self.Bar) > inventoryBefore), 100, 10000);

      if makeInterfaceOpened or (Self.CountItemRobust(Self.Bar) > inventoryBefore) then
      begin
        if Make.IsOpen() then
        begin
          DebugMsg('HandlePotShouldCollect -> Make interface opened, selecting bars');
          Self.HandleMakeMenu();
        end;

        Wait(500, 800);

        inventoryAfter := Self.CountItemRobust(Self.Bar);
        barsCollected := inventoryAfter - inventoryBefore;
        totalBarsCollected := totalBarsCollected + barsCollected;

        DebugMsg('HandlePotShouldCollect -> Collected ' + ToStr(barsCollected) +
                   ' bars in round ' + ToStr(roundCount) + ' (total: ' + ToStr(totalBarsCollected) + ')');

        if (barsCollected = 0) and not Make.IsOpen() then
        begin
          DebugMsg('HandlePotShouldCollect -> No bars collected this round, stopping');
          Break;
        end;

        if Inventory.IsFull() then
        begin
          DebugMsg('HandlePotShouldCollect -> Inventory full, depositing bars');

          if Self.WalkOpenBank() then
          begin
            Bank.DepositItem(Self.Bar, True);
            WaitUntil(not Inventory.ContainsAny([Self.Bar]), 100, 2000);
            GameInterface.Close(True);
            Wait(200, 400);
            DebugMsg('HandlePotShouldCollect -> Bars deposited, checking for more bars');
          end
          else
          begin
            DebugMsg('HandlePotShouldCollect -> Failed to open bank for deposit');
            Break;
          end;
        end;
      end
      else
      begin
        DebugMsg('HandlePotShouldCollect -> Make interface did not open, checking for "free" message');
        Wait(500, 800);
        if not Self.HoveringBarDispenser('HandlePotShouldCollect') then
        begin
          DebugMsg('HandlePotShouldCollect -> Failed to hover dispenser for re-check');
          Break;
        end;

        dispenserUpText := MainScreen.GetUpText();

        if 'free' in LowerCase(dispenserUpText) then
        begin
          DebugMsg('HandlePotShouldCollect -> Dispenser shows "free", no more bars available');
          noBarsAvailable := True;
          Break;
        end
        else
        begin
          DebugMsg('HandlePotShouldCollect -> No Make interface and no "free" message, unknown state');
          Break;
        end;
      end;
    end
    else if 'free' in LowerCase(dispenserUpText) then
    begin
      DebugMsg('HandlePotShouldCollect -> Dispenser shows "free", no bars available');
      noBarsAvailable := True;
      Break;
    end
    else
    begin
      DebugMsg('HandlePotShouldCollect -> Dispenser shows "' + dispenserUpText + '", no bars ready');
      Break;
    end;
  until roundCount >= maxRounds;

  DebugMsg('HandlePotShouldCollect -> Bar collection complete after ' + ToStr(roundCount) +
             ' rounds (total bars: ' + ToStr(totalBarsCollected) + ')');

  if Inventory.ContainsItem(Self.Bar) then
  begin
    DebugMsg('HandlePotShouldCollect -> Depositing remaining ' + ToStr(Self.CountItemRobust(Self.Bar)) + ' bars');

    if Self.WalkOpenBank() then
    begin
      Bank.DepositItem(Self.Bar, True);
      Wait(400, 600);
      GameInterface.Close(True);
      Wait(200, 400);
      DebugMsg('HandlePotShouldCollect -> Bars deposited');
    end;
  end;

  DebugMsg('HandlePotShouldCollect -> Opening pot to read current state');

  if not Self.OpenPot() then
  begin
    DebugMsg('HandlePotShouldCollect -> Failed to open pot');
    Exit;
  end;

  Self.ReadPot();

  DebugMsg('HandlePotShouldCollect -> Pot read complete: LoadedCoal=' + ToStr(Self.LoadedCoal) + ', LoadedOre=' + ToStr(Self.LoadedOre));

  if (Self.LoadedCoal > 0) or (Self.LoadedOre > 0) then
  begin
    DebugMsg('HandlePotShouldCollect -> Materials in pot: Coal=' + ToStr(Self.LoadedCoal) +
               ', Ore=' + ToStr(Self.LoadedOre) + ', setting up multi-sync trips');

    Self.SetupMultiSyncTrips(Self.LoadedCoal, Self.LoadedOre);
  end
  else
  begin
    DebugMsg('HandlePotShouldCollect -> Pot is empty, exiting sync mode');
    Self.UseSyncTrip := False;
    Self.CurrentTrip := 0;
  end;

  Self.TripStartCoal := Self.LoadedCoal;
  Self.TripStartOre := Self.LoadedOre;
  Self.CurrentTripLoaded := False;
  Self.OutOfSync := False;

  DebugMsg('HandlePotShouldCollect -> Resync complete. TripStart: Coal=' +
             ToStr(Self.TripStartCoal) + ', Ore=' + ToStr(Self.TripStartOre) + ' | UseSyncTrip=' + ToStr(Self.UseSyncTrip) +
             ' | CoalBagAmount=' + ToStr(Self.CoalBagAmount) + ' | OutOfSync=' + ToStr(Self.OutOfSync));
end;

function TScript.WithdrawSyncAmount(item: String; amount: Int32): Boolean;
var
  bankItem: TBankItem;
  beforeCount, afterCount, actualWithdrawn, i, itemsLength, freeSlots: Int32;
  useLeftClick: Boolean;
begin
  Result := False;

  if amount <= 0 then
  begin
    DebugMsg('WithdrawSyncAmount -> Invalid amount: ' + ToStr(amount));
    Exit;
  end;

  itemsLength := Length(Self.BankItems);

  for i := 0 to itemsLength - 1 do
  begin
    if Self.BankItems[i].Item = item then
    begin
      bankItem := Self.BankItems[i];
      Break;
    end;
  end;

  if bankItem.Item = '' then
  begin
    DebugMsg('WithdrawSyncAmount -> Item "' + item + '" not found in BankItems array');
    Exit;
  end;

  freeSlots := InventoryCountEmptySlotsRobust();

  DebugMsg('WithdrawSyncAmount -> Withdrawing EXACTLY ' + ToStr(amount) + ' ' + item +
             ' for sync trip (FreeSlots=' + ToStr(freeSlots) + ')');

  beforeCount := Self.CountItemRobust(item);

  if not Bank.ContainsItem(bankItem) then
  begin
    DebugMsg('WithdrawSyncAmount -> ' + item + ' not found in bank');
    Exit;
  end;

  if not Bank.GetButton(EBankQuantityButton.ALL).Enabled() then
  begin
    Bank.GetButton(EBankQuantityButton.ALL).Enable();
    Wait(100, 200);
    DebugMsg('WithdrawSyncAmount -> Enabled "All" quantity button');
  end;

  useLeftClick := (amount >= freeSlots) and (amount = 27);

  if useLeftClick then
  begin
    DebugMsg('WithdrawSyncAmount -> Left-clicking to withdraw all (' + ToStr(amount) + ')');
    Bank.MouseItem(item);
    Wait(100, 200);
    Mouse.Click(MOUSE_LEFT);
    Wait(200, 300);
  end
  else
  begin
    DebugMsg('WithdrawSyncAmount -> Right-clicking for Withdraw-X with exact amount: ' + ToStr(amount));

    Bank.MouseItem(item);

    Wait(100, 200);
    Mouse.Click(MOUSE_RIGHT);
    Wait(200, 300);

    if not ChooseOption.IsOpen() then
    begin
      DebugMsg('WithdrawSyncAmount -> Right-click menu did not open');
      Exit;
    end;

    if not ChooseOption.Select('Withdraw-X') then
    begin
      DebugMsg('WithdrawSyncAmount -> Failed to select "Withdraw-X"');
      Exit;
    end;

    DebugMsg('WithdrawSyncAmount -> Selected "Withdraw-X", answering query with ' + ToStr(amount));

    Wait(600, 800);
    Keyboard.Send(ToStr(amount), VK_ENTER);

    DebugMsg('WithdrawSyncAmount -> Query answered with ' + ToStr(amount));
  end;

  if not WaitUntil(Self.CountItemRobust(item) > beforeCount, 100, 2500) then
  begin
    DebugMsg('WithdrawSyncAmount -> FAILED: Items did not appear in inventory');
    Exit;
  end;

  afterCount := Self.CountItemRobust(item);
  actualWithdrawn := afterCount - beforeCount;

  DebugMsg('WithdrawSyncAmount -> Before: ' + ToStr(beforeCount) + ', After: ' +
             ToStr(afterCount) + ', Actual withdrawn: ' + ToStr(actualWithdrawn));

  if actualWithdrawn = amount then
  begin
    Result := True;
    DebugMsg('WithdrawSyncAmount -> SUCCESS: Withdrew exactly ' + ToStr(amount) + ' ' + item);
  end
  else
  begin
    DebugMsg('WithdrawSyncAmount -> WARNING: Expected ' + ToStr(amount) + ' but got ' +
               ToStr(actualWithdrawn) + ' ' + item);
    if actualWithdrawn >= amount then
    begin
      Result := True;
      DebugMsg('WithdrawSyncAmount -> Acceptable: Got more than needed (' + ToStr(actualWithdrawn) +
                 ' >= ' + ToStr(amount) + ')');
    end
    else
    begin
      Result := False;
      DebugMsg('WithdrawSyncAmount -> FAILED: Got less than needed (' + ToStr(actualWithdrawn) +
                 ' < ' + ToStr(amount) + ')');
    end;
  end;
end;

procedure TScript.HandleSyncWithdrawal(coalNeeded, oreNeeded: Int32);
var
  coalWithdrawn, oreWithdrawn: Boolean;
begin
  DebugMsg('HandleSyncWithdrawal -> Starting sync-specific withdrawal: Coal=' + ToStr(coalNeeded) + ', Ore=' + ToStr(oreNeeded));

  if not Bank.IsOpen() then
  begin
    DebugMsg('HandleSyncWithdrawal -> Bank not open, cannot withdraw');
    Exit;
  end;

  coalWithdrawn := False;
  oreWithdrawn := False;

  if coalNeeded > 0 then
  begin
    if Self.WithdrawSyncAmount(Self.Coal, coalNeeded) then
    begin
      coalWithdrawn := True;
      Self.LoadedCoal := Self.LoadedCoal + coalNeeded;
      DebugMsg('HandleSyncWithdrawal -> Coal withdrawn successfully, LoadedCoal=' + ToStr(Self.LoadedCoal));
    end
    else
      DebugMsg('HandleSyncWithdrawal -> Coal withdrawal failed');
  end
  else
  begin
    coalWithdrawn := True;
    DebugMsg('HandleSyncWithdrawal -> No coal needed');
  end;

  if oreNeeded > 0 then
  begin
    if Self.WithdrawSyncAmount(Self.Ore, oreNeeded) then
    begin
      oreWithdrawn := True;
      Self.LoadedOre := Self.LoadedOre + oreNeeded;
      DebugMsg('HandleSyncWithdrawal -> Ore withdrawn successfully, LoadedOre=' + ToStr(Self.LoadedOre));
    end
    else
      DebugMsg('HandleSyncWithdrawal -> Ore withdrawal failed');
  end
  else
  begin
    oreWithdrawn := True;
    DebugMsg('HandleSyncWithdrawal -> No ore needed');
  end;

  if coalWithdrawn and oreWithdrawn then
  begin
    DebugMsg('HandleSyncWithdrawal -> All sync withdrawals complete');
  end
  else
  begin
    DebugMsg('HandleSyncWithdrawal -> Some withdrawals failed, triggering resync');
    Self.OutOfSync := True;
    Inc(Self.DesyncCount);
  end;
end;

function TScript.HandleOutOfSync(): Boolean;
begin
  Result := False;

  DebugMsg('HandleOutOfSync -> Starting recovery');

  if Self.HoveringBarDispenser('HandleOutOfSync') then
  begin
    if ('Take' in MainScreen.GetUpText()) then
    begin
      DebugMsg('HandleOutOfSync -> Bars detected at dispenser, collecting them first');
      Self.HandleBarsGet(True);
    end;
  end;

  if not Self.OpenPot() then
  begin
    DebugMsg('HandleOutOfSync -> Failed to open pot');
    Exit(False);
  end;

  if not Self.ReadPot() then
  begin
    DebugMsg('HandleOutOfSync -> Failed to read pot');
    Exit(False);
  end;

  DebugMsg('HandleOutOfSync -> Pot read success: Coal=' + ToStr(Self.LoadedCoal) +
             ', Ore=' + ToStr(Self.LoadedOre));

  if (Self.LoadedCoal = 0) and (Self.LoadedOre = 0) then
  begin
    DebugMsg('HandleOutOfSync -> Pot empty, resetting to Trip 1');

    Self.UseSyncTrip := False;
    Self.CurrentTrip := 0;
    Self.CurrentTripLoaded := False;
    Self.TripStartCoal := 0;
    Self.TripStartOre := 0;
    Self.PotFull := False;
  end
  else
  begin
    DebugMsg('HandleOutOfSync -> Pot contains items, setting up MultiSync trips');

    Self.SetupMultiSyncTrips(Self.LoadedCoal, Self.LoadedOre);

    Self.TripStartCoal := Self.LoadedCoal;
    Self.TripStartOre := Self.LoadedOre;
    Self.CurrentTripLoaded := False;
  end;

  Self.OutOfSync := False;
  Self.NeedsEmptyPot := False;

  Result := True;
end;

procedure TScript.ValidateTracking();
var
  maxPotCapacity: Int32;
begin
  if Self.CoalRatio > 0 then
  begin
    if Self.UseCoalBag then
      maxPotCapacity := 27 + (27 * (Self.CoalRatio + 1))
    else
      maxPotCapacity := 28 + (28 * Self.CoalRatio);
  end
  else
    maxPotCapacity := 28;

  if Self.LoadedOre > 28 then
  begin
    DebugMsg('ValidateTracking -> ERROR: LoadedOre exceeds pot capacity (' + ToStr(Self.LoadedOre) + '), forcing resync');
    Self.OutOfSync := True;
    Inc(Self.DesyncCount);
    Exit;
  end;

  if (Self.LoadedCoal + Self.LoadedOre) > maxPotCapacity then
  begin
    DebugMsg('ValidateTracking -> ERROR: Total pot contents exceed capacity (' +
               ToStr(Self.LoadedCoal + Self.LoadedOre) + '/' + ToStr(maxPotCapacity) + '), forcing resync');
    Self.OutOfSync := True;
    Inc(Self.DesyncCount);
    Exit;
  end;
end;

procedure TScript.Init(maxActions: UInt32; maxTime: UInt64); override;
var
  upText: String;
  i, j, coalBagSlot: Int32;
  shouldKeep, itemDeposited: Boolean;
  itemsToKeep: TItemArray;
  allItems: TIntegerArray;

begin
  XPBar.Read();
  ClearDebug();

  StatsPayload.Setup({$MACRO SCRIPT_ID});
  APIClient.TimeStamp := GetTickCount();

  if (not GameClient.IsLoggedIn) then
    if Login.GetPlayer.User <> '' then
      Self.LoginPlayer()
    else
    begin
      if Self.GetDebugMode then
      DebugMsg('No account loaded in account manager. Please run the ' +
               'Credentials Helper script from Wasp Launcher)')
      else
      DebugMsg('Init -> No account loaded in account manager. Please run the ' +
               'Credentials Helper script from Wasp Launcher');
      Exit;
    end;

  EnsureCompass(300, 295, 305);
  EnsureZoom(15, 12, 20);
  SettingsHandler.CheckDisplaySettings();
  Self.TrueRunTime.Start();
  Self.SRLTVersion := GetLibraryVersion('SRL-T');
  Self.WaspLibVersion := GetLibraryVersion('WaspLib');
  Self.MinSRLT := '0.1.1';
  Self.MinWaspLib := '0.1.1';

  Self.CheckVersions();

  Mouse.Speed := 40;
  Mouse.CanIdle := False;
  Mouse.MissChance := 0;
  Mouse.Gravity := 15;

  Self.NextState := EState.WAITBF;
  Self.originalWorlds := Login.Players[Login.PlayerIndex].Worlds;
  Login.Players[Login.PlayerIndex].Worlds := [355, 356, 357, 386, 494, 495, 496];


  DebugMsg('Run -> Initializing script with MaxActions=' + ToStr(maxActions) + ', MaxTime=' + ToStr(maxTime));

  DebugMsg('Init -> Variables setup complete. Current Bar = ' + Self.BarType);

  Map.SetupChunk(EChunk.BLAST_FURNACE);
  Map.Walker.ScreenWalk := True;
  Objects.Setup(Map.Objects(), @Map.Walker);

  DebugMsg('Init -> Map and Objects setup complete');

  Map.Filters := [[Box(350,360,456,444), True]];

  Self.BarDispenser := TGameObjectV2.Setup(7, [[3664, 30578]]);
  Self.BarDispenser.SetupUpText('Bar dispenser');
  Self.BarDispenser.Finder.Colors += CTS2(7434872, 9, 0.28, 0.10);
  Self.BarDispenser.Walker := @Map.Walker;
  Self.BarDispenser.TrackTarget := False;
  Self.DispenserWaitTiles := PopulateTile([3660, 30578], 0);
  Self.BankStandTile:= PopulateTile([3696, 30602], 0);

  DebugMsg('Init -> BarDispenser setup complete');

  Self.MeltingPot := Objects.Get('Melting Pot');
  Self.MeltingPot.Finder.ColorClusters += [CTS2(4365525, 15, 0.04, 1.44), CTS2(10924491, 6, 0.87, 3.66), 35];
  Self.MeltingPot.TrackTarget := False;

  DebugMsg('Init -> MeltingPot setup complete');

  Self.ConveyorBelt := Objects.Get('9100');
  Self.ConveyorBelt.Finder.Colors += CTS2(536636, 2, 0.31, 18.19);
  Self.ConveyorBelt.Finder.Colors += CTS2(737621, 6, 0.22, 4.70);
  Self.ConveyorBelt.TrackTarget := False;

  DebugMsg('Init -> ConveyorBelt setup complete');

  Self.Coffer := TGameObjectV2.Setup(0.7, 3, [[3688, 30602]]);
  Self.Coffer.SetupUpText('Coffer');
  Self.Coffer.Finder.Colors += CTS2(7040114, 5, 0.58, 0.09);
  Self.Coffer.Walker := @Map.Walker;

  DebugMsg('Init -> Coffer setup complete');

  Self.BankChest := Objects.Get('Bank chest');
  Self.BankChest.Finder.ColorClusters += [CTS2(3688540, 18, 0.04, 0.08), CTS2(7171701, 10, 0.23, 0.08), 5];

  DebugMsg('Init -> BankChest setup complete');

  Self.Foreman := TNPCV2.Setup(20, 6, [[3670, 30590]]);
  Self.Foreman.SetupUpText(['Foreman']);
  Self.Foreman.Walker := @Map.Walker;
  Self.Foreman.Finder.ColorClusters += [CTS2(7768726, 13, 0.04, 0.33), CTS2(5005161, 13, 0.04, 0.04), 5];
  Self.Foreman.Finder.ColorClusters += [CTS2(9150378, 7, 0.11, 0.66), CTS2(4741475, 6, 0.13, 0.14), 5];
  Self.Foreman.AddFilter([[3700, 30602], [3700, 30590], [3696, 30590], [3696, 30594],
                          [3688, 30594], [3664, 30590], [3664, 30598], [3668, 30598],
                          [3668, 30606], [3700, 30606]], True);

  DebugMsg('Init -> Foreman setup complete');

  DebugMsg('Init -> Objects setup complete');

  Self.SetupVariables();
  Self.SetupDTMs();

  Self.LastCofferCheck := 0;
  Self.LastCofferAmount := 0;
  Self.LastCofferDepositTime := 0;
  Self.FilledCoffer := False;
  Self.cofferAmount := 0;
  Self.BarsDeposited := 0;
  Self.HasSyncedInitially := False;
  Self.HasGloves := (Self.BarType = 'Gold') and Inventory.ContainsAny([Self.GoldGloves, Self.IceGloves]);
  Self.UIEnabled := True;
  Self.UIFontSize := 12;
  Self.UITextColor := $FFFFFF;
  Self.UIBackgroundColor := $000000;
  Self.StartXP := Self.CheckXP();
  Self.LastXPGained := Self.StartXP;
  Self.LastXPTime := GetTickCount();
  Self.BarsDeposited := 0;
  Self.SteelNeedsInitialCoal := True;
  Self.TotalProfit := 0;
  Self.TotalActions := 0;
  Self.TripStartCoal := 0;
  Self.TripStartOre := 0;
  Self.InitComplete := False;
  Self.LastPotReadTime := 0;
  Self.ConsecutivePotReads := 0;
  Self.LastStateChangeTime := GetTickCount();
  Self.WaitingForBars := False;
  Self.ContinuedWithWaspWarning := False;
  Self.ContinuedWithFixedWarning := False;
  Self.ContinuedWithSubWarning := False;
  Self.NeedsEmptyPot := False;
  Self.LoadedOre := 0;
  Self.LoadedCoal := 0;

  if not Self.ContainsCofferOverlay() then
  begin
    Self.DoWorldHop();
    DebugMsg('Init -> Hopping to a blast furnace world');
  end;

  Self.CheckBankItems();

  DebugMsg('Init -> Bank item checks complete');

  GameInterface.Close(True);
  WaitUntil(not Bank.IsOpen(), 100, 1500);

  DebugMsg('Init -> All bank operations complete, bank closed');

  Self.LastOreLoaded := 0;
  Self.PotJustOpened := False;

  if Self.AutoFillCoffer then
  begin
    cofferAmount := Self.CountCofferMoney();

    if cofferAmount > 50000 then
    begin
      DebugMsg('Init -> Coffer already has ' + ToStr(cofferAmount) + ' gp (> 50k), marking as filled');

      Self.FilledCoffer := True;
      Self.NeedsCofferFill := False;
    end
    else
    begin
      DebugMsg('Init -> Coffer has ' + ToStr(cofferAmount) + ' gp (< 50k), will need to fill');

      Self.FilledCoffer := False;
      Self.NeedsCofferFill := True;
    end;
  end
  else
  begin
    Self.FilledCoffer := True;
    Self.NeedsCofferFill := False;
  end;

  if Self.HoveringBarDispenser('Init') then
  begin
    while MainScreen.GetUpText().Contains('Take') do
    begin
      upText := MainScreen.GetUpText();

      DebugMsg('Init -> Dispenser has bars ("' + upText + '"), collecting...');

      if Inventory.ContainsItem(Self.IceGloves) then
      begin
        DebugMsg('Init -> Equipping ice gloves before collecting bars');

        Inventory.ClickItem(Self.IceGloves);
        Wait(600, 800);
      end;

      Self.DispenserFull := True;
      Self.HandleBarsGet(True);

      DebugMsg('Init -> Bars collected, returning to bank to deposit');

      if not Self.WalkOpenBank() then
        begin
          DebugMsg('Failed to open bank after initial collection');
          TerminateScript();
        end;

      WaitUntil(Bank.IsOpen(), 300, 5000);

      Bank.DepositRandomItems([Self.CoalBag, Self.GoldGloves, Self.IceGloves]);
      Wait(200, 400);

      GameInterface.Close(True);
      WaitUntil(not Bank.IsOpen(), 100, 1500);

      DebugMsg('Init -> Bank closed, re-checking dispenser for MORE bars');

      if not Self.HoveringBarDispenser('Init-Recheck') then
      begin
        DebugMsg('Init -> Could not hover dispenser on re-check, assuming empty');
        Break;
      end;

      Wait(100, 200);
    end;

    DebugMsg('Init -> Dispenser clear (No "Take" or Hover failed), reading pot');

    Self.OpenPot();
    Self.ReadPot();

    DebugMsg('Init -> Pot state after bar collection: LoadedCoal=' + ToStr(Self.LoadedCoal) +
               ', LoadedOre=' + ToStr(Self.LoadedOre));
  end
  else
  begin
    Self.OpenPot();
    Self.ReadPot();

    DebugMsg('Init -> Pot read at startup: LoadedCoal=' + ToStr(Self.LoadedCoal) +
               ', LoadedOre=' + ToStr(Self.LoadedOre));
  end;

  if (LowerCase(Self.BarType) = 'gold') and (Self.LoadedCoal <> 0) then
    begin
      DebugMsg('Coal detected in pot and you''re running gold bars. Emptying pot to prevent issues.');
      Self.OpenPot();
      Self.EmptyPot();
    end;

  if (LowerCase(Self.BarType) = 'steel') and (Self.LoadedCoal <> 0) then
    begin
      DebugMsg('Start with EXACTLY 0 coal in the pot when making steel.');
      TerminateScript();
    end;

  if (Self.LoadedCoal > 0) or (Self.LoadedOre > 0) then
  begin
    if not Self.GetUseEmpty() then
    begin
      DebugMsg('Init -> Pot has materials at startup: Coal=' + ToStr(Self.LoadedCoal) +
                 ', Ore=' + ToStr(Self.LoadedOre) + ', setting up multi-sync trips');

      Self.SetupMultiSyncTrips(Self.LoadedCoal, Self.LoadedOre);
    end;
  end;

  Self.InitComplete := True;
  AddOnTerminate(@Self.EndScript);

  DebugMsg('Init -> Script initialization complete');
end;

function TScript.GetState(): EState;
var
  bankCoins, coalInBank, oreInBank: Int32;
  currentTrip: TTrip;
  needCoal, needOre, coalLoadedThisTrip, oreLoadedThisTrip: Int32;
  coalWithdrawal: TCoalWithdrawal;
  currentCofferAmount, currentSyncTripIndex, coalConsumed, requiredPrimeCoal: Int32;
  coalBagSlot, coalBagAmountBeforeRecovery, selection: Int32;
  potions: TItemArray;
begin
  if (Self.LoadedCoal = -1) or (Self.LoadedOre = -1) then
  begin
    DebugMsg('GetState -> LoadedCoal/Ore is -1 (Invalid State) -> Setting NeedsEmptyPot');
    Self.NeedsEmptyPot := True;
    Exit(EState.EMPTY_SYNC);
  end;

  if not Bank.IsOpen() then
    Self.CheckXP();

  if (GetSystemTime() - Self.LastReportTime >= 60000) then
  begin
    Self.Report();
    Self.LastReportTime := GetSystemTime();
  end;

  DebugMsg('GetState -> Submitting stats...');
  Self.SubmitMyStats();

  if (GetTickCount() - Self.LastXPTime) > 180000 then
  begin
    DebugMsg('GetState -> No XP gained in 3 minutes , ending script -> Exit(EState.SCRIPT_END)');
    Exit(EState.SCRIPT_END);
  end;

  if Self.UseCoalBag and Bank.IsOpen() and not Inventory.ContainsItem(Self.CoalBag) then
  begin
    DebugMsg('GetState -> CRITICAL: Coal bag missing from inventory!');

    if Bank.ContainsItem(Self.CoalBag) then
    begin
      DebugMsg('GetState -> Coal bag found in bank, recovering immediately');

      if Inventory.ContainsRandomItems(Self.ItemList) then
      begin
        DebugMsg('GetState -> Depositing unwanted items before coal bag recovery');
        Bank.DepositRandomItems(Self.ItemList);
      end;

      if Inventory.ContainsItem(Self.Coal) then
        Bank.DepositItem(Self.Coal, True);
      if Inventory.ContainsItem(Self.Ore) then
        Bank.DepositItem(Self.Ore, True);
      if Inventory.ContainsItem(Self.Bar) then
        Bank.DepositItem(Self.Bar, True);

      coalBagAmountBeforeRecovery := Self.CoalBagAmount;
      Bank.WithdrawItem(Self.CoalBagB, True);

      if WaitUntil(Inventory.ContainsItem(Self.CoalBag), 100, 2000) then
      begin
        DebugMsg('GetState -> Coal bag retrieved successfully');

        if Inventory.FindItem(Self.CoalBag, coalBagSlot) then
        begin
          if coalBagSlot <> 0 then
          begin
            Inventory.Drag(coalBagSlot, 0);
            Wait(50, 100);
          end;
        end;

        Bank.OpenTab(0);
        Wait(50, 100);

        if Self.CoalBagFull() then
        begin
          Self.CoalBagAmount := Self.CoalBagCapacity;
          DebugMsg('GetState -> Coal bag is FULL, CoalBagAmount=' + ToStr(Self.CoalBagAmount));
        end
        else
        begin
          Self.CoalBagAmount := 0;
          DebugMsg('GetState -> Coal bag is EMPTY, CoalBagAmount=0');

          if coalBagAmountBeforeRecovery > 0 then
          begin
            DebugMsg('GetState -> WARNING: Coal bag tracked as ' + ToStr(coalBagAmountBeforeRecovery) +
                       ' coal but actually empty! Triggering resync');
            Self.OutOfSync := True;
            Inc(Self.DesyncCount);
          end;
        end;

        Self.ValidateCoalBag();
      end
      else
      begin
        DebugMsg('GetState -> CRITICAL: Failed to retrieve coal bag!');
        Exit(EState.SCRIPT_END);
      end;
    end
    else
    begin
      DebugMsg('GetState -> CRITICAL: Coal bag missing entirely! Cannot continue');
      Exit(EState.SCRIPT_END);
    end;
  end;

  if Self.AutoFillCoffer and Self.ContainsCofferOverlay() then
  begin
    if (GetSystemTime() - Self.LastCofferCheck) > 30000 then
    begin
      currentCofferAmount := Self.CountCofferMoney();
      DebugMsg('GetState -> Coffer check: ' + ToStr(currentCofferAmount) + ' gp');
      if currentCofferAmount < 50000 then
      begin
        DebugMsg('GetState -> Coffer below 50k (' + ToStr(currentCofferAmount) + ' gp), need to refill');
        Self.FilledCoffer := False;
        Self.NeedsCofferFill := True;
      end;
    end;
  end;

  EnsureCompass(300, 295, 305);
  EnsureZoom(15, 12, 20);
  GameClient.Image.Clear;

  if (GUI.Config.GetInt('staminas') > 0) then
  begin
    selection := GUI.Config.GetInt('staminas');
    case selection of
      1: potions := STAMINA_POTIONS;
      2: potions := EXT_STAMINA_POTIONS;
      else potions := [];
    end;

    if not Minimap.HasStamina()
       and (Minimap.GetRunEnergy() <= Self.MinEnergy)
       and Inventory.ContainsAny(potions) then
    begin
      DebugMsg('GetState -> Drink stamina potion -> Exit(EState.ENERGY_USE)');
      Exit(EState.ENERGY_USE);
    end;

    if Bank.IsOpen()
       and not Minimap.HasStamina()
       and (Minimap.GetRunEnergy() <= Self.MinEnergy)
       and not Inventory.ContainsAny(potions)
       and not Inventory.IsFull() then
    begin
      if Bank.ContainsAny(potions) then
      begin
        DebugMsg('GetState -> Withdraw stamina potion -> Exit(EState.ENERGY_USE)');
        Exit(EState.ENERGY_USE);
      end
      else
      begin
        DebugMsg('GetState -> Out of stamina potions, disabling energy boosts');
        Self.UseEnergyBoosts := False;
      end;
    end;
  end;

  if (Minimap.GetRunEnergy() >= Self.MinEnergy) and not Minimap.IsRunEnabled() then
  begin
    DebugMsg('GetState -> Enable run (energy >= ' + ToStr(Self.MinEnergy) + ') -> Exit(EState.RUN_ON)');
    Exit(EState.RUN_ON);
  end;


  begin
    if Self.UseSyncTrip then
      DebugMsg('GetState -> ** MULTI-SYNC TRIP ACTIVE ** Trip ' +
               ToStr(Self.MultiSyncTrip.CurrentSyncTrip) + '/' + ToStr(Self.MultiSyncTrip.TotalTrips))
    else
      DebugMsg('GetState -> Normal operation, CurrentTrip=' + ToStr(Self.CurrentTrip + 1) +
               '/' + ToStr(Length(Self.TripSequence)));
  end;

  if Self.UseSyncTrip and (Self.LoadedCoal = 0) and (Self.LoadedOre = 0) and
     (Self.MultiSyncTrip.CurrentSyncTrip >= Self.MultiSyncTrip.TotalTrips) then
  begin
    DebugMsg('GetState -> Sync complete: pot empty on last trip (' +
               ToStr(Self.MultiSyncTrip.CurrentSyncTrip) + '/' + ToStr(Self.MultiSyncTrip.TotalTrips) + '), exiting sync mode');
    Self.UseSyncTrip := False;
    Self.CurrentTrip := 0;
    Self.CurrentTripLoaded := False;
    Self.TripStartCoal := 0;
    Self.TripStartOre := 0;
    Self.PotFull := False;
    DebugMsg('GetState -> Switched to normal mode, starting trip 1 | TripStart: Coal=0, Ore=0');
    Exit(EState.BANK_OPEN);
  end;

  if Self.UseSyncTrip then
  begin
    currentSyncTripIndex := Self.MultiSyncTrip.CurrentSyncTrip - 1;
    currentTrip.Coal := Self.MultiSyncTrip.TripCoal[currentSyncTripIndex];
    currentTrip.Ore := Self.MultiSyncTrip.TripOre[currentSyncTripIndex];
    currentTrip.ShouldCollect := Self.MultiSyncTrip.IsCollectionTrip[currentSyncTripIndex];
  end
  else
    currentTrip := Self.TripSequence[Self.CurrentTrip];

  if Self.CurrentTripLoaded and (GetTickCount() - Self.LastStateChangeTime > 300000) then
  begin
    DebugMsg('GetState -> Trip loaded but idle for 5+ min (likely after break/disconnect), verifying pot state');
    Self.CurrentTripLoaded := False;
    Exit(EState.POT_OPEN);
  end;

  if not Self.OutOfSync and not Self.UseSyncTrip and not Self.CurrentTripLoaded then
  begin
    if (Self.LoadedCoal > 0) or (Self.LoadedOre > 0) then
    begin
      if (Self.CurrentTrip = 0) and (Self.TripStartCoal = 0) and (Self.TripStartOre = 0) then
      begin
        if Bank.IsOpen() then
        begin
          if (LowerCase(Self.BarType) = 'steel') and (Self.LoadedCoal = 27) and (Self.LoadedOre = 0) then
          begin
            DebugMsg('GetState -> Steel Trip 1: Pre-loaded coal detected (27 coal, 0 ore) - this is expected, not a desync');
          end
          else if (Self.LoadedCoal <> currentTrip.Coal) or (Self.LoadedOre <> currentTrip.Ore) then
          begin
            DebugMsg('GetState -> CRITICAL: Starting Trip 1 but pot state incorrect! Expected Coal=' +
                       ToStr(currentTrip.Coal) + ', Ore=' + ToStr(currentTrip.Ore) +
                       ' | Actual Coal=' + ToStr(Self.LoadedCoal) + ', Ore=' + ToStr(Self.LoadedOre) + ' | Forcing resync');
            Self.OutOfSync := True;
            Inc(Self.DesyncCount);
            GameInterface.Close(True);
            WaitUntil(not Bank.IsOpen(), 100, 2000);
            if 'Ore' in Chat.GetChat() then
            begin
              DebugMsg('GetState -> Pot already open, reading directly');
              Exit(EState.POT_READ);
            end
            else
            begin
              DebugMsg('GetState -> Opening pot to check contents');
              Exit(EState.POT_OPEN);
            end;
          end;
        end;
      end;
    end;
  end;

  if ChooseOption.IsOpen() then
  begin
    DebugMsg('GetState -> ChooseOption is open -> Exit(EState.MENU_CLOSE)');
    Exit(EState.MENU_CLOSE);
  end;

  if Self.GaugeMenuOpen() then
  begin
    DebugMsg('GetState -> Gauge menu is open -> Exit(EState.GAUGE_CLOSE)');
    Exit(EState.GAUGE_CLOSE);
  end;

  if Chat.HasContinue() then
  begin
    if 'permission' in LowerCase(Chat.GetChat()) then
    begin
      DebugMsg('GetState -> Foreman needs payment (permission detected) -> Exit(EState.PAY_FOREMAN)');
      Exit(EState.PAY_FOREMAN);
    end;

    if 'should collect your bars' in LowerCase(Chat.GetChat()) then
    begin
      DebugMsg('GetState -> Pot says we should collect -> Triggering full resync');
      Self.HandlePotShouldCollect();
      Exit(EState.BANK_OPEN);
    end;

    if 'ore smelts' in LowerCase(Chat.GetChat()) then
    begin
      DebugMsg('GetState -> Pot warning detected ("ore smelts"), triggering resync');

      if Inventory.ContainsItem(Self.Ore) then
      begin
        DebugMsg('GetState -> Have ore in inventory, need to deposit before resync -> Exit(EState.BANK_OPEN)');
        Self.ReSyncPot();
        Exit(EState.BANK_OPEN);
      end;
      if Inventory.ContainsItem(Self.Coal) then
      begin
        DebugMsg('GetState -> Have coal in inventory, need to deposit before resync -> Exit(EState.BANK_OPEN)');
        Self.ReSyncPot();
        Exit(EState.BANK_OPEN);
      end;

      Chat.ClickContinue(True);
      Self.ReSyncPot();
      DebugMsg('GetState -> Resync complete, opening pot -> Exit(EState.POT_OPEN)');
      Exit(EState.POT_OPEN);
    end;

    if not ('coal bag' in LowerCase(Chat.GetChat())) then
    begin
      DebugMsg('GetState -> Generic continue in chat -> Exit(EState.CHAT_NEXT)');
      Exit(EState.CHAT_NEXT);
    end;
  end;

  if Inventory.ContainsItem('Coins') and not ('Select an' in Chat.GetChatTitle()) and not ('Deposit how' in Chat.GetQuery()) then
  begin
    DebugMsg('GetState -> Coins in inventory and ready to use -> Exit(EState.COFFER_USE)');
    Exit(EState.COFFER_USE);
  end;

  if GameInterface.IsOpen() then
  begin
    if Bank.IsOpen() or BankPin.IsOpen() then
    begin
      if Self.AutoFillCoffer then
      begin
        bankCoins := 0;

        if Bank.ContainsItem(Self.CoinB) then
          bankCoins := Bank.CountItemStack(Self.Coin);

        if (bankCoins < 50000) and (currentCofferAmount < 50000) then
        begin
          DebugMsg('GetState -> Bank has insufficient coins (' + ToStr(bankCoins) + ' < 50k) AND coffer low (' + ToStr(currentCofferAmount) + ' < 50k) -> Exit(EState.MONEY_OUT)');
          Exit(EState.MONEY_OUT);
        end;
      end;

      if Inventory.ContainsItem(Self.Bar) then
      begin
        DebugMsg('GetState -> Deposit bars -> Exit(EState.BARS_PUT)');
        Exit(EState.BARS_PUT);
      end;

      if Self.NeedsCofferFill and (InventoryCountEmptySlotsRobust() >= 1) and Self.AutoFillCoffer and not Self.FilledCoffer then
      begin
        DebugMsg('GetState -> NeedsCofferFill=True, withdrawing coins -> Exit(EState.COINS_GET)');
        Self.NeedsCofferFill := False;
        Exit(EState.COINS_GET);
      end;

      if Self.OutOfSync then
      begin
        if Inventory.ContainsItem(Self.Ore) then
        begin
          DebugMsg('GetState -> Deposit ore (out of sync recovery) -> Exit(EState.ORE_PUT)');
          Exit(EState.ORE_PUT);
        end;
        if Inventory.ContainsItem(Self.Coal) then
        begin
          DebugMsg('GetState -> Deposit coal (out of sync recovery) -> Exit(EState.COAL_PUT)');
          Exit(EState.COAL_PUT);
        end;
        DebugMsg('GetState -> Out of sync, closing bank to read pot -> Exit(EState.BANK_CLOSE)');
        Exit(EState.BANK_CLOSE);
      end;

      if Inventory.ContainsRandomItems(Self.ItemList) then
      begin
        DebugMsg('GetState -> Random items present from ItemList -> Exit(EState.ITEMS_PUT)');
        Exit(EState.ITEMS_PUT);
      end;

      if Self.SteelNeedsInitialCoal and (LowerCase(Self.BarType) = 'steel') and
         not Self.UseSyncTrip then
      begin
        requiredPrimeCoal := 27;

        if not Self.UseCoalBag then
          requiredPrimeCoal := 28;

        if Self.LoadedCoal < requiredPrimeCoal then
        begin
          DebugMsg('GetState -> Steel: Need to pre-load ' + ToStr(requiredPrimeCoal) + ' coal before first ore (CoalBag=' + ToStr(Self.UseCoalBag) + ')');

          if not Inventory.ContainsItem(Self.Coal) then
          begin
            Self.CoalToWithdraw := requiredPrimeCoal;
            DebugMsg('GetState -> Withdraw ' + ToStr(requiredPrimeCoal) + ' coal for steel pre-load');
            Exit(EState.COAL_GET);
          end;

          DebugMsg('GetState -> Coal withdrawn for steel pre-load, closing bank');
          Exit(EState.BANK_CLOSE);
        end
        else
        begin
          Self.SteelNeedsInitialCoal := False;
          Self.TripStartCoal := Self.LoadedCoal;
          Self.TripStartOre := 0;
          DebugMsg('GetState -> Steel: Initial ' + ToStr(requiredPrimeCoal) +
                     ' coal loaded (CoalBag=' + ToStr(Self.UseCoalBag) +
                     '), proceeding with normal trips | TripStart updated');
        end;
      end;

      if not Self.CurrentTripLoaded then
      begin
        coalLoadedThisTrip := Self.LoadedCoal - Self.TripStartCoal;
        oreLoadedThisTrip := Self.LoadedOre - Self.TripStartOre;
        needCoal := currentTrip.Coal - coalLoadedThisTrip;
        needOre := currentTrip.Ore - oreLoadedThisTrip;
        if needCoal < 0 then needCoal := 0;
        if needOre < 0 then needOre := 0;

        if needCoal > 0 then
        begin
          coalInBank := 0;
          if Bank.ContainsItem(Self.Coal) then
            coalInBank := Bank.CountItemStack(Self.Coal);

          if (coalInBank + Inventory.CountItem(Self.Coal)) < 27 then
          begin
            DebugMsg('GetState -> CRITICAL: Total Coal (Bank=' + ToStr(coalInBank) +
                       ' + Inv=' + ToStr(Inventory.CountItem(Self.Coal)) + ') < 27 -> Exit(EState.COAL_OUT)');
            Exit(EState.COAL_OUT);
          end;
        end;

        if needOre > 0 then
        begin
          oreInBank := 0;
          if Bank.ContainsItem(Self.Ore) then
            oreInBank := Bank.CountItemStack(Self.Ore);

          if (oreInBank + Inventory.CountItem(Self.Ore)) < 27 then
          begin
            DebugMsg('GetState -> CRITICAL: Total Ore (Bank=' + ToStr(oreInBank) +
                       ' + Inv=' + ToStr(Inventory.CountItem(Self.Ore)) + ') < 27 -> Exit(EState.ORE_OUT)');
            Exit(EState.ORE_OUT);
          end;
        end;
      end
      else
      begin
        needCoal := 0;
        needOre := 0;
      end;


      begin
        if Self.UseSyncTrip then
          DebugMsg('GetState -> MULTI-SYNC TRIP ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip) +
                   '/' + ToStr(Self.MultiSyncTrip.TotalTrips) + ': Need ' + ToStr(needCoal) + ' more coal, ' +
                   ToStr(needOre) + ' more ore (trip total: ' + ToStr(currentTrip.Coal) + ' coal, ' + ToStr(currentTrip.Ore) + ' ore) | TripStart: Coal=' +
                   ToStr(Self.TripStartCoal) + ', Ore=' + ToStr(Self.TripStartOre) + ' | CurrentTripLoaded=' + ToStr(Self.CurrentTripLoaded))
        else
          DebugMsg('GetState -> Trip ' + ToStr(Self.CurrentTrip + 1) + '/' +
                   ToStr(Length(Self.TripSequence)) + ': Need ' + ToStr(needCoal) + ' more coal, ' + ToStr(needOre) + ' more ore (trip total: ' +
                   ToStr(currentTrip.Coal) + ' coal, ' + ToStr(currentTrip.Ore) + ' ore) | TripStart: Coal=' + ToStr(Self.TripStartCoal) + ', Ore=' +
                   ToStr(Self.TripStartOre) + ' | CurrentTripLoaded=' + ToStr(Self.CurrentTripLoaded));
      end;

      if (LowerCase(Self.BarType) = 'cupronickel') and (needOre > 0) and (needCoal > 0) and not Self.UseSyncTrip then
      begin
        DebugMsg('GetState -> CUPRONICKEL: Special withdrawal order - nickel first, then copper');

        if not Inventory.ContainsItem(Self.Ore) then
        begin
          Self.OreToWithdraw := needOre;
          DebugMsg('GetState -> CUPRONICKEL: Withdraw ' + ToStr(needOre) + ' nickel FIRST (right-click) -> Exit(EState.ORE_GET)');
          Exit(EState.ORE_GET);
        end;

        if not Inventory.ContainsItem(Self.Coal) then
        begin
          Self.CoalToWithdraw := needCoal;
          DebugMsg('GetState -> CUPRONICKEL: Withdraw ' + ToStr(Self.CoalToWithdraw) + ' copper (Withdraw-X) -> Exit(EState.COAL_GET)');
          Exit(EState.COAL_GET);
        end;

        DebugMsg('GetState -> CUPRONICKEL: Both nickel and copper ready, closing bank -> Exit(EState.BANK_CLOSE)');
        Exit(EState.BANK_CLOSE);
      end;

      if needCoal > 0 then
      begin
        if Self.UseSyncTrip then
        begin
          DebugMsg('GetState -> MULTI-SYNC TRIP ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip) +
                     '/' + ToStr(Self.MultiSyncTrip.TotalTrips) + ' Coal withdrawal: need ' + ToStr(needCoal) + ' coal (NO BAG)');
          if not Inventory.ContainsItem(Self.Coal) then
          begin
            Self.CoalToWithdraw := needCoal;
            DebugMsg('GetState -> Withdrawing ' + ToStr(needCoal) + ' coal to inventory -> Exit(EState.COAL_GET)');
            Exit(EState.COAL_GET);
          end;
          DebugMsg('GetState -> Coal withdrawn, checking if ore also needed');
        end
        else
        begin
          coalWithdrawal := Self.CalculateCoalWithdrawal(needCoal);
          DebugMsg('GetState -> Coal phase for trip ' + ToStr(Self.CurrentTrip + 1) +
                     ', need ' + ToStr(needCoal) + ' more coal, bag=' + ToStr(coalWithdrawal.BagCoal) + ', inv=' + ToStr(coalWithdrawal.InventoryCoal));
          if Self.UseCoalBag and (coalWithdrawal.BagCoal > 0) and not Self.CoalBagFull() then
          begin
            DebugMsg('GetState -> Filling coal bag -> Exit(EState.BAG_REFILL)');
            Exit(EState.BAG_REFILL);
          end;
          if (coalWithdrawal.InventoryCoal > 0) and not Inventory.ContainsItem(Self.Coal) then
          begin
            Self.CoalToWithdraw := coalWithdrawal.InventoryCoal;
            DebugMsg('GetState -> Withdrawing ' + ToStr(coalWithdrawal.InventoryCoal) + ' coal to inventory -> Exit(EState.COAL_GET)');
            Exit(EState.COAL_GET);
          end;
          if Self.UseCoalBag then
          begin
            if (coalWithdrawal.BagCoal > 0) and Self.CoalBagFull() and
               ((coalWithdrawal.InventoryCoal = 0) or Inventory.ContainsItem(Self.Coal)) then
            begin
              if (needOre = 0) then
              begin
                DebugMsg('GetState -> Coal requirements met, closing bank -> Exit(EState.BANK_CLOSE)');
                Exit(EState.BANK_CLOSE);
              end;
            end;
            if (coalWithdrawal.BagCoal = 0) and Inventory.ContainsItem(Self.Coal) then
            begin
              if (needOre = 0) then
              begin
                DebugMsg('GetState -> Coal withdrawn (no bag needed), closing bank -> Exit(EState.BANK_CLOSE)');
                Exit(EState.BANK_CLOSE);
              end;
            end;
          end
          else
          begin
            if Inventory.ContainsItem(Self.Coal) then
            begin
              if (needOre = 0) then
              begin
                DebugMsg('GetState -> Coal withdrawn (no bag), closing bank -> Exit(EState.BANK_CLOSE)');
                Exit(EState.BANK_CLOSE);
              end;
            end
            else
            begin
              DebugMsg('GetState -> Still need to withdraw coal -> Exit(EState.COAL_GET)');
              Self.CoalToWithdraw := needCoal;
              Exit(EState.COAL_GET);
            end;
          end;
        end;
      end;

      if (needOre > 0) then
      begin

        begin
          if Self.UseSyncTrip then
            DebugMsg('GetState -> Ore phase for MULTI-SYNC TRIP ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip) + '/' + ToStr(Self.MultiSyncTrip.TotalTrips))
          else
            DebugMsg('GetState -> Ore phase for trip ' + ToStr(Self.CurrentTrip + 1));
        end;

        if (currentTrip.Coal > 0) and Self.UseCoalBag and not Self.UseSyncTrip then
        begin
          if not Self.CoalBagFull() then
          begin
            DebugMsg('GetState -> Filling coal bag before withdrawing ore -> Exit(EState.BAG_REFILL)');
            Exit(EState.BAG_REFILL);
          end;
        end;

        if Inventory.ContainsItem(Self.Coal) then
        begin
          DebugMsg('GetState -> Coal in inventory, must load before ore withdrawal -> Exit(EState.BANK_CLOSE)');
          Exit(EState.BANK_CLOSE);
        end;

        if not Inventory.ContainsItem(Self.Ore) then
        begin
          Self.OreToWithdraw := needOre;
          DebugMsg('GetState -> Withdraw ' + ToStr(needOre) + ' ore -> Exit(EState.ORE_GET)');
          Exit(EState.ORE_GET);
        end;

        DebugMsg('GetState -> Ore (and coal bag if needed) ready, closing bank -> Exit(EState.BANK_CLOSE)');
        Exit(EState.BANK_CLOSE);
      end;

      if not Self.CurrentTripLoaded then
        Self.CurrentTripLoaded := True;

      DebugMsg('GetState -> All materials ready or already loaded, closing bank -> Exit(EState.BANK_CLOSE)');
      Exit(EState.BANK_CLOSE);
    end;

    if CollectBox.IsOpen() then
    begin
      DebugMsg('GetState -> Collect box open -> Exit(EState.COLLECT_USE)');
      Exit(EState.COLLECT_USE);
    end;

    DebugMsg('GetState -> UI is open but not bank/collect -> Exit(EState.UI_CLOSE)');
    Exit(EState.UI_CLOSE);
  end;

  if ('Select an' in Chat.GetChatTitle()) and ('Cancel' in Chat.GetChat()) then
  begin
    DebugMsg('GetState -> Coffer dialogue active -> Exit(EState.COFFER_TALK)');
    Exit(EState.COFFER_TALK);
  end;

  if 'Deposit how' in Chat.GetQuery() then
  begin
    DebugMsg('GetState -> "Deposit how" query active -> Exit(EState.MONEY_ADD)');
    Exit(EState.MONEY_ADD);
  end;

  if Make.IsOpen() then
  begin
    DebugMsg('GetState -> Make interface open -> Exit(EState.MAKE_USE)');
    Exit(EState.MAKE_USE);
  end;

  if Chat.LeveledUp() then
  begin
    DebugMsg('GetState -> Level-up message present -> Exit(EState.LEVEL_MSG)');
    Exit(EState.LEVEL_MSG);
  end;

  if Self.OutOfSync then
  begin
    DebugMsg('GetState -> Out of sync detected with clean state, running full resync');
    if Self.HandleOutOfSync() then
    begin
      DebugMsg('GetState -> Resync successful, continuing with fresh state');
    end
    else
    begin
      DebugMsg('GetState -> Resync failed, will retry next cycle');
    end;
  end;

  if Inventory.ContainsItem(Self.Bar) and not GameInterface.IsOpen() then
  begin
    if (GetTickCount() - Self.LastPotReadTime) < 3000 then
    begin
      DebugMsg('GetState -> Have bars but synced <3s ago, going to bank -> Exit(EState.BANK_OPEN)');
      Self.ConsecutivePotReads := 0;
      Exit(EState.BANK_OPEN);
    end;

    if Self.UseSyncTrip then
    begin
      DebugMsg('GetState -> Multi-Sync: Bars detected, forcing BANKING');
      Exit(EState.BANK_OPEN);
    end;

    if Self.ConsecutivePotReads >= 3 then
    begin
      DebugMsg('GetState -> Have bars but read pot ' + ToStr(Self.ConsecutivePotReads) + 'x, forcing bank -> Exit(EState.BANK_OPEN)');
      Self.ConsecutivePotReads := 0;
      Exit(EState.BANK_OPEN);
    end;
  end;

  if Inventory.ContainsItem(Self.Ore) then
  begin
    DebugMsg('GetState -> Ore present in inventory -> Exit(EState.ORE_LOAD)');
    Exit(EState.ORE_LOAD);
  end;

  if Inventory.ContainsItem(Self.Coal) then
  begin
    DebugMsg('GetState -> Coal present in inventory -> Exit(EState.COAL_LOAD)');
    Exit(EState.COAL_LOAD);
  end;

  if Self.UseCoalBag and not Self.UseSyncTrip and (Self.CoalBagAmount > 0) and
     (Self.LoadedOre > Self.TripStartOre) and not Self.WaitingForBars then
  begin
    DebugMsg('GetState -> Empty coal bag after loading inventory coal/ore -> Exit(EState.BAG_EMPTY)');
    Exit(EState.BAG_EMPTY);
  end;

  if Self.CurrentTripLoaded then
  begin
    if currentTrip.ShouldCollect then
    begin
      if Inventory.ContainsItem(Self.Bar) then
      begin
        DebugMsg('GetState -> Collection trip loaded but holding bars -> Exit(EState.BANK_OPEN)');
        Exit(EState.BANK_OPEN);
      end;

      if (Self.LoadedCoal > 0) or (Self.LoadedOre > 0) then
      begin
        if (Self.LoadedOre = 0) and Self.UseSyncTrip and (GetTickCount() - Self.LastPotReadTime > 10000) then
        begin
          if Self.HoveringBarDispenser('GetState-SyncFinalCheck') then
          begin
            if 'Take' in MainScreen.GetUpText() then
            begin
              DebugMsg('GetState -> Multi-Sync: Bars found during final check, returning to dispenser');
              Exit(EState.WALK_DISP);
            end;
          end;

          DebugMsg('GetState -> Multi-Sync: Coal residue check (Ore=0) - Verifying pot state');
          Exit(EState.POT_OPEN);
        end;

        DebugMsg('GetState -> Collection trip loaded, walking to dispenser');
        Exit(EState.WALK_DISP);
      end;
    end
    else
    begin
      coalConsumed := currentTrip.Ore * Self.CoalRatio;
      Self.LoadedCoal := Self.LoadedCoal - coalConsumed;
      Self.LoadedOre := Self.LoadedOre - currentTrip.Ore;
      DebugMsg('GetState -> Non-collection trip: Consumed ' + ToStr(coalConsumed) +
                 ' coal, ' + ToStr(currentTrip.Ore) + ' ore | Remaining: Coal=' + ToStr(Self.LoadedCoal) + ', Ore=' + ToStr(Self.LoadedOre));
      if Self.UseSyncTrip then
      begin
        if Self.MultiSyncTrip.CurrentSyncTrip < Self.MultiSyncTrip.TotalTrips then
        begin
          Inc(Self.MultiSyncTrip.CurrentSyncTrip);
          Self.CurrentTripLoaded := False;
          Self.TripStartCoal := Self.LoadedCoal;
          Self.TripStartOre := Self.LoadedOre;
          DebugMsg('GetState -> Non-collection sync trip complete, advancing to trip ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip));
          Exit(EState.BANK_OPEN);
        end
        else
        begin
          DebugMsg('GetState -> All sync trips complete, exiting sync mode');
          Self.UseSyncTrip := False;
          Self.CurrentTrip := 0;
          Self.CurrentTripLoaded := False;
          Self.TripStartCoal := Self.LoadedCoal;
          Self.TripStartOre := Self.LoadedOre;
          Exit(EState.BANK_OPEN);
        end;
      end
      else
      begin
        Self.CurrentTrip := (Self.CurrentTrip + 1) mod Length(Self.TripSequence);
        Self.CurrentTripLoaded := False;
        Self.TripStartCoal := Self.LoadedCoal;
        Self.TripStartOre := Self.LoadedOre;
        DebugMsg('GetState -> Non-collection trip complete, advancing to trip ' + ToStr(Self.CurrentTrip + 1));
        Exit(EState.BANK_OPEN);
      end;
    end;
  end;

  if Self.PotFull and ((Self.LoadedCoal > 0) or (Self.LoadedOre > 0)) then
  begin
    DebugMsg('GetState -> Pot is full, checking if we should collect or wait');
    if currentTrip.ShouldCollect and Self.CurrentTripLoaded then
    begin
      DebugMsg('GetState -> Pot full and trip designated for collection, walking to dispenser');
      Exit(EState.WALK_DISP);
    end
    else if Self.CurrentTripLoaded then
    begin
      DebugMsg('GetState -> Pot full but should NOT collect, advancing trip');
      if Self.UseSyncTrip then
      begin
        Inc(Self.MultiSyncTrip.CurrentSyncTrip);
        Self.CurrentTripLoaded := False;
        Self.PotFull := False;
        Self.TripStartCoal := Self.LoadedCoal;
        Self.TripStartOre := Self.LoadedOre;
        DebugMsg('GetState -> Advanced to sync trip ' + ToStr(Self.MultiSyncTrip.CurrentSyncTrip) +
                   '/' + ToStr(Self.MultiSyncTrip.TotalTrips) + ' | TripStart: Coal=' + ToStr(Self.TripStartCoal) + ', Ore=' + ToStr(Self.TripStartOre));
      end
      else
      begin
        Self.CurrentTrip := (Self.CurrentTrip + 1) mod Length(Self.TripSequence);
        Self.CurrentTripLoaded := False;
        Self.PotFull := False;
        Self.TripStartCoal := Self.LoadedCoal;
        Self.TripStartOre := Self.LoadedOre;
        DebugMsg('GetState -> Advanced to trip ' + ToStr(Self.CurrentTrip + 1) +
                   ' | TripStart: Coal=' + ToStr(Self.TripStartCoal) + ', Ore=' + ToStr(Self.TripStartOre));
      end;
      Exit(EState.BANK_OPEN);
    end;
  end;

  if Bank.IsOpen() then
  begin
    DebugMsg('GetState -> Bank already open, continue to next cycle');
    Result := EState.BANK_OPEN;
    Wait(50, 100);
    Exit;
  end;

  if not Self.ContainsCofferOverlay() then
  begin
    DebugMsg('GetState -> Missing coffer overlay -> Exit(EState.WORLD_BAD)');
    Exit(EState.WORLD_BAD);
  end;

  DebugMsg('GetState -> Default fallback -> Exit(EState.BANK_OPEN)');
  Exit(EState.BANK_OPEN);
end;

procedure TScript.Run(maxActions: UInt32; MaxRun: UInt64);    // maxtime is in mins
var
  str, oreStr: String;
  coalWithdrawal: TCoalWithdrawal;
  lastState: EState;
  itemsBeforeCollect, itemsAfterCollect: Int32;
begin
  lastState := EState.WAITBF;

  repeat
  if Self.State in [
      EState.POT_OPEN, EState.POT_READ, EState.BANK_OPEN, EState.ORE_GET,
      EState.COAL_GET, EState.BARS_PUT, EState.ITEMS_PUT, EState.ORE_PUT,
      EState.COAL_PUT, EState.ORE_OUT, EState.COAL_OUT, EState.COLLECT_OPEN,
      EState.COLLECT_USE, EState.BANK_CLOSE, EState.UI_CLOSE, EState.GAUGE_CLOSE,
      EState.MENU_CLOSE, EState.RUN_ON, EState.ENERGY_USE, EState.COFFER_USE,
      EState.COFFER_TALK, EState.COINS_GET, EState.MONEY_ADD, EState.BAG_REFILL,
      EState.BAG_EMPTY, EState.ICE_WEAR, EState.ORE_LOAD, EState.COAL_LOAD,
      EState.WALK_DISP, EState.HOVER_DISP, EState.BARS_WAIT, EState.BARS_GET,
      EState.MAKE_USE, EState.LEVEL_MSG, EState.CHAT_NEXT, EState.BARS_SYNC,
      EState.POT_SYNC, EState.SYNC_ACTIVE
      ] then
    begin
      if (not Self.UseSyncTrip) and (Self.CurrentTrip = 0) and (not Self.CurrentTripLoaded) then
      begin
        if Self.TakeBreaks and ((Antiban.Breaks[0].NextAtTime - GetTimeRunning()) < 30000) then
        begin
          if Bank.IsOpen() then
          begin
            DebugMsg('Run -> Break imminent, closing bank');
            GameInterface.Close(True);
            WaitUntil(not Bank.IsOpen(), 100, 2000);
            Wait(200, 400);
          end;
        end;

        if Self.GetTakeSleeps() and ((Antiban.Sleeps[0].NextAtTime - GetTimeRunning()) < 30000) then
        begin
          if Bank.IsOpen() then
          begin
            DebugMsg('Run -> Sleep imminent, closing bank');
            GameInterface.Close(True);
            WaitUntil(not Bank.IsOpen(), 100, 2000);
            Wait(200, 400);
          end;
        end;

        if Antiban.DoAntiban() and not GameClient.IsLoggedIn() then
          Self.LoginPlayer();
      end;
    end;
    Self.State := Self.GetState();

    if Self.State <> lastState then
    begin
      Self.LastStateChangeTime := GetTickCount();
      lastState := Self.State;
    end;

    if Self.UseSyncTrip then
      Self.CurrentStateText := '** SYNC: ' + ToStr(Self.State) + ' **'
    else
      Self.CurrentStateText := ToStr(Self.State);

    if Self.GetUseOverlay() then
      Self.DrawOverlay();

    if Bot.GetDebugMode() then
    begin
      GameClient.Image.DrawBox(XPBar.Bounds, $FFFF00);  // Cyan
      GameClient.Image.DrawBox(Self.CofferBounds, $FFFF00);  // Cyan
    end;


    if Self.NextState <> EState.WAITBF then
    begin
      DebugMsg('Run -> Overriding state with queued NextState: ' + ToStr(Self.NextState));

      Self.State := Self.NextState;
      Self.NextState := EState.WAITBF;
    end;

    DebugMsg('Run -> State = ' + ToStr(Self.State));

    str := ToStr(Self.LoadedCoal);
    while Length(str) < 3 do
    begin
      if Self.LoadedCoal < 0 then
        str := '-0' + str.After('-')
      else
        str := '0' + str;
    end;

    oreStr := ToStr(Self.LoadedOre);
    while Length(oreStr) < 3 do
    begin
      if Self.LoadedOre < 0 then
        oreStr := '-0' + oreStr.After('-')
      else
        oreStr := '0' + oreStr;
    end;

    DebugMsg('[LOADED COAL: ' + str + '] [LOADED ORE: ' + oreStr + ']: ' + ToStr(Self.State));
    DebugMsg('[LOADED COAL: ' + str + '] [LOADED ORE: ' + oreStr + ']: ' + ToStr(Self.State));

    case Self.State of
      EState.SCRIPT_END: Self.EndScript();
      EState.MENU_CLOSE: ChooseOption.Close();
      EState.GAUGE_CLOSE: Self.CloseGaugeMenu();
      EState.POT_OPEN:
      begin
        Self.OpenPot();
        Self.ReadPot();
      end;
      EState.POT_READ:
      begin
        Self.ReadPot();
        DebugMsg('POT_READ -> Pot synced: Coal=' + ToStr(Self.LoadedCoal) + ', Ore=' + ToStr(Self.LoadedOre));
        Self.OutOfSync := False;
      end;
      EState.BANK_OPEN:
      begin
        if not Bank.IsOpen() then
          Self.WalkOpenBank();
      end;
      EState.BARS_PUT: Self.DepositBars();
      EState.ORE_PUT: Bank.DepositItems([Self.Ore], True);
      EState.COAL_PUT: Bank.DepositItems([Self.Coal], True);
      EState.ITEMS_PUT: Bank.DepositRandomItems(Self.ItemList);
      EState.COAL_GET:
      begin
        if (LowerCase(Self.BarType) = 'steel') and Self.SteelNeedsInitialCoal and
           (Self.CoalToWithdraw = 28) and not Self.UseCoalBag then
        begin
          DebugMsg('Run -> COAL_GET: Steel priming without bag, left-clicking for 28 coal');

          if Bank.WithdrawItem(Self.Coal, True) then
          begin
            if WaitUntil(Self.CountItemRobust(Self.Coal) = 28, 100, 3000) then
            begin
              DebugMsg('Run -> COAL_GET: Successfully withdrew 28 coal via left-click');

              Self.CoalToWithdraw := 0;
            end
            else
            begin
              DebugMsg('Run -> COAL_GET: Failed to get 28 coal, retrying');
            end;
          end;
        end
        else
        begin
          if Self.WithdrawCoal(Self.CoalToWithdraw) then
          begin
            DebugMsg('Run -> Coal withdrawn successfully');
          end
          else
          begin
            DebugMsg('Run -> Failed to withdraw coal');
            Wait(100, 200);
          end;
        end;
      end;
      EState.ORE_GET:
      begin
        Self.WithdrawOre(Self.OreToWithdraw);
        if Bank.IsOpen() then
          Self.DepositUnwantedItems();
      end;
      EState.BARS_GET:
      begin
        if Self.UseSyncTrip then
          Self.HandleBarsGet(True)
        else
          Self.HandleBarsGet(False);
      end;
      EState.BANK_CLOSE:
        begin
          GameInterface.Close(True);
          WaitUntil(not GameInterface.IsOpen(), 50, 1500);
          Self.XPAfterClose := Self.CheckXP();
          if Self.UseSyncTrip then
            Self.ExpectedXPDrops := 1
          else
          begin
            if Self.TripSequence[Self.CurrentTrip].ShouldCollect then
              Self.ExpectedXPDrops := 1
            else
              Self.ExpectedXPDrops := 0;
          end;
          DebugMsg('BANK_CLOSE -> Expecting ' + ToStr(Self.ExpectedXPDrops) + ' XP drops for this trip');
          if Self.BarType = 'Gold' then
          begin
            if Inventory.ContainsItem(Self.GoldGloves) then
            begin
              DebugMsg('BANK_CLOSE -> Equipping goldsmith gauntlets for gold ore loading');
              Inventory.ClickItem(Self.GoldGloves);
              Wait(600, 800);
            end
            else
              DebugMsg('BANK_CLOSE -> WARNING: Gold gloves not in inventory');
          end
          else
          begin
            if Inventory.ContainsItem(Self.IceGloves) then
            begin
              DebugMsg('BANK_CLOSE -> Equipping ice gloves');
              Inventory.ClickItem(Self.IceGloves);
              Wait(600, 800);
            end
            else
              DebugMsg('BANK_CLOSE -> Ice gloves already equipped or in inventory');
          end;
        end;
      EState.COLLECT_USE: Self.HandleCollectBox([Self.Ore, Self.Coal]);
      EState.UI_CLOSE: GameInterface.Close(True);
      EState.MAKE_USE: Self.HandleMakeMenu();
      EState.LEVEL_MSG: Chat.HandleLevelUp();
      EState.CHAT_NEXT: Chat.ClickContinue();
      EState.POT_SYNC: Self.ReSyncPot();
      EState.BARS_SYNC: Self.GetBars();
      EState.RUN_ON: Self.ToggleRun();
      EState.ENERGY_USE: Self.WithdrawAndDrinkStamina();
      EState.ORE_LOAD:
      begin
        if not Self.LoadOre() then
        begin
          if Chat.HasContinue() and ('permission' in LowerCase(Chat.GetChat())) then
          begin
            DebugMsg('Run -> Stopped by Foreman during load -> Exit(EState.PAY_FOREMAN)');
            Self.NextState := EState.PAY_FOREMAN;
          end;
        end;
      end;
      EState.COAL_LOAD: Self.LoadCoal();
      EState.BAG_EMPTY: Self.ShiftClickCoalBag();
      EState.BAG_REFILL:
      begin
        Self.HandleBagRefill();
        if Bank.IsOpen() then
          Self.DepositUnwantedItems();
      end;
      EState.ICE_WEAR: Self.EquipIceGloves();
      EState.WALK_DISP:
      begin
        DebugMsg('[LOADED ORE: ' + Format('%.3d', [Self.LoadedOre]) + ']: WALK_DISP');

        if Self.WalkDispenser() then
        begin
          Wait(100, 200);

          if Self.BarType = 'Gold' then
          begin
            DebugMsg('Run -> Gold bars: skipping dispenser hover, proceeding to BARS_GET for XP wait');
            Self.NextState := EState.BARS_GET;
          end
          else
          begin
            DebugMsg('Run -> At dispenser, probing for bars (hover-only)');

            if WaitUntil(
                  (Self.HoveringBarDispenser('WALK_DISP') and ('Take' in MainScreen.GetUpText())),
                  50, 7500
                ) then
            begin
              DebugMsg('Run -> Take detected at dispenser -> Next = BARS_GET');
              Self.NextState := EState.BARS_GET;
            end
            else
            begin
              if Self.HoveringBarDispenser('WALK_DISP-PostWait') then
              begin
                if 'Check' in MainScreen.GetUpText() then
                begin
                  DebugMsg('Run -> Check detected (no bars); forcing POT_SYNC to reconcile tracking data');
                  Self.NextState := EState.POT_SYNC;
                end
                else
                begin
                  DebugMsg('Run -> Hovered dispenser but no Take/Check; staying at WALK_DISP');
                end;
              end
              else
              begin
                DebugMsg('Run -> Could not hover dispenser; will retry WALK_DISP');
              end;
            end;
          end;
        end;
      end;
      EState.BARS_WAIT: Self.WaitForBars();
      EState.COLLECT_OPEN: CollectBoxes.WalkOpen();
      EState.COINS_GET:
      begin
        if Self.WalkOpenBank() then
          if not Self.WithdrawCoins() then
            begin
            DebugMsg('COINS_GET -> Could not withdraw coins');
            TerminateScript();
            end;
      end;
      EState.COFFER_TALK: Self.HandleCofferChat();
      EState.MONEY_ADD: Self.AddMoney();
      EState.COFFER_USE: Self.ClickCoffer();
      EState.SUPPLY_OUT, EState.MONEY_OUT, EState.WORLD_BAD: Self.EndScript();

      EState.ORE_OUT, EState.COAL_OUT:
      begin
        DebugMsg('Run -> OUT OF MATERIALS state detected, checking collect box');

        itemsBeforeCollect := Inventory.CountItem(Self.Ore) + Inventory.CountItem(Self.Coal);
        if Self.UseCoalBag then itemsBeforeCollect += Self.CoalBagAmount;

        if not Bank.IsOpen() then
        begin
           if not Self.BankChest.SmartClick('Use') then
             Self.EndScript();
        end;

        if Bank.IsOpen() then
        begin
           Bank.DepositRandomItems([Self.CoalBag, Self.GoldGloves, Self.IceGloves]);
           Wait(300, 600);
           GameInterface.Close(True);
           WaitUntil(not GameInterface.IsOpen(), 100, 2000);
        end;

        if Self.BankChest.SmartHover('Use') then
        begin
           Mouse.Click(MOUSE_RIGHT);
           if ChooseOption.Select('Collect') then
           begin
             if WaitUntil(CollectBox.IsOpen(), 100, 3000) then
             begin
                Self.HandleCollectBox([Self.Ore, Self.Coal]);
                Wait(200, 400);
                GameInterface.Close(True);
             end;
           end;
        end;

        itemsAfterCollect := Inventory.CountItem(Self.Ore) + Inventory.CountItem(Self.Coal);
        if Self.UseCoalBag then itemsAfterCollect += Self.CoalBagAmount;

        if (itemsAfterCollect <= itemsBeforeCollect) and (itemsAfterCollect < 27) then
        begin
          DebugMsg('Run -> Checked collect box but found no extra ore/coal. Terminating script.');
          Self.EndScript();
        end;
      end;

      EState.HOP_WORLD: Self.DoWorldHop();
      EState.WAITBF: Wait(100);
      EState.SYNC_ACTIVE: ;
      EState.EMPTY_SYNC:
      begin
        if Bank.IsOpen() then
        begin
          DebugMsg('EMPTY_SYNC -> Bank is open, closing to access pot');
          GameInterface.Close(True);
          WaitUntil(not Bank.IsOpen(), 100, 2000);
        end;

        Self.OpenPot();
        Self.ReadPot();

        DebugMsg('EMPTY_SYNC -> Resetting to Trip 1');

        Self.CurrentTrip := 0;
        Self.UseSyncTrip := False;
        Self.CurrentTripLoaded := False;
        Self.TripStartCoal := 0;
        Self.TripStartOre := 0;
        Self.PotFull := False;
      end;
      EState.PAY_FOREMAN: Self.HandleForemanPayment();
    end;

  until (GetTimeRunning() > Self.ShutdownTime);

  DebugMsg('Run -> Hit max runtime. Script finished.');

  Self.EndScript();
end;

function TScript.BuildTextReport(): TStringArray; override;
var
  profitBefore, profitAfter, feeCost: Int32;
begin
  profitBefore := Self.TotalProfit;

  feeCost := Round(Self.Fee * Self.TimeRunning.ElapsedTime);
  profitAfter := profitBefore - feeCost;

    DebugMsg('BuildTextReport: Profit(before) = ' + ToStr(profitBefore));
    DebugMsg('BuildTextReport: Fee = ' + ToStr(Self.Fee));
    DebugMsg('BuildTextReport: Runtime = ' + ToStr(Self.TimeRunning.ElapsedTime));
    DebugMsg('BuildTextReport: Profit(after) = ' + ToStr(profitAfter));

  Self.TotalProfit := profitAfter;
  Result := inherited();
  Self.TotalProfit := profitBefore;

  DebugMsg('BuildTextReport: Report built, profit reset to ' + ToStr(profitBefore));
end;

procedure GUI.OpenExample(sender: TObject);
begin
  Sender;
  OpenWebPage('https://github.com/Baconadors/Bacon-Tools/blob/main/ScriptImages/ProblemSSExample.png?raw=true')
end;

procedure GUI.ExitScript(sender: TObject);
begin
  TForm(TButton(Sender).GetParent()).Close;
  DebugMsg('Thank you for trying to fix these problems before running the script!');
  TerminateScript();
end;

procedure GUI.CloseForm(sender: TObject);
begin
  TForm(TButton(Sender).GetParent()).Close;
end;

procedure GUI.CheckProblems;
var
  warningForm: TForm;
  detProbMsg: TLabel;
  waspLauncherMsg, fixedModeMsg, notSubbedMsg, warningMsg: TMemo;
  nextTop: Integer;
  showWasp, showFixed, showSub: Boolean;
  continueButton, exitButton: TButton;
begin
  with warningForm do
  begin
    Init(nil);
    SetCaption('!!! WARNING !!!');
    SetBounds(0,0,TControl.AdjustToDPI(600),TControl.AdjustToDPI(500));
    SetPosition(poScreenCenter);
    GetFont.SetStyle([fsBold]);
  end;

  with detProbMsg do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(0));
    GetFont().SetSize(18);
    SetCaption('Detected problem(s):');
  end;

  nextTop := detProbMsg.GetTop + detProbMsg.GetHeight + TControl.AdjustToDPI(25);

  if (ScriptFile.after("\waspscripts.com\") <> 'blast-furnace-by-baconadors.simba') then
  begin
    showWasp := True;
    Bot.ContinuedWithWaspWarning := True;

    with waspLauncherMsg do
    begin
      Init(warningForm);
      SetParent(warningForm);
      SetBounds(TControl.AdjustToDPI(5), nextTop, warningForm.GetWidth - TControl.AdjustToDPI(10), TControl.AdjustToDPI(75));
      GetFont().SetSize(13);
      SetCaption('You are likely not running this script via Wasp Launcher. ' +
                 'Wasp Launcher is the only supported way to run and keep libraries/' +
                 'scripts up-to-date. Please use Wasp Launcher when possible.');
      SetReadOnly(True);
      nextTop := nextTop + waspLauncherMsg.GetHeight + TControl.AdjustToDPI(10);
    end;
  end;

  if GameClient.IsLoggedIn and (GameClient.Mode <> EClientMode.FIXED) then
  begin
    showFixed := True;
    Bot.ContinuedWithFixedWarning := True;

    with fixedModeMsg do
    begin
      Init(warningForm);
      SetParent(warningForm);
      SetBounds(TControl.AdjustToDPI(5), nextTop, warningForm.GetWidth - TControl.AdjustToDPI(10), TControl.AdjustToDPI(53));
      GetFont().SetSize(13);
      SetCaption('You are not using the FIXED CLASSIC screen mode. FIXED CLASSIC ' +
                 'mode is the only supported mode for this script.');
      SetReadOnly(True);
      nextTop := nextTop + fixedModeMsg.GetHeight + TControl.AdjustToDPI(10);
    end;
  end;

  if not WaspClient.HasAccess({$MACRO SCRIPT_ID}, {$MACRO SCRIPT_REVISION}) then
  begin
    showSub := True;
    Bot.ContinuedWithSubWarning := True;

    with notSubbedMsg do
    begin
      Init(warningForm);
      SetParent(warningForm);
      SetBounds(TControl.AdjustToDPI(5), nextTop, warningForm.GetWidth - TControl.AdjustToDPI(10), TControl.AdjustToDPI(100));
      GetFont().SetSize(13);
      SetCaption('Your subscription to this script could not be verified. ' +
                 'This may be because your subscription has run out or the ' +
                 'script may not have been downloaded & opened via Wasp Launcher. ' +
                 'Please consider subscribing to support your script author.');
      SetReadOnly(True);
      nextTop := nextTop + notSubbedMsg.GetHeight + TControl.AdjustToDPI(10);
    end;
  end;

  warnImg.init();
  warnImg.LoadFromFile('Resources\Warning_Triangle_140.png');

  with warnTriangle140 do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetName('warn_Triangle_150');
    SetBounds(TControl.AdjustToDPI(5), TControl.AdjustToDPI(300), TControl.AdjustToDPI(150), TControl.AdjustToDPI(132));
    SetPicture(warnImg);
    SetVisible(True);
    BringToFront;
  end;

  with warningMsg do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetBounds(warnTriangle140.GetLeft + warnTriangle140.GetWidth + TControl.AdjustToDPI(10), warnTriangle140.GetTop,
              warningForm.GetWidth - warnTriangle140.GetWidth - warnTriangle140.GetLeft - TControl.AdjustToDPI(15), TControl.AdjustToDPI(123));
    GetFont().SetSize(13);
    SetCaption('By continuing with this script, you acknowledge that these ' +
               'problems may cause instability or other issues. ' +
               'When asking for help, post a screenshot with Simba & RuneLite FULLY visible. ' + LineEnding +
               '      Click this text box for an example screenshot.');
    setOnClick(@OpenExample);
  end;

  with continueButton do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetBounds(TControl.AdjustToDPI(5),(warnTriangle140.getTop + warnTriangle140.getHeight),
              TControl.AdjustToDPI(294), TControl.AdjustToDPI(62));
    GetFont.SetSize(18);
    SetCaption('CONTINUE');
    setOnClick(@CloseForm);
  end;

  with exitButton do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetBounds(continueButton.GetRight + TControl.AdjustToDPI(3),(warnTriangle140.getTop + warnTriangle140.getHeight),
              continueButton.getWidth, TControl.AdjustToDPI(62));
    GetFont.SetSize(18);
    SetCaption('STOP SCRIPT');
    setOnClick(@ExitScript);
  end;

  if showWasp or showFixed or showSub or Bot.debugMode then
    warningForm.ShowModal;
end;

procedure GUI.OnlyNumbers(sender: TObject; var Key: Char);
var
  Edit: TEdit;
  DigitCount: Integer;
  i: Integer;
  TextValue: String;
  MaxDigits: Integer;
begin
  Edit := TEdit(Sender);

  if (Key = #8) or (Key = ':') then
    Exit;

  if Key in ['0'..'9'] then
  begin
    TextValue := Edit.GetText();

    DigitCount := 0;
    for i := 1 to Length(TextValue) do
      if TextValue[i] in ['0'..'9'] then
        Inc(DigitCount);

    if Edit.GetName() = 'box_sa_edit' then
      MaxDigits := 6
    else
      MaxDigits := 4;

    if DigitCount >= MaxDigits then
      Key := #0;
  end
  else
    Key := #0;
end;

procedure GUI.ToggleCoalBagBox(sender: TObject);
var
  barSelect: TComboBox;
  barName: String;
begin
  barSelect := TComboBox(Self.Form.GetChild('lcb_bars_combobox'));
  barName   := barSelect.GetText;

  if (barName = 'Bronze') or (barName = 'Silver') or
     (barName = 'Lead') or (barName = 'Gold') or (barName = 'Cupronickel') then
  begin
    lcb_CoalBag.SetEnabled(False);
    lcb_CoalBag.SetChecked(False);
  end
  else
    lcb_CoalBag.SetEnabled(True);
end;

procedure GUI.UpdateToggles(sender: TObject);
begin
  Self.ToggleCoalBagBox(nil);
end;

procedure GUI.StartScript(sender: TObject); override;
var
  S: TGameObject;
  e_Run, e_BA, e_BF, e_SA, e_SF, e_Energy: TEdit;
  cb_Breaks, cb_Sleeps, cb_CoalBag, cb_FillCoffer, cb_Debug, cb_Empty, cb_Overlay: TCheckBox;
  cb_Bars, cb_Staminas: TComboBox;
begin
  inherited;

  e_Run               := Self.Form.GetChild('box_run_edit');
  Bot.MaxRun          := StrToInt(e_Run.getText);
  Bot.ShutdownTime    := (Bot.MaxRun * 60000) + Random(-(Bot.MaxRun * 6000), (Bot.MaxRun * 6000));
  Self.Config.Put('maxrun', e_Run.getText);

  cb_Breaks           := Self.Form.GetChild('cb_breaks_checkbox');
  Bot.TakeBreaks      := cb_Breaks.IsChecked;
  Self.Config.Put('breaks', cb_Breaks.IsChecked);

  if Bot.TakeBreaks then
  begin
    e_BA              := Self.Form.GetChild('box_ba_edit');
    e_BF              := Self.Form.GetChild('box_bf_edit');
    Antiban.AddBreak(ONE_MINUTE * StrToInt(e_BA.getText),
                     ONE_MINUTE * StrToInt(e_BF.getText),
                     0.15, 1.0);
    Self.Config.Put('breakafter', e_BA.getText);
    Self.Config.Put('breakfor', e_BF.getText);
  end
  else
    SetLength(Antiban.Breaks, 0);

  cb_Sleeps           := Self.Form.GetChild('cb_sleeps_checkbox');
  Bot.TakeSleeps      := cb_Sleeps.IsChecked;
  Self.Config.Put('sleeps', cb_Sleeps.IsChecked);

  if Bot.TakeSleeps then
  begin
    e_SA              := Self.Form.GetChild('box_sa_edit');
    e_SF              := Self.Form.GetChild('box_sf_edit');
    Antiban.AddSleep(e_SA.getText,
                     StrToInt(e_SF.getText) * ONE_HOUR,
                     0.1, 1.0);
    Self.Config.Put('sleepat', e_SA.getText);
    Self.Config.Put('sleepfor', e_SF.getText);
  end
  else
    SetLength(Antiban.Sleeps, 0);

  cb_Bars             := Self.Form.GetChild('lcb_bars_combobox');
  cb_Staminas         := Self.Form.GetChild('lcb_staminas_combobox');
  cb_CoalBag          := Self.Form.GetChild('cb_coalbag_checkbox');
  cb_FillCoffer       := Self.Form.GetChild('cb_fillcoffer_checkbox');
  cb_Debug            := Self.Form.GetChild('cb_debug_checkbox');
  cb_Empty            := Self.Form.GetChild('cb_empty_checkbox');
  cb_Overlay          := Self.Form.GetChild('cb_overlay_checkbox');

  Bot.BarType         := cb_Bars.getText;
  Bot.StaminaType     := cb_Staminas.getText;
  e_Energy            := Self.Form.GetChild('box_energy_edit');
  Bot.MinEnergy       := StrToInt(e_Energy.GetText);
  Bot.UseCoalBag      := cb_CoalBag.IsChecked;
  Bot.AutoFillCoffer  := cb_FillCoffer.IsChecked;
  Bot.debugMode       := cb_Debug.IsChecked;
  Bot.UseEmpty        := cb_Empty.IsChecked;
  Bot.UseOverlay      := cb_Overlay.IsChecked;

  Self.Config.Put('bars', cb_Bars.getItemIndex);
  Self.Config.Put('staminas', cb_Staminas.getItemIndex);
  Self.Config.Put('energyperc', e_Energy.getText);
  Self.Config.Put('coalbag', cb_CoalBag.IsChecked);
  Self.Config.Put('fillcoffer', cb_FillCoffer.IsChecked);
  Self.Config.Put('debugmode', cb_Debug.IsChecked);
  Self.Config.Put('useempty', cb_Empty.IsChecked);
  Self.Config.Put('useoverlay', cb_Overlay.IsChecked);

  Self.Form.Close();
  DebugMsg('Starting script');
end;

procedure GUI.UpdateBackgrounds(sender: TObject);
var
  tabName: String;
begin
  tabName := Self.PageControl.GetActivePage.GetName;

  if tabName = 'Settings_Tab' then
  begin
    Self.BGImgSettings.SetVisible(True);
    Self.BGImgAccounts.SetVisible(False);
  end
  else
  begin
    Self.BGImgSettings.SetVisible(False);
    Self.BGImgAccounts.SetVisible(True);
  end;
end;

function GUI.CreateSettingsTab(): TTabSheet;
var
  lb_Time, lb_Misc, lb_Debug: TLabel;
  lcb_Bars, lcb_Staminas: TLabeledComboBox;
  cb_Breaks, cb_Sleeps,
  cb_FillCoffer, cb_Debug, cb_Empty, cb_Overlay: TLabeledCheckBox;
  box_Run, box_BA, box_BF, box_SA,
  box_SF, box_Energy: TLabeledEdit;
  tp_Video: TPanel;

begin
  Result.Init(nil);
  Result.SetCaption('Script Settings');
  Result.SetName('Settings_Tab');
  Result.SetOnShow(@Self.UpdateToggles);

  ImgSettings.Init();
  ImgSettings.LoadFromFile('Resources\BlastFurnaceGUI_Settings_' + VERSION + '.png');

  with Self.BGImgSettings do
    begin
      Init(Self.PageControl);
      SetParent(Self.PageControl);
      SetPicture(ImgSettings);
      SetName('BGImgSettings');
      SetVisible(True);
      SetBounds(0, 0, Self.Form.GetWidth, Self.Form.GetHeight);
    end;

  Result.setOnShow(@UpdateBackgrounds);
  Result.setOnHide(@UpdateBackgrounds);

  with lb_Time do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(10));
    GetFont().SetSize(15);
    SetCaption('Time settings');
    GetFont.SetStyle([fsBold]);
  end;

  with box_Run do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(45));
    SetName('box_Run');
    SetCaption('Max Run Time - X Minutes');
    SetToolTip('Time in minutes');
    Edit.SetOnKeyPress(@OnlyNumbers);
    if Self.Config.Has('maxrun') then
      SetText(Self.Config.GetString('maxrun'))
    else
      SetText(ToStr(RandomRange(300,500)));
  end;

  with cb_Breaks do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(100));
    SetName('cb_breaks');
    SetCaption('Take breaks');
    if Self.Config.Has('breaks') then
      SetChecked(Self.Config.GetBoolean('breaks'))
    else
      SetChecked(True);
  end;

  with box_BA do
  begin
    Create(Result);
    SetLeft(box_Run.GetLeft);
    SetTop(TControl.AdjustToDPI(120));
    SetName('box_ba');
    SetCaption('Break after X Minutes');
    SetToolTip('Time in minutes');
    Edit.SetOnKeyPress(@OnlyNumbers);
    if Self.Config.Has('breakafter') then
      SetText(Self.Config.GetString('breakafter'))
    else
      SetText(ToStr(RandomRange(50,75)));
  end;

  with box_BF do
  begin
    Create(Result);
    SetLeft(box_Run.GetLeft);
    SetTop(TControl.AdjustToDPI(165));
    SetName('box_bf');
    SetCaption('Break for X Minutes');
    SetToolTip('Time in minutes');
    Edit.SetOnKeyPress(@OnlyNumbers);
    if Self.Config.Has('breakfor') then
      SetText(Self.Config.GetString('breakfor'))
    else
      SetText(ToStr(RandomRange(7,15)));
  end;

  with cb_Sleeps do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(215));
    SetName('cb_sleeps');
    SetCaption('Take sleeps');
    if Self.Config.Has('sleeps') then
      SetChecked(Self.Config.GetBoolean('sleeps'))
    else
      SetChecked(True);
  end;

  with box_SA do
  begin
    Create(Result);
    SetLeft(box_Run.GetLeft);
    SetTop(TControl.AdjustToDPI(235));
    SetName('box_sa');
    SetCaption('Sleep at Time (24Hr format)');
    SetToolTip('Time in 24Hr format');
    Edit.SetOnKeyPress(@OnlyNumbers);
    if Self.Config.Has('sleepat') then
      SetText(Self.Config.GetString('sleepat'))
    else
      SetText(ToStr(RandomRange(20,22))+':' + ToStr(RandomRange(0,59))+':00');
  end;

  with box_SF do
  begin
    Create(Result);
    SetLeft(box_Run.GetLeft);
    SetTop(TControl.AdjustToDPI(280));
    SetName('box_sf');
    SetCaption('Sleep for X Hours');
    SetToolTip('Time in hours');
    Edit.SetOnKeyPress(@OnlyNumbers);
    if Self.Config.Has('sleepfor') then
      SetText(Self.Config.GetString('sleepfor'))
    else
      SetText(ToStr(RandomRange(6,9)));
  end;

  with lb_Misc do
  begin
    Create(Result);
    SetLeft(lb_Time.GetLeft + lb_Time.GetWidth + TControl.AdjustToDPI(227));
    SetTop(lb_Time.getTop);
    GetFont().SetSize(15);
    SetCaption('Misc settings');
    GetFont.SetStyle([fsBold]);
  end;

  with lcb_Bars do
  begin
    Create(Result);
    SetLeft(lb_Misc.GetLeft + TControl.AdjustToDPI(-22));
    SetTop(lb_Misc.GetBottom + TControl.AdjustToDPI(20));
    SetName('lcb_bars');
    SetCaption('Bar type');
    AddItemArray(['Bronze','Iron','Silver', 'Lead', 'Steel','Gold','Mithril','Adamantite','Cupronickel', 'Runite']);
    if Self.Config.Has('bars') then
      SetItemIndex(Self.Config.GetInt('bars'))
    else
      SetItemIndex(0);
    ComboBox.SetOnChange(@Self.ToggleCoalBagBox);
  end;

  with lcb_Staminas do
  begin
    Create(Result);
    SetLeft(lcb_Bars.GetLeft + TControl.AdjustToDPI(0));
    SetTop(lcb_Bars.GetBottom + TControl.AdjustToDPI(3));
    SetName('lcb_staminas');
    SetCaption('Stamina Potion Type');
    AddItemArray(['None','Stamina potion','Extended stamina potion']);
    if Self.Config.Has('staminas') then
      SetItemIndex(Self.Config.GetInt('staminas'))
    else
      SetItemIndex(0);
  end;

  with box_Energy do
  begin
    Create(Result);
    SetLeft(lcb_Staminas.GetLeft + TControl.AdjustToDPI(0));
    SetTop(lcb_Staminas.GetBottom + TControl.AdjustToDPI(3));
    SetName('box_energy');
    SetCaption('% Energy to use Stamina potion');
    SetToolTip('Minimum run energy');
    Edit.SetOnKeyPress(@OnlyNumbers);
    if Self.Config.Has('energyperc') then
      SetText(Self.Config.GetString('energyperc'))
    else
      SetText(ToStr(RandomRange(40,50)));
  end;

  with lcb_CoalBag do
  begin
    Create(Result);
    SetLeft(lcb_Staminas.GetLeft + TControl.AdjustToDPI(30));
    SetTop(box_Energy.GetBottom + TControl.AdjustToDPI(10));
    SetName('cb_coalbag');
    SetCaption('Use Coal bag');
    if Self.Config.Has('coalbag') then
      SetChecked(Self.Config.GetBoolean('coalbag'))
    else
      SetChecked(False);
  end;

  with cb_FillCoffer do
  begin
    Create(Result);
    SetLeft(lcb_CoalBag.GetLeft + TControl.AdjustToDPI(0));
    SetTop(lcb_CoalBag.GetBottom + TControl.AdjustToDPI(10));
    SetName('cb_fillcoffer');
    SetCaption('Auto fill coffer');
    if Self.Config.Has('fillcoffer') then
      SetChecked(Self.Config.GetBoolean('fillcoffer'))
    else
      SetChecked(False);
  end;

  with cb_Empty do
  begin
    Create(Result);
    SetLeft(lcb_CoalBag.GetLeft + TControl.AdjustToDPI(0));
    SetTop(cb_FillCoffer.GetBottom + TControl.AdjustToDPI(10));
    SetName('cb_empty');
    SetCaption('Empty pot sync');
    if Self.Config.Has('useempty') then
      SetChecked(Self.Config.GetBoolean('useempty'))
    else
      SetChecked(False);
  end;

  with cb_Overlay do
  begin
    Create(Result);
    SetLeft(lcb_CoalBag.GetLeft + TControl.AdjustToDPI(0));
    SetTop(cb_Empty.GetBottom + TControl.AdjustToDPI(10));
    SetName('cb_overlay');
    SetCaption('On-screen overlay');
    if Self.Config.Has('useoverlay') then
      SetChecked(Self.Config.GetBoolean('useoverlay'))
    else
      SetChecked(False);
  end;

  with lb_Debug do
  begin
    Create(Result);
    SetLeft(lb_Time.GetLeft + lb_Time.GetWidth + TControl.AdjustToDPI(490));
    SetTop(lb_Time.getTop);
    GetFont().SetSize(15);
    SetCaption('Debug settings');
    GetFont.SetStyle([fsBold]);
  end;

  with cb_Debug do
  begin
    Create(Result);
    SetLeft(lb_Debug.GetLeft + TControl.AdjustToDPI(7));
    SetTop(lb_Debug.GetBottom + TControl.AdjustToDPI(25));
    SetName('cb_debug');
    SetCaption('Enable Debug Mode');
    if Self.Config.Has('debugmode') then
      SetChecked(Self.Config.GetBoolean('debugmode'))
    else
      SetChecked(False);
  end;

  tp_Video := Self.CreateVideoPanel(Result);
  tp_Video.SetLeft(cb_Debug.GetLeft + TControl.AdjustToDPI(4));
  tp_Video.SetTop(cb_Debug.GetBottom + TControl.AdjustToDPI(0));

end;

procedure GUI.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  SButton: TButton;
begin
  inherited;

  Self.Config.Setup('blastfurnace');

  ImgAccounts.Init();
  ImgAccounts.LoadFromFile('Resources\BlastFurnaceGUI_Accounts_' + VERSION + '.png');

  with Self.BGImgAccounts do
  begin
    Init(Self.PageControl);
    SetParent(Self.PageControl);
    SetPicture(ImgAccounts);
    SetName('BGImgAccounts');
    SetBounds(0, 0, Self.Form.GetWidth, Self.Form.GetHeight);
  end;

  Self.Start.SetVisible(False);
  with SButton do
  begin
    Create(Self.Form);
    SetName('SButton');
    SetBounds(Self.Form.GetRight - 190, Self.Form.GetBottom - 70, 180, 60);
    GetFont.SetName('Bahnschrift');
    GetFont.SetSize(18);
    SetCaption('START');
    GetFont.SetStyle([fsBold]);
    SetOnClick(@Self.StartScript);
  end;

  Self.AddTab(CreateSettingsTab());
  Self.CreateAccountManager();
end;

begin
  GameClient.Image.Clear;
  ClearDebug;

  WLSettings.GetObject('antiban').getJSONObject('tasks').Put('camera', False);
  WLSettings.GetObject('antiban').getJSONObject('tasks').Put('mouse', False);
  WLSettings.GetObject('antiban').getJSONObject('tasks').Put('chat', False);
  WLSettings.GetObject('antiban').getJSONObject('tasks').Put('gametabs', False);
  WLSettings.GetObject('antiban').getJSONObject('tasks').Put('bank', False);
  WLSettings.GetObject('antiban').getJSONObject('tasks').Put('enabled', False);

  GameClient.RemoteInput.DisableRealInput;

  if not DirectoryExists(AppPath + '\Resources\') then
    CreateDirectory(AppPath + '\Resources');

 if not FileExists(AppPath + 'Resources\BlastFurnaceGUI_Settings_' + VERSION + '.png') then
    DownloadToFile('https://github.com/Baconadors/Bacon-Tools/blob/main/ScriptImages/BlastFurnaceGUI_Settings.png?raw=true',
         AppPath + 'Resources\BlastFurnaceGUI_Settings_' + VERSION + '.png');

  if not FileExists(AppPath + 'Resources\BlastFurnaceGUI_Accounts_' + VERSION + '.png') then
    DownloadToFile('https://github.com/Baconadors/Bacon-Tools/blob/main/ScriptImages/BlastFurnaceGUI_Accounts.png?raw=true',
         AppPath + 'Resources\BlastFurnaceGUI_Accounts_' + VERSION + '.png');

  if not FileExists(AppPath + '\Resources\Warning_Triangle_75.png') then
    DownloadToFile('https://github.com/Baconadors/Bacon-Tools/blob/main/ScriptImages/Warning_Triangle_75.png?raw=true',
         AppPath + '\Resources\Warning_Triangle_75.png');

  if not FileExists(AppPath + '\Resources\Warning_Triangle_140.png') then
    DownloadToFile('https://github.com/Baconadors/Bacon-Tools/blob/main/ScriptImages/Warning_Triangle_140.png?raw=true',
         AppPath + '\Resources\Warning_Triangle_140.png');

  if (ScriptFile.after("\waspscripts.com\") = 'blast-furnace-by-baconadors.simba') then
    SettingsHandler.CheckGPUPlugin();

  if (ScriptFile.after("\waspscripts.com\") = 'blast-furnace-by-baconadors.simba') then
    Sync(@GUI.CheckProblems);

  GUI.Setup('Blast Furnace', [753, 428]);
  GUI.PageControl.SetAllChildsFontColor($3D9AFF);
  GUI.Run;
  Bot.Init(WLSettings.MaxActions, Bot.MaxRun);
  Bot.Run(WLSettings.MaxActions, Bot.MaxRun);
end.
