function TScript.GetDebugMode: Boolean;
begin
  Result := Self.debugMode;
end;

function TLogout.ClickLogout(attempts: Int32 = 5; tryTime: Int32 = 20000): Boolean; override;
var
  interval: UInt64;
  i: Int32;
begin
  if (not Self.Open()) or (not Self.CloseWorldSwitcher()) then
    Exit;

  interval := tryTime div attempts;

  for i := 1 to attempts do
  begin
    Self.ClearEnter();
    if Self.GetButton(ELogoutButton.CLICK_HERE).Click() and WaitUntil(not GameClient.IsLoggedIn(), 500, Interval + SRL.NormalRange(-2000, 2000)) then
      Exit(True);
  end;
end;

function TChat.CheckSystemUpdate(minuteTreshold: Integer): Boolean;
var
  b: TBox;
  s: String;
  numbers: TExtendedArray;
begin
  b := Chat.Bounds;
  b.X1 += 4;
  b.Y1 -= 16;
  b.Y2 := Chat.Bounds.Y1 - 1;
  b.X2 := b.X1 + 140;

  s := OCR.Recognize(b, TOCRColorFilter.Create([65535]), FONT_PLAIN_12);

  if s.Contains('System update') then
  begin
    s := s.After(': ');
    numbers := s.ExtractNumbers();
    if (length(numbers) > 0) and (numbers[0] <= minuteTreshold) then
      Result := True;
  end;
end;

procedure TScript.SafeFree(var Obj);
begin
  try
    if Assigned(TObject(Obj)) then
    begin
      TObject(Obj).Free;
      Pointer(Obj) := nil;
    end;
  except
    DebugMsg('Exception while freeing object');
  end;
end;

function TScript.ChangeButtonState(Button: EChatButton; State: EChatButtonState): Boolean;
begin
  if ChatButtons.GetState(Button) = State then
    Exit(True);

  ChatButtons.GetButton(Button).Click(MOUSE_RIGHT);

  if WaitUntil(ChooseOption.IsOpen, 50, 1000) then
  begin
    case State of
      EChatButtonState.ENABLED:   ChooseOption.Select(['Filter', 'standard', 'all']);
      EChatButtonState.FILTERED:  ChooseOption.Select(['Filter', 'friends']);
      EChatButtonState.DISABLED:  ChooseOption.Select(['none']);
      EChatButtonState.HIDE:      ChooseOption.Select(['Hide']);
      EChatButtonState.AUTOCHAT:  ChooseOption.Select(['autochat']);
    end;
  end;

  Result := ChatButtons.GetState(Button) = State;
end;

procedure TScript.WorldHop();
var
  currentWorld, targetWorld, i: Int32;
  playerWorlds, availableWorlds: TIntegerArray;
begin
  DebugMsg('WorldHop -> Starting world hop process');

  Chat.CheckSystemUpdate(3);

  playerWorlds := Login.GetPlayer().Worlds;

  if Length(playerWorlds) < 2 then
  begin
    DebugMsg('Player worlds list is empty or too short. Setting default worlds.');
    playerWorlds := [305, 340, 445, 491, 507];
  end;

  DebugMsg('WorldHop -> Player worlds detected (final list size: ' + ToStr(Length(playerWorlds)) + ')');

  if Length(playerWorlds) < 2 then
  begin
    DebugMsg('WorldHop -> Not enough available worlds (less than 2). Aborting hop.');
    DebugMsg('Cannot hop worlds: Failed to set a valid world list.');
    Exit;
  end;

  if not Logout.Open() then
  begin
    DebugMsg('WorldHop -> Failed to open logout menu');
    Exit;
  end;

  if not Logout.IsWorldSwitcherOpen() then
  begin
    DebugMsg('WorldHop -> Opening world switcher menu');
    Logout.GetButton(ELogoutButton.WORLD_SWITCHER).Click(MOUSE_LEFT);
  end;

  DebugMsg('WorldHop -> Waiting for current world detection...');
  WaitUntil((currentWorld := WorldHopper.GetCurrentWorld()) <> 0, 65, 20000);

  DebugMsg('WorldHop -> Current world: ' + ToStr(currentWorld));

  availableWorlds := [];
  for i := 0 to High(playerWorlds) do
  begin
    if playerWorlds[i] <> currentWorld then
      availableWorlds += playerWorlds[i];
  end;

  DebugMsg('WorldHop -> Filtered available worlds: ' + ToStr(availableWorlds));

  if Length(availableWorlds) = 0 then
  begin
    DebugMsg('WorldHop -> No suitable worlds to hop to. Aborting.');
    Exit;
  end;

  targetWorld := availableWorlds[Random(Length(availableWorlds))];
  DebugMsg('WorldHop -> Selected target world: ' + ToStr(targetWorld));

  if WorldHopper.Hop([targetWorld]) then
    DebugMsg('Successfully hopped to world ' + ToStr(targetWorld) + '!')
  else
    DebugMsg('WorldHop -> World hop to ' + ToStr(targetWorld) + ' failed');
end;

function TGameClient.Image(): TMufasaBitmap; override;
begin
  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if RemoteInput.IsSetup() then
    Exit(RemoteInput.GetImage());
  {$ENDIF}

  Result := nil;
end;

function TScript.EnsureZoom(target, low, high: Integer; useScroll: Boolean = True): Boolean;
var
  currentZoom, chosen: Integer;
  method: String;
begin
  currentZoom := MM2MS.GetZoomLevel();

  if InRange(currentZoom, low, high) then
    Exit(True);

  chosen := SRL.SkewedRand(target, low, high);

  if useScroll then
    method := 'scroll'
  else
    method := 'options';

  if useScroll then
    Result := RSMouseZoom.SetZoomLevel(chosen)
  else
    Result := Options.SetZoomLevel(chosen);
end;

procedure TScript.EnsureCompass(target, low, high: Integer);
var
  currentAngle, chosen: Double;
begin
  currentAngle := Minimap.GetCompassAngle(True);

  if InRange(currentAngle, low, high) then
    Exit;

  chosen := SRL.SkewedRand(target, low, high);
  Minimap.SetCompassAngle(chosen);
end;

procedure TScript.LoginPlayer();
var
  index, attempts, retryTime: Int32;
begin
  if GameClient.IsLoggedIn then
    Exit;

  Self.LastXPTime := GetTickCount();
  Self.LastXPCheck := GetSystemTime();

  index := Login.PlayerIndex;

  if Login.Players[index].User = '' then
  begin
    DebugMsg('LoginPlayer -> No player credentials. Add account to credentials to use the script.');
    Exit;
  end;

  if Self.GetBreakHops then
  begin
    if Length(Login.Players[index].Worlds) < 5 then
    begin
      DebugMsg('LoginPlayer -> BreakHops enabled but world list too short (< 5). Setting default valid worlds.');
      Login.Players[index].Worlds := [305, 313, 339, 374, 445, 480, 495, 573, 603, 629];
      Self.originalWorlds := Login.Players[index].Worlds;
    end;
  end;

  attempts := 0;
  repeat
    Inc(attempts);
    DebugMsg('LoginPlayer -> Attempting to login (attempt #' + ToString(attempts) + ')');

    if Self.GetBreakHops then
      Login.LoginPlayer(True, 100)
    else
      Login.LoginPlayer(False);

    if not GameClient.IsLoggedIn then
    begin
      retryTime := Random(5000, 10000);
      DebugMsg('LoginPlayer -> Login failed or world full. Retrying in about ' + ToStr(Round(retryTime / 1000)) + ' seconds...');
      Wait(retryTime);
    end;
  until GameClient.IsLoggedIn;

  DebugMsg('LoginPlayer -> Successfully logged in.');
  Login.Players[Login.PlayerIndex].Worlds := Self.originalWorlds;
end;

function TScript.BoxFromDTMs(dtms: TIntegerArray; search: TBox): TBox;
var
  i, x, y: Int32;
  first: Boolean;
begin
  first := True;

  for i := 0 to High(dtms) do
  begin
    if FindDTM(dtms[i], x, y, search) then
    begin
      if first then
      begin
        Result.x1 := x;
        Result.y1 := y;
        Result.x2 := x;
        Result.y2 := y;
        first := False;
      end
      else
      begin
        if x < Result.x1 then Result.x1 := x;
        if y < Result.y1 then Result.y1 := y;
        if x > Result.x2 then Result.x2 := x;
        if y > Result.y2 then Result.y2 := y;
      end;
    end;
  end;

  if first then
  begin
    Result.x1 := 0;
    Result.y1 := 0;
    Result.x2 := 0;
    Result.y2 := 0;
  end;
end;

function TMapObject.SmartClick(ExpectedUpText: String; leftClick: Boolean = True; restrictBounds: TBox = []): Boolean;
var
  atpa: T2DPointArray;
  tpa, filteredTPA: TPointArray;
  p: TPoint;
  upText: String;
  tries, i: Int32;
  objBox: TBox;
begin
  GameClient.Image.Clear();
  Result := False;

  if not Self.Find(atpa) then
  begin
    DebugMsg('SmartClick -> Object "' + ExpectedUpText + '" not found by Finder (Color/DTM failed)');
    Exit;
  end;

  tpa := atpa.Merge();

  if Length(tpa) < 1 then
  begin
    DebugMsg('SmartClick -> Found zero points for "' + ExpectedUpText + '"');
    Exit;
  end;

  if (restrictBounds.x1 <> 0) or (restrictBounds.y1 <> 0) or
     (restrictBounds.x2 <> 0) or (restrictBounds.y2 <> 0) then
  begin
    DebugMsg('SmartClick -> Filtering points by restricted bounds');
    SetLength(filteredTPA, 0);
    for i := 0 to High(tpa) do
    begin
      if restrictBounds.Contains(tpa[i]) then
        filteredTPA += tpa[i];
    end;

    if Length(filteredTPA) < 1 then
    begin
      DebugMsg('SmartClick -> No points found within restricted bounds');
      Exit;
    end;

    tpa := filteredTPA;
  end;

  objBox := tpa.Bounds();
  p := tpa.RandomMean();

  if Bot.GetDebugMode() then
  begin
    GameClient.Image.DrawTPA(tpa, $FF00FF); // Magenta
    GameClient.Image.DrawBox(objBox, $00FFFF); // Yellow
    GameClient.Image.DrawBox(objBox.Expand(-1), $00FF00); // Green
    GameClient.Image.DrawCircle(p, 3, $FFFF00); // Cyan
    DebugMsg('SmartClick -> Draw debug boxes around target.');
  end;

  DebugMsg('SmartClick -> Moving mouse to click point [' + ToStr(p.x) + ',' + ToStr(p.y) + ']');

  Mouse.Move(p);
  Wait(50, 150);

  tries := 0;
  repeat
    upText := MainScreen.GetUpText();
    Inc(tries);

    if (ExpectedUpText = '') or (Pos(ExpectedUpText, upText) > 0) then
    begin
      DebugMsg('SmartClick -> Uptext matched "' + ExpectedUpText + '" after ' + ToStr(tries) + ' tries');

      if leftClick then
      begin
        DebugMsg('SmartClick -> Performing LEFT click');
        Mouse.Click(MOUSE_LEFT);
      end
      else
      begin
        DebugMsg('SmartClick -> Performing RIGHT click');
        Mouse.Click(MOUSE_RIGHT);
      end;

      if WaitUntil(Mainscreen.DidRedClick(), 50, 1000) then
      begin
        DebugMsg('SmartClick -> Red click confirmed for "' + ExpectedUpText + '", success');
        Exit(True);
      end
      else
      begin
        DebugMsg('SmartClick -> No red click detected for "' + ExpectedUpText + '", click may have failed');
        Exit(False);
      end;
    end;

    Wait(50, 100);
  until (tries > 6);

  DebugMsg('SmartClick -> Failed uptext match for "' + ExpectedUpText + '" (last uptext: "' + upText + '") after 6 tries');
end;

function TMapObject.SmartHover(ExpectedUpText: String; restrictBounds: TBox = []): Boolean;
var
  atpa: T2DPointArray;
  tpa, filteredTPA: TPointArray;
  p: TPoint;
  upText: String;
  tries, i, attempt: Int32;
  objBox: TBox;
begin
  if Minimap.IsPlayerMoving() then
    Exit(False);

  if (ExpectedUpText <> '') and (Pos(ExpectedUpText, MainScreen.GetUpText()) > 0) then
    Exit(True);

  GameClient.Image.Clear();
  Result := False;

  for attempt := 1 to 2 do
  begin
    if not Self.Find(atpa) then
    begin
      if Bot.GetDebugMode then
        DebugMsg('SmartHover -> Object "' + ExpectedUpText + '" not found (Attempt ' + ToStr(attempt) + ')');
      Continue;
    end;

    tpa := atpa.Merge();

    if Length(tpa) < 1 then
      Continue;

    if (restrictBounds.x1 <> 0) or (restrictBounds.y1 <> 0) or
        (restrictBounds.x2 <> 0) or (restrictBounds.y2 <> 0) then
    begin
      SetLength(filteredTPA, 0);
      for i := 0 to High(tpa) do
      begin
        if restrictBounds.Contains(tpa[i]) then
          filteredTPA += tpa[i];
      end;

      if Length(filteredTPA) < 1 then
        Continue;

      tpa := filteredTPA;
    end;

    objBox := tpa.Bounds();
    p := tpa.RandomMean();

    if Bot.GetDebugMode() then
    begin
      GameClient.Image.DrawTPA(tpa, $FF00FF);
      GameClient.Image.DrawBox(objBox, $00FFFF);
      GameClient.Image.DrawBox(objBox.Expand(-1), $00FF00);
      GameClient.Image.DrawCircle(p, 3, $FFFF00);
    end;

    DebugMsg('SmartHover -> Attempt ' + ToStr(attempt) + ': Moving to [' + ToStr(p.x) + ',' + ToStr(p.y) + ']');

    Mouse.Move(p);
    Wait(50, 150);

    tries := 0;
    repeat
      upText := MainScreen.GetUpText();
      Inc(tries);

      if (ExpectedUpText = '') or (Pos(ExpectedUpText, upText) > 0) then
      begin
        DebugMsg('SmartHover -> Uptext matched "' + ExpectedUpText + '"');
        Exit(True);
      end;

      Wait(50, 100);
    until (tries > 6);

    DebugMsg('SmartHover -> Attempt ' + ToStr(attempt) + ' failed UpText match.');
  end;

  Result := False;
end;

function TScript.PositionalClick(Obj: TGameObjectV2; UpText: String): Boolean;
var
  TargetTile: TPoint;
  Rect: TRectangle;
  ActionText: String;
begin
  DebugMsg('PositionalClick -> Starting positional fallback for: ' + UpText);
  Result := False;

  if Length(Obj.Coordinates) = 0 then
    Exit(False);

  TargetTile := Obj.Coordinates[0];
  Rect := Minimap.GetTileMS(TargetTile);

  if not Mainscreen.Bounds.Contains(Rect) then
  begin
    if not Minimap.MakePointVisible(TargetTile) then
      Exit(False);

    Rect := Minimap.GetTileMS(TargetTile);
    if not Mainscreen.Bounds.Contains(Rect) then
      Exit(False);
  end;

  Mouse.Move(Rect.Mean());
  Wait(100, 200);

  Mouse.Click(MOUSE_RIGHT);
  Wait(50, 100);

  ActionText := UpText;

  if ChooseOption.HasOption('Operate') then
  begin
    Result := ChooseOption.Select('Operate');
  end
  else if ChooseOption.HasOption(ActionText + ' lever') then
  begin
    Result := ChooseOption.Select(ActionText + ' lever');
  end;

  Exit(Result);
end;

function TScript.CheckXP(attempt: Int32 = 0; allowClose: Boolean = True): Int32;
var
  firstRead, retryRead, retries, oldXP, currentRead, i: Int32;
  xpBox, safeBox: TBox;
  target, centerPt: TPoint;
  fontArray: array of TFontSet;
  fontFound: Boolean;
begin
  if Bank.IsOpen() or BankPin.IsOpen() then
    Exit(Self.LastXPAmount);

  Result := 0;
  xpBox := XPBar.Bounds.Expand(0, 10);

  if xpBox.Contains(Mouse.Position()) then
  begin
    centerPt := Point(430, 75);
    safeBox.X1 := centerPt.X - 10;
    safeBox.Y1 := centerPt.Y - 10;
    safeBox.X2 := centerPt.X + 10;
    safeBox.Y2 := centerPt.Y + 10;
    target.X := RandomRange(safeBox.X1, safeBox.X2 + 1);
    target.Y := RandomRange(safeBox.Y1, safeBox.Y2 + 1);
    Mouse.Move(target);
  end;

  oldXP := Self.LastXPAmount;
  fontFound := False;

  if (Self.LastUsedXPFont.Name <> '') then
  begin
    currentRead := OCR.RecognizeNumber(XPBar.Bounds, TOCRColorFilter.Create([$FFFFFF]), Self.LastUsedXPFont);
    if (oldXP = 0) or ((currentRead > 0) and (Abs(currentRead - oldXP) < (oldXP * 0.2))) then
    begin
      Result := currentRead;
      fontFound := True;
    end;
  end;

  if not fontFound then
  begin
    fontArray := [FONT_PLAIN_11, FONT_PLAIN_12, FONT_BOLD_12, FONT_QUILL, FONT_QUILL_8];
    for i := 0 to High(fontArray) do
    begin
      currentRead := OCR.RecognizeNumber(XPBar.Bounds, TOCRColorFilter.Create([$FFFFFF]), fontArray[i]);
      if currentRead > Result then
      begin
        Result := currentRead;
        Self.LastUsedXPFont := fontArray[i];
      end;
    end;
  end;

  firstRead := Result;
  retries := 0;
  while (retries < 10) do
  begin
    if (oldXP > 10000) and (Result > 0) then
    begin
       if (Result < oldXP * 0.8) or (Result > oldXP * 1.2) then
       begin
         Inc(retries);
         Wait(50, 100);
         retryRead := OCR.RecognizeNumber(XPBar.Bounds, TOCRColorFilter.Create([$FFFFFF]), Self.LastUsedXPFont);

         if Abs(retryRead - oldXP) < Abs(Result - oldXP) then
           Result := retryRead;

         if retries >= 3 then
           if Abs(Result - retryRead) < (Result * 0.1) then Break;
         Continue;
       end;
       Break;
    end;
    Break;
  end;

  if (Result = 0) and (oldXP > 0) then
    Exit(oldXP);

  Self.LastXPCheck := GetSystemTime();
  if (Result > oldXP) then
    Self.LastXPTime := GetTickCount();

  Self.LastXPAmount := Result;
end;

function TScript.FormatTimeShort(const TimeStr: String): String;
var
  h, m, s, p1, p2: Int32;
  hStr, mStr, sStr: String;
begin
  Result := '';

  p1 := Pos(':', TimeStr);
  if p1 = 0 then
    Exit(TimeStr);

  p2 := PosEx(':', TimeStr, p1 + 1);
  if p2 = 0 then
    Exit(TimeStr);

  hStr := Copy(TimeStr, 1, p1 - 1);
  mStr := Copy(TimeStr, p1 + 1, p2 - p1 - 1);
  sStr := Copy(TimeStr, p2 + 1, Length(TimeStr) - p2);

  h := StrToIntDef(hStr, 0);
  m := StrToIntDef(mStr, 0);
  s := StrToIntDef(sStr, 0);

  Result := Format('%2.2dh %2.2dm %2.2ds', [h, m, s]);
end;

function TScript.ProgReport(ResultType: Int32; ScriptName, ScriptAuthor, ScriptVersion: String;
              VarNames: TStringArray; VarValues: TVariantArray): Variant;
var
  TSA: TStringArray;
  s, s2, s3, s4: String;
  i, i2, L: Int32;
begin
  s3 := '=';
  s4 := ' ';
  if ResultType = 2 then
    Result := '';
  if Length(VarNames) <> Length(VarValues) then
  begin
    Exit;
  end;
  SetLength(TSA, 3 + Length(VarNames) + 2);
  s2 := 'by ' + ScriptAuthor;
  TSA[0] := s3;
  TSA[1] := ScriptName.Capitalize + ' ' + ScriptVersion;
  TSA[2] := s2;
  TSA[3] := s3;
  i2 := 3 + Length(VarNames);

  for i := 4 to i2 do
    L := Max(L, Length(VarNames[i - 4]));

  for i := 4 to i2 do
  begin
    s := VarValues[i - 4];
    if (Length(s) > 1) and (s[1] = 'v') and (s[2] in ['0'..'9']) then
      TSA[i] := Padr(VarNames[i - 4].Capitalize, L) + ' : ' + s
    else
      TSA[i] := Padr(VarNames[i - 4].Capitalize, L) + ' : ' + s.Capitalize;
  end;

  TSA[i2 + 1] := s3;
  i2 := 0;

  for i := 0 to High(TSA) do
    i2 := Max(i2, Length(TSA[i]));

  TSA[0] := s3.Replicate(i2);
  TSA[3] := s3.Replicate(i2);
  TSA[High(TSA)] := s3.Replicate(i2);
  TSA[1] := s4.Replicate(Round((i2 - Length(TSA[1])) / 2)) + TSA[1];
  TSA[2] := s4.Replicate(Round((i2 - Length(TSA[2])) / 2)) + TSA[2];

  for i := 0 to High(TSA) do
  begin
    if TSA[i][1] = s3 then
      s := '[=' + Padr(TSA[i], i2) + '=]'
    else
      s := '[ ' + Padr(TSA[i], i2 - 1) + ']';
    case ResultType of
      0, 1: Writeln(s);
      2:    Result := Result + s + Chr(13);
    else
      begin
        Writeln('Invalid Result Type');
        Exit;
      end;
    end;
  end;
  if ResultType <> 2 then
    Result := True;
end;

procedure TScript.Report();
var
  SArr: TStringArray;
  VArr: TVariantArray;
begin
  XpGained := Max(0, (Self.LastXPAmount - Self.StartXP));

  FullRunTime := GetTimeRunning;

  LoggedInTime := Self.TrueRunTime.ElapsedTime;

  LoggedInHours := LoggedInTime / 1000 / 60 / 60;

  if LoggedInHours < 0.0001 then
    LoggedInHours := 0.0001;

  SArr := ['Runtime', 'XP gained'];
  VArr := [Self.FormatTimeShort(ToStr(SRL.MsToTime(FullRunTime, Time_Short))),
           ToStr(XpGained) + ' (' + ToStr(Round(XpGained / LoggedInHours)) + '/hr)'];

  if Self.TakeBreaks then
  begin
    SArr += 'Until break';
    VArr += Antiban.TimeUntilBreak(Antiban.Breaks[0]);
  end;

  if Self.TakeSleeps then
  begin
    SArr += 'Until sleep';
    VArr += SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - GetTimeRunning)), TIME_BARE);
  end;

  SArr += ['SRL-T', 'WaspLib'];
  VArr += ['v' + Self.SRLTVersion, 'v' + Self.WaspLibVersion];

  if WaspClient.HasAccess({$MACRO SCRIPT_ID}, {$MACRO SCRIPT_REVISION}) then
    ProgReport(1, 'Mastering Mixology', 'Baconadors', VERSION, SArr, VArr)
  else
    ProgReport(1, 'Mastering Mixology', 'Baconadors.', VERSION, SArr, VArr);
end;

function TScript.UnnoteHerbs(): Int32;
var
  notedHerbMatches: TItemFinderMatchArray;
  selectedNotedHerbMatch: TItemFinderMatch;
  notedHerbSlot, EmptyCount: Int32;
  CombinedNoted: TItemArray;
begin
  Result := -1;
  if not Inventory.IsOpen() then Inventory.Open();

  CombinedNoted := NOTED_HERBS + NOTED_UNF_POTIONS;

  notedHerbMatches := ItemFinder.FindAll(CombinedNoted, Inventory.GetSlotBoxes, Length(CombinedNoted));

  if Length(notedHerbMatches) = 0 then
    Exit;

  selectedNotedHerbMatch := notedHerbMatches[0];
  notedHerbSlot := selectedNotedHerbMatch.Index;

  DebugMsg('UnnoteHerbs -> Selected noted item in slot ' + ToStr(notedHerbSlot));

  if Map.Position().DistanceTo(Self.BankChest.Coordinates[0]) > 10 then
  begin
    Map.Walker.WebWalk(Self.BankChest.Coordinates[0]);
    WaitUntil(not Minimap.IsPlayerMoving(), 50, 3000);
  end;

  if Inventory.SetSelectedSlot(notedHerbSlot) then
  begin
    if Self.BankChest.SmartClick('Use') then
    begin
      if WaitUntil(Chat.GetChatTitle().Contains('banknotes'), 100, 3000) then
      begin
        EmptyCount := Inventory.CountEmptySlots();
        if Chat.ClickOption('Yes') then
        begin
          if WaitUntil(Inventory.CountEmptySlots() < EmptyCount, 100, 3000) then
            Result := notedHerbSlot;
        end;
      end;
    end;
  end;
end;

procedure TScript.GrindHerbs(TargetSlots: Int32);
var
  Timeout, ActivityTimer: TStopwatch;
  CombinedUnnoted: TItemArray;
  CurrentCount, LastCount: Int32;
begin
  CombinedUnnoted := UNNOTED_HERBS + UNNOTED_UNF_POTIONS;

  if not Inventory.ContainsAny(CombinedUnnoted) then
    Exit;

  DebugMsg('GrindHerbs -> Grinding until ' + ToStr(TargetSlots) + ' slots are empty.');

  if Map.Position().DistanceTo(Self.Refiner.Coordinates[0]) > 10 then
  begin
    Map.Walker.WebWalk(Self.Refiner.Coordinates[0]);
    WaitUntil(not Minimap.IsPlayerMoving(), 50, 3000);
  end;

  if Self.Refiner.SmartClick('Refiner') then
  begin
    Timeout.Start();
    ActivityTimer.Start();
    LastCount := Inventory.CountEmptySlots();

    while ((Inventory.CountEmptySlots() < TargetSlots) or Inventory.ContainsAny(CombinedUnnoted))
          and (Timeout.ElapsedTime < 180000) do
    begin
      if Antiban.DoAntiban() then
      begin
        if not GameClient.IsLoggedIn() then
        begin
          DebugMsg('GrindHerbs -> Resuming from break. Logging in...');
          Self.LoginPlayer();
          WaitUntil(GameClient.IsLoggedIn(), 100, 10000);
          Wait(1000);
          Inventory.Open();
        end
        else
          Wait(100);
      end;

      if GameClient.IsLoggedIn() and (not Inventory.ContainsAny(CombinedUnnoted)) then
        Break;

      CurrentCount := Inventory.CountEmptySlots();
      if CurrentCount <> LastCount then
      begin
        LastCount := CurrentCount;
        ActivityTimer.Reset();
        ActivityTimer.Start();
      end;

      if ActivityTimer.ElapsedTime > 6000 then
      begin
        DebugMsg('GrindHerbs -> No progress for 6s (or returned from break). Re-clicking Refiner.');
        if Self.Refiner.SmartClick('Refiner') then
        begin
          ActivityTimer.Reset();
          ActivityTimer.Start();
          Wait(600);
        end;
      end;

      Wait(200, 400);
    end;
  end;

  DebugMsg('GrindHerbs -> Finished.');
end;

procedure TScript.PreparePaste();
var
  TargetSlots, UsedSlot, ItemCount, i: Int32;
begin
  DebugMsg('PreparePaste -> Starting sequence');

  if not Inventory.IsOpen() then Inventory.Open();

  ItemCount := 0;
  for i := 0 to High(UNNOTED_HERBS) do
    ItemCount += Inventory.CountItem(UNNOTED_HERBS[i]);
  for i := 0 to High(UNNOTED_UNF_POTIONS) do
    ItemCount += Inventory.CountItem(UNNOTED_UNF_POTIONS[i]);

  if ItemCount > 0 then
  begin
    DebugMsg('PreparePaste -> Found existing unnoted items (' + ToStr(ItemCount) + '). Grinding them first.');
    TargetSlots := Inventory.CountEmptySlots() + ItemCount;
    Self.GrindHerbs(TargetSlots);
    Exit;
  end;

  TargetSlots := Inventory.CountEmptySlots();
  DebugMsg('PreparePaste -> Snapshot empty slots: ' + ToStr(TargetSlots));

  UsedSlot := Self.UnnoteHerbs();

  Wait(500, 1000);

  if (UsedSlot > -1) and (not Inventory.IsSlotUsed(UsedSlot)) then
  begin
    DebugMsg('PreparePaste -> Noted stack depleted. Adjusting target slots +1.');
    Inc(TargetSlots);
  end;

  Self.GrindHerbs(TargetSlots);
end;

function TScript.HasPaste(): Boolean;
begin
  if not Inventory.IsOpen() then Inventory.Open();
  Result := Inventory.ContainsAll(['Mox paste', 'Aga paste', 'Lye paste']);
end;

function TScript.HasCorrectBase(): Boolean;
begin
  Result := (CurrentOrder.Product.Base > 0) and
            Inventory.ContainsItem(CurrentOrder.Product.Base);
end;

function TScript.HasAny(ItemType: EItemType): Boolean;
var
  i: Int32;
  IDs: array of Variant;
begin
  SetLength(IDs, Length(Products));

  for i := 0 to High(Products) do
  begin
    if ItemType = TYPE_BASE then
      IDs[i] := Products[i].Base
    else
      IDs[i] := Products[i].Processed;
  end;

  Result := Inventory.ContainsAny(IDs);

  if Result and (ItemType = TYPE_BASE) then
    DebugMsg('HasAny -> Found base items in inventory.')
  else if (ItemType = TYPE_BASE) then
    DebugMsg('HasAny -> No base items detected.');
end;

function TScript.CanFulfillOrders(): Boolean;
var
  Demand: array of Int32;
  i, j, InvCount: Int32;
begin
  SetLength(Demand, Length(Products));

  for i := 0 to High(Orders) do
    for j := 0 to High(Products) do
      if Orders[i].Product.Processed = Products[j].Processed then
      begin
        Inc(Demand[j]);
        Break;
      end;

  for i := 0 to High(Demand) do
  begin
    if Demand[i] > 0 then
    begin
      InvCount := Inventory.CountItem(Products[i].Processed);
      if InvCount < Demand[i] then
        Exit(False);
    end;
  end;

  Result := True;
end;

function TScript.LowPaste(): Boolean;
var
  MoxBox: TBox := [18, 133, 85, 153];
  AgaBox: TBox := [86, 133, 149, 153];
  LyeBox: TBox := [150, 133, 213, 153];
  Box: TBox;
  Amount: Int32;
begin
  for Box in [MoxBox, AgaBox, LyeBox] do
  begin
    Amount := OCR.RecognizeNumber(Box, TOCRShadowFilter.Create(5), FONT_QUILL_8);

    if (Amount > -1) and (Amount < 50) then
      Exit(True);
  end;

  Exit(False);
end;

procedure TScript.Process(var Target: TGameObjectV2; ProcessType: EProcess);
var
  StartSlots: Int32;
  UpText: String;
  Timeout: TStopwatch;
  Color1, Color2, AlembicCount: Int32;
  RetortRefound, AlembicClicked, AgitatorClicked, Arrived: Boolean;
begin
  case ProcessType of
    P_AGITATOR: UpText := 'Agitator';
    P_RETORT:   UpText := 'Retort';
    P_ALEMBIC:  UpText := 'Alembic';
  else
    begin
      DebugMsg('Process -> Error: Unknown Process Type!');
      Exit;
    end;
  end;

  DebugMsg('Process -> Starting ' + UpText);
  StartSlots := Inventory.CountEmptySlots();

  RetortRefound := False;
  AlembicClicked := False;
  AgitatorClicked := False;
  Arrived := False;

  if not Target.SmartClick(UpText) then
  begin
    DebugMsg('Process -> Initial SmartClick failed.');
    if SRL.Dice(50) then
      Antiban.RandomRotate()
    else
    begin
      if Length(Target.Coordinates) > 0 then
        Map.Walker.WalkBlind(Target.Coordinates[0])
      else
        DebugMsg('Process -> CRITICAL ERROR: Object ' + UpText + ' has 0 coordinates!');
    end;
    Exit();
  end;

  if not WaitUntil(StartSlots < Inventory.CountEmptySlots(), 50, 9000) then
  begin
    DebugMsg('Process -> Failed to receive first product');
    Exit();
  end;

  Timeout.Start();

  while (Inventory.CountEmptySlots() > StartSlots) and (Timeout.ElapsedTime < 80000) do
  begin
    if not Arrived then
    begin
      if Minimap.IsPlayerMoving() then
      begin
        Wait(50);
        Continue;
      end
      else
      begin
        DebugMsg('Process -> Movement stopped. Waiting 600ms settle time.');
        Wait(600);
        Arrived := True;
      end;
    end;

    if (CurrentOrder.Process = P_AGITATOR) then
    begin
      if not AgitatorClicked then
      begin
        Color1 := CountColorTolerance(9655508, MainScreen.Bounds, 52);
        Color2 := CountColorTolerance(6085984, MainScreen.Bounds, 54);

        if (Color1 > 0) and (Color2 > 0) then
        begin
          DebugMsg('Process -> Agitator Cues Found. Performing SINGLE CLICK.');

          if MainScreen.IsUpText(UpText) then
            Mouse.Click(MOUSE_LEFT)
          else
            Target.SmartClick(UpText);

          AgitatorClicked := True;
          Wait(1000, 1500);
        end
        else
        begin
          Target.SmartHover(UpText);
          Wait(50);
        end;
      end
      else
      begin
        Wait(100);
      end;
    end
    else if (CurrentOrder.Process = P_ALEMBIC) then
    begin
      if not AlembicClicked then
      begin
        DebugMsg('Process -> Alembic: Waiting ~3s...');
        Wait(1100, 1200);

        DebugMsg('Process -> Alembic: Performing single SmartClick.');
        Target.SmartClick(UpText);
        AlembicClicked := True;
      end
      else
      begin
        Wait(100);
      end;
    end
    else if (CurrentOrder.Process = P_RETORT) then
    begin
      if not RetortRefound then
      begin
        DebugMsg('Process -> Retort: Refinding object with SmartClick.');
        Target.SmartClick(UpText);
        RetortRefound := True;
      end
      else
      begin
        Mouse.Click(MOUSE_LEFT);
      end;

      Wait(100, 200);
    end
    else
    begin
      Wait(100);
    end;
  end;

  DebugMsg('Process -> ' + UpText + ' finished');
end;

function TScript.InteractWithFallback(Obj: TGameObjectV2; Action: String; UpTexts: TStringArray): Boolean;
var
  Rect: TRectangle;
  PrimaryText: String;
begin
  if Length(UpTexts) > 0 then
    PrimaryText := UpTexts[0]
  else
    PrimaryText := '';

  if Obj.SmartClick(PrimaryText) then
    Exit(True);

  DebugMsg('InteractWithFallback -> SmartClick failed for ' + Action + '. Rotating camera.');
  Antiban.SmallCameraRotation();
  if Obj.SmartClick(PrimaryText) then
    Exit(True);

  DebugMsg('InteractWithFallback -> SmartClick failed again. Attempting Tile fallback.');

  if Length(Obj.Coordinates) = 0 then
    Exit(False);

  if not MainScreen.IsVisible(Obj.Coordinates[0]) then
    Map.Walker.MakePointVisible(Obj.Coordinates[0]);

  Rect := Minimap.GetTileMS(Obj.Coordinates[0]);

  if not MainScreen.Bounds.Contains(Rect.Mean()) then
  begin
     DebugMsg('InteractWithFallback -> Tile is off-screen.');
     Exit(False);
  end;

  Mouse.Move(Rect.Mean());
  Wait(50, 150);

  if MainScreen.IsUpText(UpTexts) then
  begin
    Mouse.Click(MOUSE_LEFT);
    Exit(True);
  end;

  DebugMsg('InteractWithFallback -> UpText did not match after fallback hover.');
  Result := False;
end;

function TScript.HoverTileFallback(Obj: TGameObjectV2): Boolean;
var
  TargetTile: TPoint;
  ScreenPoint: TPoint;
  TileBounds: TRectangle;
begin
  if Length(Obj.Coordinates) = 0 then
    Exit(False);

  TargetTile := Obj.Coordinates[0];

  if Map.Position().DistanceTo(TargetTile) > 1 then
  begin
    Map.Walker.WalkBlind(TargetTile, 5);
    Wait(500, 1000);
  end;

  if not MainScreen.IsVisible(TargetTile) then
  begin
    if not Map.Walker.MakePointVisible(TargetTile) then
      Exit(False);
  end;

  TileBounds := Minimap.GetTileMS(TargetTile);
  ScreenPoint := TileBounds.Mean();

  if (ScreenPoint = Point(0, 0)) or not MainScreen.Bounds.Contains(ScreenPoint) then
    Exit(False);

  Mouse.Move(ScreenPoint);
  Wait(100, 200);
  Result := MainScreen.GetUpText() <> '';
end;

function TScript.TryClickObject(Obj: TGameObjectV2; ExpectedUpText: String;
  MaxAttempts: Int32 = CLICK_ATTEMPTS): Boolean;
var
  attempts: Int32;
begin
  DebugMsg('TryClickObject -> Attempting to click ' + ExpectedUpText);

  for attempts := 1 to MaxAttempts do
  begin
    if Obj.SmartClick(ExpectedUpText) then
      Exit(True);

    if Length(Obj.Coordinates) > 0 then
    begin
      if HoverTileFallback(Obj) then
      begin
        if MainScreen.IsUpText(ExpectedUpText, 250) then
        begin
          Mouse.Click(MOUSE_LEFT);
          Exit(True);
        end;
      end;
    end;

    if attempts < MaxAttempts then
    begin
      Antiban.SmallCameraRotation();
      Wait(400, 150);
    end;
  end;

  DebugMsg('TryClickObject -> Failed after ' + ToStr(MaxAttempts) + ' attempts');
  Exit(False);
end;

function TScript.GetProcessingType(Area: TBox): EProcess;
var
  Definitions: array of TProcessDef;
  Def: TProcessDef;
  DTM, x, y: Int32;
begin
  SetLength(Definitions, 3);

  Definitions[0].DTMString := 'mKgEAAHic42NgYBAGYgko5gNibijmh8qJQOXEgVgSiKWgOAqIQ4A4CIlOBOIEII6DshOhbBCOBuJIIP737x/D0qVLGc6dOwdmg2gQHx8GqSMXMJKJUQEATTclVg==';
  Definitions[0].ProcessType := EProcess(0);  // P_AGITATOR

  Definitions[1].DTMString := 'mFQEAAHic42VgYBACYkkg5gFiXigNwtxALAjEIkAsBVUDwhJAbA/EFlBsC+U7AbE7GnaCyoHU/Pv3D46XLl0Kx+fOncPKBmFyACMZGAUAACbSIYw=';
  Definitions[1].ProcessType := EProcess(1);  // P_RETORT

  Definitions[2].DTMString := 'mVAEAAHicE2BgYBACYjEg5kfCvEDMhYRBYiJALI2EJYBYFIjLgDgLinOBuACIC4G4BIgrgbgWDVdC5UBq8oH43LlzQJKRAkwZoMRmbLYDAEtSCwE=';
  Definitions[2].ProcessType := EProcess(2);  // P_ALEMBIC

  for Def in Definitions do
  begin
    DTM := DTMFromString(Def.DTMString);
    try
      if FindDTM(DTM, x, y, Area) then
        Exit(Def.ProcessType);
    finally
      FreeDTM(DTM);
    end;
  end;

  Result := EProcess(3);
end;

function TScript.GetOrders(): array of TOrder;
var
  i: Int32;
  Area: TBox;
  OrderBoxes: TBoxArray;
  Txt: String;
  Prod: TProduct;
  ProcType: EProcess;
  Filter: TOCRColorFilter;
begin
  SetLength(Result, 0);

  Filter := TOCRColorFilter.Create([15658734]);

  OrderBoxes := [Box(6, 51, 200, 76), Box(6, 77, 200, 102), Box(6, 103, 200, 128)];

  if Bot.GetDebugMode() then
  begin
    for i := 0 to High(OrderBoxes) do
      GameClient.Image.DrawBox(OrderBoxes[i], $FFFF00);
  end;

  for i := 0 to High(OrderBoxes) do
  begin
    Area := OrderBoxes[i];
    Txt := OCR.Recognize(Area, Filter, FONT_PLAIN_12);

    DebugMsg('Scanning Box ' + ToStr(i) + ' Raw Text: "' + Txt + '"');

    if Txt = '' then
      Continue;

    for Prod in Products do
    begin
      if Txt.Contains(Prod.Name) then
      begin
        ProcType := GetProcessingType(Area);

        if ProcType <> UNKNOWN then
        begin
          SetLength(Result, Length(Result) + 1);
          with Result[High(Result)] do
          begin
            Product := Prod;
            Process := ProcType;
          end;
          DebugMsg('GetOrders -> Detected: ' + Txt + ' using Process: ' + ToStr(ProcType));
        end;
        Break;
      end;
    end;
  end;
end;

function TScript.FetchAndProcessOrders(): array of TOrder;
begin

  Result := Self.GetOrders();

  if Length(Result) > 0 then
    DebugMsg('FetchAndProcessOrders -> Scanned and found ' + ToStr(Length(Result)) + ' active orders.')
  else
    DebugMsg('FetchAndProcessOrders -> No orders detected on screen.');
end;

procedure TScript.UpdateCurrentOrder();
var
  Queue: array of TOrder;
  Stock: array of Int32;
  i, p: Int32;
  IsFulfilled: Boolean;
begin
  Queue := FetchAndProcessOrders();
  Orders := Queue;

  if Length(Queue) = 0 then Exit;

  SetLength(Stock, Length(Products));
  for i := 0 to High(Products) do
    Stock[i] := Inventory.CountItem(Products[i].Processed);

  for i := 0 to High(Queue) do
  begin
    IsFulfilled := False;

    for p := 0 to High(Products) do
    begin
      if Queue[i].Product.Processed = Products[p].Processed then
      begin
        if Stock[p] > 0 then
        begin
          Dec(Stock[p]);
          IsFulfilled := True;
        end;
        Break;
      end;
    end;

    if not IsFulfilled then
    begin
      CurrentOrder := Queue[i];
      Exit;
    end;
  end;

  CurrentOrder := Queue[0];
end;

function TScript.GetDigweedLoc(): TPoint;
var
  Patterns: TStringArray;
  Tiles: TPointArray;
  i: Int32;
begin
  if Chat.FindMessage('has died', [1641184]) then
    Exit(Point(0, 0));

  if Inventory.ContainsItem('Digweed') then
    Exit(Point(0, 0));

  Patterns := ['north west', 'north east', 'south west', 'south east'];
  Tiles    := [[1460, 13106], [1500, 13106], [1460, 13142], [1500, 13142]];

  for i := 0 to High(Patterns) do
  begin
    if Chat.FindMessage(Patterns[i], [811014]) then
    begin
      Exit(Tiles[i]);
    end;
  end;

  Result := Point(0, 0);
end;

procedure TScript.HarvestDigweed();
var Tile: TPoint;
begin
  DebugMsg('HarvestDigweed -> Starting');
  Tile := GetDigweedLoc();
  if Tile = Point(0, 0) then
    Exit();

  if Map.Position().DistanceTo(Tile) > 3 then
  begin
    Map.Walker.WalkBlind(Tile, 5);
    WaitUntil(not Minimap.IsPlayerMoving(), 50, MOVE_TIMEOUT);
  end;

  if Digweed.SmartClick('Collect') then
  begin
    if WaitUntil(Inventory.ContainsItem('Digweed'), 50, 5000) then
      DebugMsg('HarvestDigweed -> Success')
    else
      DebugMsg('HarvestDigweed -> Timeout');
  end;
end;

function TScript.SetLevers(Combination: String): Boolean;
var
  Character: Char;
  Success: Boolean;
  CurrentLever: TGameObjectV2;
  LeverName: String;
  Attempts: Int32;
begin
  DebugMsg('SetLevers -> Setting ' + Combination);

  if Map.Position().DistanceTo([1480, 13134]) > 4 then
  begin
    Map.Walker.WalkBlind([1480, 13134], 5);
    WaitUntil((Map.Position.DistanceTo([1480, 13134]) <= 4), 25, 5000);
  end;

  for Character in Combination do
  begin
    case Character of
      'M': begin CurrentLever := Self.MoxLever; LeverName := 'Mox'; end;
      'L': begin CurrentLever := Self.LyeLever; LeverName := 'Lye'; end;
      'A': begin CurrentLever := Self.AgaLever; LeverName := 'Aga'; end;
    else
      Exit(False);
    end;

    Success := False;
    Attempts := 0;

    while (Attempts < CLICK_ATTEMPTS) and not Success do
    begin
      Inc(Attempts);
      Success := TryClickObject(CurrentLever, LeverName, 1);
      if not Success and (Attempts < CLICK_ATTEMPTS) then
      begin
        Antiban.SmallCameraRotation();
        WaitEx(400, 150);
      end;
    end;

    if not Success then
      Exit(False);

    WaitEx(1075, 250);
  end;

  Exit(True);
end;

procedure TScript.DepositPaste();
begin
  DebugMsg('DepositPaste -> Starting');
  if Hopper.Click() then
    WaitUntil(not LowPaste(), 750, 5000)
  else
    Map.Walker.WalkBlind(Hopper.Coordinates[0], 5);
end;

procedure TScript.GetBase();
var
  TargetCombo: String;
  StartCount, i: Int32;
  Timeout: TStopwatch;
begin
  TargetCombo := CurrentOrder.Product.Combination;

  if Self.CurrentLeverCombo <> TargetCombo then
  begin
    if not SetLevers(TargetCombo) then Exit;
    Self.CurrentLeverCombo := TargetCombo;
    Self.LeversSet := True;
    Wait(300, 500);
  end;

  if not Inventory.Open() then Inventory.Open();
  StartCount := Inventory.CountEmptySlots();

  for i := 1 to 5 do
  begin
    if not Self.Vessel.IsVisible() then
    begin
      Map.Walker.WalkBlind(Self.Vessel.Coordinates[0]);
      Continue;
    end;

    if Self.Vessel.SmartClick('Take-from') then
    begin
      Timeout.Start();
      while Timeout.ElapsedTime < 5000 do
      begin
        if Inventory.ContainsItem(CurrentOrder.Product.Base) then
        begin
          DebugMsg('GetBase -> Correct base detected in inventory. Moving to Process.');
          Exit;
        end;

        if Inventory.CountEmptySlots() < StartCount then
          Exit;

        if Chat.HasContinue() then
        begin
          DebugMsg('GetBase -> Dialog detected. Resetting lever sequence.');
          Chat.ClickContinue(True);

          Self.CurrentLeverCombo := '';
          Self.LeversSet := False;
          Exit;
        end;

        Wait(100);
      end;
    end;

    Wait(250, 450);
  end;

  DebugMsg('GetBase -> Failed to retrieve item. Force resetting lever state.');
  Self.LeversSet := False;
  Self.CurrentLeverCombo := '';
end;

procedure TScript.ProcessOrder();
begin
  DebugMsg('ProcessOrder -> Processing ' + CurrentOrder.Product.Name + ' via ' + ToStr(CurrentOrder.Process));
  case CurrentOrder.Process of
    P_AGITATOR: Process(Self.Agitator, P_AGITATOR);
    P_RETORT: Process(Self.Retort, P_RETORT);
    P_ALEMBIC: Process(Self.Alembic, P_ALEMBIC);
  end;

  Self.CurrentLeverCombo := '';
  Self.LeversSet := False;
end;

procedure TScript.DestroyLeftoverBases();
var
  i, j, Slot, ProdIdx: Int32;
  AllIDs: TIntegerArray;
  FoundItem: Boolean;
  ItemName: String;
begin
  DebugMsg('DestroyLeftoverBases -> Checking for items to destroy (Base + Processed)...');

  SetLength(AllIDs, 0);
  for i := 0 to High(Products) do
  begin
    AllIDs += Products[i].Base;
    AllIDs += Products[i].Processed;
  end;

  repeat
    FoundItem := False;

    for j := 0 to High(AllIDs) do
    begin
      if Inventory.FindItem(AllIDs[j], Slot) then
      begin
        ProdIdx := j div 2;
        ItemName := Products[ProdIdx].Name;

        if (j mod 2 = 0) then
          ItemName := ItemName + ' (Base)'
        else
          ItemName := ItemName + ' (Processed)';

        DebugMsg('DestroyLeftoverBases -> Destroying ' + ItemName + ' in slot ' + ToStr(Slot));

        if Inventory.ClickSlot(Slot, 'Destroy') then
        begin
          Wait(SRL.TruncatedGauss(1200, 200));
          Keyboard.PressKey(VK_1);
          Wait(SRL.TruncatedGauss(300, 600));
          FoundItem := True;
        end;

        if FoundItem then Break;
      end;
    end;

    if FoundItem then
      Wait(200);

  until not FoundItem;
end;

procedure TScript.DepositOrder();
var
  CurrentXP, DigweedSlot, ProductSlot, i, StartSlots: Int32;
begin
  DebugMsg('DepositOrder -> Starting');

  WaitUntil(not Minimap.IsPlayerMoving(), 100, 3000);

  if Inventory.FindItem('Digweed', DigweedSlot) then
  begin
    for i := 0 to High(Products) do
    begin
      if Inventory.FindItem(Products[i].Processed, ProductSlot) then
      begin
        DebugMsg('DepositOrder -> Found combo: Digweed + ' + Products[i].Name);

        StartSlots := Inventory.CountEmptySlots();

        if Inventory.Use(ProductSlot, DigweedSlot) then
        begin
          if WaitUntil(Inventory.CountEmptySlots() > StartSlots, 100, 2000) then
            DebugMsg('DepositOrder -> Digweed successfully applied.')
          else
            DebugMsg('DepositOrder -> Warning: Digweed usage timed out.');
        end;
        Exit;
      end;
    end;
  end;

  CurrentXP := Self.CheckXP();
  StartSlots := Inventory.CountEmptySlots();

  if Self.Conveyor.SmartClick('Fulfil') then
  begin
    WaitUntil(not Minimap.IsPlayerMoving(), 600, 5000);

    if WaitUntil((Inventory.CountEmptySlots() > StartSlots) or (Self.CheckXP() > CurrentXP), 600, 7500) then
    begin
      if HasAny(TYPE_BASE) or HasAny(TYPE_PROCESSED) then
      begin
        DebugMsg('DepositOrder -> Order fulfilled. Cleaning up leftovers...');
        DestroyLeftoverBases();
      end;
    end
    else
    begin
      DebugMsg('DepositOrder -> Warning: Items did not leave inventory. Skipping destroy to protect potions.');
    end;
  end
  else
  begin
    DebugMsg('DepositOrder -> Failed to click Fulfil. Moving closer.');
    Map.Walker.WalkBlind(Self.Conveyor.Coordinates[0]);
  end;
end;

procedure TScript.WalkToLevers();
begin
  DebugMsg('WalkToLevers -> Walking to lever area');
  if Map.Position().DistanceTo([1480, 13134]) > 3 then
  begin
    Map.Walker.WalkBlind([1480, 13134], 3);
    WaitUntil(Minimap.IsPlayerMoving, 50, 1000);
  end;
end;

procedure TScript.BreakPause(Task: PBreakTask);
begin
  Self.TrueRunTime.Pause();
end;

procedure TScript.BreakResume(Task: PBreakTask);
begin
  Self.TrueRunTime.Resume();
end;

procedure TScript.SleepPause(Task: PSleepTask);
begin
  Self.TrueRunTime.Pause();
end;

procedure TScript.SleepResume(Task: PSleepTask);
begin
  if GetTimeRunning() > Self.ShutdownTime then
    TerminateScript('Time to shutdown');
  Self.TrueRunTime.Resume();
end;

procedure TScript.SetupProducts();
begin
  Products := [
    ['Mixalot',             'MAL', 30020, 30030],
    ['Anti-leech lotion',   'ALL', 30018, 30028],
    ['Megalite liquid',     'MLL', 30019, 30029],
    ['Aqualux amalgam',     'ALA', 30015, 30025],
    ['Azure aura mix',      'AAM', 30016, 30026],
    ['Marley''s moonlight', 'MML', 30013, 30023],
    ['Mystic mana amalgam', 'MMA', 30012, 30022],
    ['Alco-augmentator',    'AAA', 30014, 30024],
    ['Mammoth-might mix',   'MMM', 30011, 30021],
    ['Liplack liquor',      'LLL', 30017, 30027]
  ];
end;

