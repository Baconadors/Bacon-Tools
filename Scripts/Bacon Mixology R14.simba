procedure DebugMsg(Msg: String);
var
  logFile: Integer;
  folderPath, fullMsg, header: string;
  isNew: Boolean;
begin
  fullMsg := SRL.TimeStamp() + ':[DEBUG]: ' + Msg;

  if (not GUI.IsInitialized) or Bot.GetDebugMode() then
    Writeln(fullMsg);

  folderPath := AppPath + 'Configs' + DirectorySeparator + 'MasteringMixology' + DirectorySeparator + 'Logs' + DirectorySeparator;

  if (CurrentLogFileName = '') then
    CurrentLogFileName := 'MM_Log_' + FormatDateTime('yyyy-mm-dd_hh-nn-ss', Now()) + '.txt';

  if not DirectoryExists(folderPath) then
    ForceDirectories(folderPath);

  isNew := not FileExists(folderPath + CurrentLogFileName);

  try
    if isNew then
    begin
      logFile := RewriteFile(folderPath + CurrentLogFileName, False);
      if logFile <> -1 then
      begin
        header := '=== Mastering Mixology Debug Log ===' + LineEnding +
                  'Started: ' + FormatDateTime('yyyy-mm-dd hh:nn:ss', Now()) + LineEnding +
                  '==============================' + LineEnding;
        WriteFileString(logFile, header);
      end;
    end else
      logFile := AppendFile(folderPath + CurrentLogFileName);

    if logFile <> -1 then
    begin
      WriteFileString(logFile, fullMsg + LineEnding);
      CloseFile(logFile);
    end;
  except
  end;
end;

